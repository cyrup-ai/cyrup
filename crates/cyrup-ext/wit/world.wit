// cyrup:ext@0.7.0 — the versioned WIT world (arch-08 §4.1).
//
// Single source of truth, shared verbatim by the host (`wasmtime::component::bindgen!`)
// and the guest (`wit-bindgen` in cyrup-ext-sdk). Open-shaped values (tool params, message
// lists, patches, custom payloads) cross as `string` carrying serde_json; fixed-shape control
// values (ids, enums, exec results) are real WIT records for type safety (arch-08 §4.1).
//
// The `events` interface exports 34 `on-*` hooks. THIRTY-THREE of them mirror pi's `pi.on(...)`
// catalog one-for-one (`extensions/types.ts:1190-1231` @v0.83.0 — 33 `on(event: "…")` overloads,
// hand re-derived; the range `:1198-1239` this header used to cite corresponds to NO upstream
// version and was fabricated, EXT-036). `before_provider_headers` (EXT-009, upstream `:1212`) and
// `session_info_changed` (EXT-011, upstream `:1203`) closed the last two gaps. The 34th,
// `on-terminal-input`, is NOT an `on(event: …)` overload: it is the guest-side half of
// `ExtensionUIContext.onTerminalInput(handler)` (`extensions/types.ts:145` @v0.83.0), which
// upstream registers as a closure rather than a named event — a closure cannot cross a component
// boundary, so it lands here as an export paired with the `ui.subscribe-terminal-input` import
// (EXT-021). Count the `on-*` lines, not the pi events: the two numbers are 34 and 33.
// The host calls only the exports a guest subscribed to (the subscription gate, R-08-034).
//
// VERSIONING (EXT-028): this package version and `cyrup_ext::HOST_WORLD` move TOGETHER, and ANY
// change to an EXPORT — added, removed, or RE-SIGNED — bumps the MINOR. A guest built against an
// older MINOR either lacks the export or has it at the old signature, so it must be refused by
// `ExtensionManifest::check_world` before instantiation rather than trapping inside wasmtime.
// `crates/cyrup-ext/tests/wit_world_sync.rs` enforces that tie, in BOTH copies.
//
// A RE-SIGNED IMPORT bumps the MINOR for the same reason in the opposite direction: an old guest
// calls the import at the old signature and fails to LINK against the new host. 0.5 -> 0.6 is one
// such batch (ADR-0002's one-bump-per-pass rule): `ui.set-widget` gained pi's key/placement
// (EXT-047) and `ui.theme-list` widened to `{name, path}` rows (EXT-021). Purely ADDITIVE imports
// in the same batch (`ui.set-working-*`, `ui.set-hidden-thinking-label`, `ui.theme-get-by-name`)
// would not have needed a bump on their own. 0.6 -> 0.7 is another such batch, and this one hits
// BOTH directions: `types.tool-descriptor` gained `constrained-sampling`, which RE-SIGNS the
// `registration.register-tool` import (PROV-011 / EXT-024), and the `events.on-terminal-input`
// EXPORT was ADDED alongside the `ui.subscribe-terminal-input`/`ui.unsubscribe-terminal-input`
// imports (EXT-021). Either one alone forces the bump.
package cyrup:ext@0.7.0;

// ---------------------------------------------------------------------------
// Serializable mirrors of cyrup-core. JSON-as-string at the seam (arch-08 §4.1).
// ---------------------------------------------------------------------------
interface types {
  enum exec-mode { parallel, sequential }
  enum ext-mode  { tui, rpc, json, print }

  // A `[block]` outcome (EXT-049). `reason` is pi's `ToolCallEventResult.reason`; `terminate` is
  // pi's `ToolCallEventResult.terminate` (`extensions/types.ts:1072-1079` @v0.84.1 — ABSENT at the
  // ported v0.83.0 baseline): "Hint that the agent should stop after the current tool batch when
  // this call is blocked. Early termination only happens when every finalized tool result in the
  // batch sets this to true." Only `on-tool-call` reads it; every other seam ignores it, exactly as
  // upstream does (no other `*EventResult` declares the field).
  record block-result {
    reason: option<string>,
    terminate: bool,
  }

  // What a single event handler contributes to the block/mutate/notify reduction
  // (arch-08 §3.3). `mutate`/`handled` carry serde_json patch payloads as strings; the host
  // interprets the patch shape per the event kind (Pi extensions/runner.ts emit* reducers).
  variant hook-outcome {
    noop,
    block(block-result),
    mutate(string),
    handled(string),
  }

  // Guest -> host tool registration descriptor (arch-08 §3.5). `parameters-json` stays
  // JSON-Schema (Pi-interop, R-ARCH-EXT-008).
  record tool-descriptor {
    name: string,
    label: string,
    description: string,
    parameters-json: string,
    exec-mode: option<exec-mode>,
    prompt-snippet: option<string>,
    prompt-guidelines: list<string>,
    has-renderer: bool,
    // pi `ToolDefinition.prepareArguments?: (args: unknown) => Static<TParams>`
    // (extensions/types.ts:468 @v0.83.0), run before `validateToolArguments` in
    // `packages/agent/src/agent-loop.ts`. A function value cannot cross a component boundary, so
    // the descriptor carries a FLAG and the host calls the `prepare-arguments` export when it is
    // set (EXT-023). `false` = the identity default.
    prepare-arguments: bool,
    // pi `ToolDefinition.renderShell?: "default" | "self"` (extensions/types.ts:465 @v0.83.0):
    // "Controls whether ToolExecutionComponent renders the standard colored shell or the tool
    // renders its own framing." `none` = upstream's omitted field = "default" (EXT-024).
    render-shell: option<string>,
    // pi `ToolDefinition.constrainedSampling?: false | ConstrainedSamplingConfig`
    // (extensions/types.ts:463 @v0.83.0), copied verbatim onto the runtime tool by
    // `wrapToolDefinition` (core/tools/tool-definition-wrapper.ts:14) and resolved provider-side
    // by `packages/ai/src/api/constrained-sampling.ts`. Carried as the JSON of that union —
    // `false`, `{"type":"json_schema","strict":"prefer"|"require"}` or
    // `{"type":"grammar","variants":{"openai_lark"?,"openai_regex"?}}` — because it is an
    // open-shaped value per the header's rule. `none` = the omitted field, which upstream is
    // indistinguishable from `false` (PROV-011 / EXT-024).
    constrained-sampling: option<string>,
  }

  // Pi `TerminalInputHandler`'s return, `extensions/types.ts:113` @v0.83.0:
  // `{ consume?: boolean; data?: string } | undefined`. Both members stay OPTIONAL because
  // upstream distinguishes "absent" from "false"/"empty" in neither direction by accident: the
  // fold tests `result?.consume` (truthy) and `result?.data !== undefined`, so a handler returning
  // `{data: ""}` REWRITES the buffer to empty (and the keystroke is then dropped by the
  // end-of-fold length check), while one returning `{}` leaves it alone.
  record terminal-input-result {
    consume: option<bool>,
    data: option<string>,
  }

  // Result of a capability-scoped exec (arch-08 caps/exec.rs). 1:1 with Pi's `ExecResult`
  // (exec.ts:23-28): `killed` is true when the host SIGTERMed, then (after a 5s grace period if
  // still alive) SIGKILLed, the process on a timeout/abort — Pi's exact `killProcess` escalation
  // (exec.ts:52-63) — false for a natural exit or an external signal.
  record exec-result {
    code: s32,
    stdout: string,
    stderr: string,
    killed: bool,
  }

  // Result of executing a guest-registered tool (R-08-015, Pi `AgentToolResult`,
  // `packages/agent/src/types.ts:355-369` @v0.83.0 — a DIFFERENT package from
  // `coding-agent/.../extensions/types.ts`, which only RE-EXPORTS the type at `:87`).
  //
  // EXT-036: this cited `extensions/types.ts:1043`, which is `| AgentStartEvent`, a member of the
  // `ExtensionEvent` union. Three unrelated types in this tree were all cited to that one line
  // (`AgentToolResult`, `UserBashEventResult`, `ToolResultEventResult`) — a catch-all, which is a
  // fabrication tell distinct from the uniform-offset one: staleness moves every citation by the
  // same delta, invention converges them on one plausible-looking number.
  // `content-json` is a serde_json array of (text|image) content blocks; `terminate` ends the
  // agent loop after this result.
  record tool-output {
    content-json: string,
    details-json: option<string>,
    is-error: bool,
    terminate: bool,
  }

  // A single autocomplete suggestion (Pi `AutocompleteItem`, tui/autocomplete.ts:219).
  record autocomplete-item {
    value: string,
    label: string,
    description: option<string>,
  }

  // The suggestions a provider returns (Pi `AutocompleteSuggestions`, tui/autocomplete.ts:236):
  // the matched items + the prefix they match against.
  record autocomplete-suggestions {
    items: list<autocomplete-item>,
    prefix: string,
  }
}

// ---------------------------------------------------------------------------
// host -> guest: the §5 event catalog (exports the guest may implement).
// The host only calls events the guest subscribed to (subscription gate, R-08-034).
// All 33 pi events (the `on(event: "…")` overload block, extensions/types.ts:1190-1231 @v0.83.0)
// are represented here, plus `on-terminal-input` — the `ExtensionUIContext.onTerminalInput`
// closure (`extensions/types.ts:145`), which has no `on(event: …)` name upstream — for 34 `on-*`
// exports against 33 pi events. EXT-036: this line used to claim "All 30" against a range that
// matches no upstream version, contradicting the file's own header 81 lines above — and the count
// test only ties the header's number, so the disagreement passed straight through an audit that
// quoted it.
// ---------------------------------------------------------------------------
interface events {
  use types.{hook-outcome, tool-output, terminal-input-result};

  // --- provider OAuth + custom streaming (Pi ProviderConfig.oauth/streamSimple, types.ts:1373-1392) ---
  // The host invokes these on a guest that registered a provider carrying OAuth/`streamSimple`
  // callbacks. Credentials/models/model/context/options cross as serde_json strings (open-shaped,
  // arch-08 §4.1). `provider-login` runs the guest's `login(callbacks)` flow — during it the guest
  // calls the `oauth` host imports (onAuth/onPrompt/onSelect/…) — and returns the credentials to
  // persist. `provider-stream-simple` runs the guest's custom stream: it pushes assistant-message
  // stream events back via the `provider-stream` host import, then returns when the stream ends.
  provider-login:         func(id: string) -> result<string, string>;
  provider-refresh-token: func(id: string, credentials-json: string) -> result<string, string>;
  provider-get-api-key:   func(id: string, credentials-json: string) -> result<string, string>;
  provider-modify-models: func(id: string, models-json: string, credentials-json: string) -> result<string, string>;
  provider-stream-simple: func(id: string, stream-id: string, model-json: string, context-json: string, options-json: string) -> result<_, string>;

  // --- global autocomplete provider stacking (Pi addAutocompleteProvider, types.ts:218) ---
  // The host folds the guest's stacked `AutocompleteProviderFactory` chain over its own built-in
  // suggestions: `base-json` is the built-in `autocomplete-suggestions` (the wrapped "current"),
  // `query-json` carries `{lines, cursorLine, cursorCol, force}`. The guest returns the final
  // suggestions after applying every stacked provider in registration order.
  autocomplete-suggest:   func(base-json: string, query-json: string) -> string;

  // --- withSession re-binding callback (Pi ReplacedSessionContext, types.ts:346-390) ---
  // After a command-tier `control.new-session`/`switch`/`fork` carrying a `withSessionCallbackId`,
  // the host re-binds the replacement session then invokes THIS export with that id — a fresh
  // top-level call, because wasm single-instance reentrancy forbids calling it synchronously inside
  // the `control.*` import (Pi `finishSessionReplacement`, agent-session-runtime.ts:184-189). The
  // guest looks up the stored `withSession(ctx)` closure and runs it against a freshly-bound
  // command-tier `ReplacedSessionContext`.
  with-session: func(callback-id: string) -> result<_, string>;

  // --- guest tool execution (R-08-015) ---
  // The host invokes a guest-registered tool. Mirrors Pi's ToolDefinition.execute
  // (types.ts:480): `call-id` = toolCallId, `params-json` = arguments; cancellation (signal)
  // is delivered by the host epoch/cancel; streaming updates go back via host-tool.emit-update;
  // `ctx` is reconstructed guest-side from the capability imports.
  execute-tool: func(name: string, call-id: string, params-json: string) -> result<tool-output, string>;

  // --- guest tool argument preparation (EXT-023; pi `ToolDefinition.prepareArguments`,
  // extensions/types.ts:468 @v0.83.0) ---
  // Called ONLY for a tool whose descriptor sets `prepare-arguments`, and only BEFORE schema
  // validation — pi runs `prepareArguments` ahead of `validateToolArguments` in
  // `packages/agent/src/agent-loop.ts`, so the coerced value is what gets validated. `none` (or a
  // guest fault) leaves the arguments untouched, which is upstream's identity default.
  prepare-arguments: func(name: string, args-json: string) -> option<string>;

  // --- guest slash-command execution (R-08-016) ---
  // The host invokes a guest-registered command at COMMAND tier (session ops legal). `args` is the
  // raw argument string (Pi RegisteredCommand.handler(args, ctx), types.ts:1109); the optional text
  // result is surfaced to the user. `get-argument-completions` is Pi's dynamic getArgumentCompletions
  // (types.ts:1108): given a prefix, the guest returns the completion items (replacing static lists).
  execute-command:          func(name: string, args: string) -> result<option<string>, string>;
  get-argument-completions: func(name: string, prefix: string) -> list<string>;

  // --- guest keyboard-shortcut execution (R-08-017; Pi registerShortcut handler, types.ts:1199-1205) ---
  // The host invokes the guest's stored shortcut handler (`options.handler(ctx)`) when the registered
  // `KeyId` fires. Runs at COMMAND tier (Pi hands the shortcut handler the full `ExtensionContext`).
  execute-shortcut:         func(key: string) -> result<_, string>;

  // --- message renderer dispatch (R-08-020; Pi renderCall/renderResult, types.ts:489-497) ---
  // A guest that registered a renderer for `custom-type` renders a tool call / result into a
  // serialized widget tree (none = fall back to the runtime's default renderer).
  //
  // `custom-type` is the CUSTOM MESSAGE TYPE for a renderer registered via
  // `registration.register-message-renderer`, or the TOOL NAME for a tool whose descriptor declares
  // `has-renderer` — the host routes by that key alone (EXT-006).
  //
  // THE WIDGET VOCABULARY. Pi returns a live `pi-tui` `Component` the interactive mode adds as a
  // child (`components/custom-message.ts:66-81`, `components/tool-execution.ts:81-112`); a WASM
  // guest cannot hand back an object, so cyrup's wire analog is that component tree SERIALIZED, and
  // the host flattens it to display rows (`cyrup-tui` `rendered_text`). The tags mirror the
  // `pi-tui` components a renderer actually returns (`packages/tui/src/index.ts:13-32`):
  //
  //   "…"                                        a bare string — the degenerate `Text`
  //   {"widget":"text","text":"…"}               `Text`   — the dominant shape
  //   {"widget":"markdown","text":"…"}           `Markdown`
  //   {"widget":"truncated-text","text":"…"}     `TruncatedText`
  //   {"widget":"spacer","lines":n}              `Spacer` (n defaults to 1, clamped to 64)
  //   {"widget":"box"|"container","children":[]} `Box` / `Container` — children stacked
  //   {"widget":"hstack","children":[…]}         `HStack`  — children joined on one row
  //   […]                                        shorthand for a stack
  //
  // `cyrup_ext_sdk::widget` constructs exactly these. Anything else — an unknown tag, a missing
  // tag, a tree nested deeper than 16 — is drawn as pretty-printed JSON rather than dropped, so a
  // mistyped node is visible instead of blank.
  render-call:   func(custom-type: string, call-json: string) -> option<string>;
  render-result: func(custom-type: string, result-json: string) -> option<string>;

  // --- markdown transformation (EXT-019; pi `MarkdownTransformer`,
  // `extensions/types.ts:1147-1153` @v0.84.1 — a POST-BASELINE addition, absent at v0.83.0) ---
  // Upstream: `type MarkdownTransformer = (markdown: string, context: MarkdownTransformContext) =>
  // string` (`:1153`), registered by `registerMarkdownTransformer` (`:1292`, impl
  // `loader.ts:309-312`), stored as the AT-MOST-ONE `markdownTransformer?` per extension
  // (`:1703`), and collected in extension LOAD ORDER by
  // `ExtensionRunner.getMarkdownTransformers()` (`runner.ts:589-591`). The host folds them: each
  // transformer's output is the next one's input.
  //
  // `ctx-json` is `MarkdownTransformContext` (`:1147-1151`):
  //   {"messageType": "user"|"assistant"|"assistant-thinking", "isStreaming": bool,
  //    "availableWidth": number}
  //
  // Called only on a guest that declared `registration.register-markdown-transformer`. A guest
  // fault leaves the markdown untouched (the identity default), never dropping the transcript text.
  transform-markdown: func(markdown: string, ctx-json: string) -> string;

  // --- raw terminal input (EXT-021's residual; pi `ExtensionUIContext.onTerminalInput(handler)`,
  // `extensions/types.ts:145` @v0.83.0, handler type `TerminalInputHandler` at `:113`:
  // `(data: string) => { consume?: boolean; data?: string } | undefined`) ---
  //
  // Called only on a guest that declared `ui.subscribe-terminal-input`, in LOAD order — pi keeps
  // its listeners in an insertion-ordered `Set` and folds them in `TUI.handleInput`
  // (`packages/tui/src/tui.ts:773-788`): each listener sees the CURRENT (possibly already
  // rewritten) data, a `consume: true` stops the fold and drops the keystroke, and a returned
  // `data` replaces the buffer for the listeners after it. A fold that ends with an EMPTY string
  // also drops the keystroke (`:784-786`).
  //
  // `none` is upstream's `undefined` return — "I looked at it and did nothing" — and is what a
  // faulting or panicking guest is treated as, so a broken extension can never swallow the user's
  // keyboard.
  on-terminal-input: func(data: string) -> option<terminal-input-result>;

  // --- 5.4 tools — the mutating seams ---
  // tool_call [block/mutate] (types.ts:1145), tool_result [mutate] (types.ts:1146).
  // tool_result carries the FULL Pi `ToolResultEventBase` shape (types.ts:883-929): the executed
  // tool `input` (the arguments), the per-tool `details` blob (`BashToolDetails | …`) AND the
  // optional `usage` the tool execution itself reported (types.ts:919-921, upstream `2fd38684`) —
  // not just content+isError. A `tool_result` handler inspects and patches all of them; the patch
  // direction rides the `hook-outcome` mutate JSON, whose `usage` key is read back host-side.
  on-tool-call:    func(call-id: string, name: string, input-json: string) -> hook-outcome;
  on-tool-result:  func(call-id: string, name: string, input-json: string, content-json: string, is-error: bool, details-json: option<string>, usage-json: option<string>) -> hook-outcome;

  // --- 5.3 agent & turn ---
  // context [mutate] (types.ts:1144), message_end [mutate] (types.ts:1143),
  // before_agent_start [mutate] (types.ts:1135).
  on-context:            func(messages-json: string) -> hook-outcome;
  on-message-end:        func(message-json: string) -> hook-outcome;
  on-before-agent-start: func(prompt: string, images-json: string, system-prompt: string, options-json: string) -> hook-outcome;

  // input [block/mutate/handled] (types.ts:1158), user_bash [block/mutate/handled] (types.ts:1159).
  // `input` carries the full Pi `InputEvent` (types.ts:800-810): the submission `text`, the attached
  // `images`, the `source` ("interactive"|"rpc"|"extension"), and the in-flight `streaming-behavior`
  // ("steer"|"followUp"; none when the agent is idle).
  // `user_bash` carries the Pi `UserBashEvent` (types.ts:782-790): the `command`, the
  // `exclude-from-context` flag (true for the `!!` prefix), and the `cwd`. The `operations`/`result`
  // override is returned via the `handled` outcome (Pi `UserBashEventResult`, `extensions/types.ts:1078-1083` @v0.83.0; EXT-036 corrected `:1043-1048`),
  // NOT passed in.
  on-input:        func(text: string, images-json: string, source: string, streaming-behavior: option<string>) -> hook-outcome;
  on-user-bash:    func(command: string, exclude-from-context: bool, cwd: string) -> hook-outcome;

  // --- 5.6 provider ---
  // before_provider_request [mutate] (types.ts:1160), after_provider_response [notify] (types.ts:1161).
  on-before-provider-request: func(payload-json: string) -> hook-outcome;
  // before_provider_headers [mutate] (pi `BeforeProviderHeadersEvent`, extensions/types.ts:686-689
  // @v0.83.0, subscribed at :1212, reduced by `emitBeforeProviderHeaders` at runner.ts:1045).
  // `headers-json` is the assembled `ProviderHeaders` bag. The doc at types.ts:681-685 is exact:
  // "Handlers mutate `headers` in place (e.g. to inject tracing/session headers); the return value
  // is ignored. A `null` value deletes that header." So the mutate payload is an OBJECT whose
  // values are `string | null`, and a `null` DELETES that header rather than setting it empty
  // (EXT-009).
  on-before-provider-headers: func(headers-json: string) -> hook-outcome;
  on-after-provider-response: func(status: u32, headers-json: string);

  // model_select [notify] (types.ts:1226), thinking_level_select [notify] (types.ts:1227).
  // pi `ModelSelectEvent {type, model, previousModel, source}` (extensions/types.ts:794-799
  // @v0.83.0) and `ThinkingLevelSelectEvent {type, level, previousLevel}` (:802-806) — three and
  // three SIBLING fields. cyrup used to nest `previousModel`/`source` INSIDE `model` (so `model`
  // was not a `Model` shape either) and drop `previousLevel` outright (EXT-042).
  on-model-select:          func(model-json: string, previous-model-json: option<string>, source: string);
  on-thinking-level-select: func(level: string, previous-level: option<string>);

  // --- notify-only (return ignored); high-frequency ones are subscription-gated ---
  on-agent-start:           func();
  on-agent-end:             func(messages-json: string);
  // agent_settled (Pi AgentSettledEvent, extensions/types.ts:721-725, subscribed at types.ts:1225):
  // the run has FULLY settled — no automatic retry, post-run compaction or queued continuation will
  // follow. Distinct from on-agent-end, which fires once per agent.prompt/agent.continue: a run that
  // auto-retries delivers TWO on-agent-end calls and exactly ONE on-agent-settled. Pi emits it from
  // the `finally` of _runAgentPrompt (agent-session.ts:1063-1072), to the extension runner FIRST and
  // the session subscribers second.
  on-agent-settled:         func();
  on-turn-start:            func(turn-index: u32, timestamp: u64);
  // turn_end (Pi TurnEndEvent, types.ts:703-709): the turn index, the finalized assistant `message`,
  // AND the `tool-results` produced this turn (`ToolResultMessage[]`).
  on-turn-end:              func(turn-index: u32, message-json: string, tool-results-json: string);
  // message_start (Pi MessageStartEvent, types.ts:711-715): the full `message` (user|assistant|
  // toolResult), not just its role.
  on-message-start:         func(message-json: string);
  // message_update (Pi MessageUpdateEvent, types.ts:717-722): the full in-flight `message` AND the
  // `assistant-message-event` delta (carried here as `delta-json`). HIGH-FREQ, gated.
  on-message-update:        func(message-json: string, delta-json: string);   // HIGH-FREQ, gated
  on-tool-exec-start:       func(call-id: string, name: string, args-json: string);
  // tool_execution_update (pi `ToolExecutionUpdateEvent`, extensions/types.ts:770-776 @v0.83.0):
  // `{type, toolCallId, toolName, args, partialResult}` — FIVE fields; cyrup used to drop `toolName`
  // AND `args`, forcing every observer to keep its own callId->name map (EXT-014).
  on-tool-exec-update:      func(call-id: string, name: string, args-json: string, chunk-json: string); // HIGH-FREQ, gated
  // tool_execution_end (pi `ToolExecutionEndEvent`, extensions/types.ts:779-785 @v0.83.0):
  // `{type, toolCallId, toolName, result, isError}`.
  on-tool-exec-end:         func(call-id: string, name: string, result-json: string, is-error: bool);

  // --- 5.1/5.2 startup & session lifecycle ---
  // session_start (pi `SessionStartEvent`, extensions/types.ts:562-569 @v0.83.0): the `reason`
  // ("startup"|"reload"|"new"|"resume"|"fork") AND `previousSessionFile?`, documented "Present for
  // \"new\", \"resume\", and \"fork\"" — the field that tells a fresh session from a resume
  // (EXT-015).
  on-session-start:         func(reason: string, previous-session-file: option<string>);
  // session_shutdown (pi `SessionShutdownEvent`, extensions/types.ts:616-621 @v0.83.0): `reason`
  // plus `targetSessionFile?`, "Destination session file when shutting down due to session
  // replacement" (EXT-015).
  on-session-shutdown:      func(reason: string, target-session-file: option<string>);
  // session_info_changed (pi `SessionInfoChangedEvent`, extensions/types.ts:571-575 @v0.83.0,
  // subscribed at :1203): "Current normalized session name. Undefined when the name is cleared" —
  // hence `option<string>`, where `none` is upstream's `undefined` (EXT-011).
  on-session-info-changed:  func(name: option<string>);
  // resources_discover (pi `ResourcesDiscoverEvent`, extensions/types.ts:544-548 @v0.83.0):
  // `{type, cwd, reason: "startup" | "reload"}` (EXT-016).
  on-resources-discover:    func(cwd: string, reason: string) -> hook-outcome;   // provide skill/prompt/theme paths
  // project_trust (pi `ProjectTrustEvent`, extensions/types.ts:519-522 @v0.83.0): `{type, cwd}`.
  // The whole decision is per-DIRECTORY upstream — the store is keyed by it
  // (`options.trustStore.set(options.cwd, trusted)`, core/project-trust.ts:63-65) — so a handler
  // that cannot see the cwd cannot key an allowlist or honour `remember` (EXT-043).
  on-project-trust:         func(cwd: string) -> hook-outcome;    // decide {trusted, remember}

  // session control hooks (pi's overload block, extensions/types.ts:1190-1231 @v0.83.0):
  // before_* are block/mutate, the rest notify.
  // session_before_switch (pi `SessionBeforeSwitchEvent`, extensions/types.ts:578-582 @v0.83.0):
  // `reason: "new" | "resume"` AND `targetSessionFile?`. `reason` is the field that distinguishes
  // the two cases a handler most needs to tell apart, and cyrup dropped it entirely (EXT-015).
  on-session-before-switch:  func(reason: string, target-session-file: option<string>) -> hook-outcome;
  // session_before_fork (pi `SessionBeforeForkEvent`, extensions/types.ts:585-589 @v0.83.0):
  // `entryId` AND `position: "before" | "at"` — a fork BEFORE an entry and a fork AT it are
  // different operations (EXT-015).
  on-session-before-fork:    func(entry-id: string, position: string) -> hook-outcome;
  // session_before_compact (Pi SessionBeforeCompactEvent, types.ts:577-587): the computed
  // `preparation` (CompactionPreparation, compaction.ts:634) + the `branch-entries` in scope + optional
  // `custom-instructions` + the trigger `reason` ("manual"|"threshold"|"overflow") + `will-retry`. A
  // handler may VETO via `block` or return a compaction override via `mutate` (Pi
  // SessionBeforeCompactResult.compaction = a CompactionResult) — the override's summary/details land
  // in the appended compaction entry (fromExtension). All payloads cross as serde_json strings.
  on-session-before-compact: func(preparation-json: string, branch-entries-json: string, custom-instructions: option<string>, reason: string, will-retry: bool) -> hook-outcome;
  // session_compact (Pi SessionCompactEvent, types.ts:589-598): the produced `compaction-entry` (its
  // `summary` field carries the summary text), whether an extension drove it (`from-extension`), the
  // trigger `reason`, and `will-retry`.
  on-session-compact:        func(compaction-entry-json: string, from-extension: bool, reason: string, will-retry: bool);
  // session_before_tree (Pi SessionBeforeTreeEvent, types.ts:623-628): the computed `preparation`
  // (TreePreparation, compaction.ts) — targetId/oldLeafId/commonAncestorId/entriesToSummarize/
  // userWantsSummary/customInstructions?/label?. A handler may VETO via `block` or return a
  // summary/customInstructions/label override via `mutate` (Pi SessionBeforeTreeResult).
  on-session-before-tree:    func(preparation-json: string) -> hook-outcome;
  on-session-tree:           func(tree-json: string);

  // --- inter-extension event bus delivery (Pi `pi.events.on` listener, event-bus.ts:18-27) ---
  // The host invokes this on a guest that declared a `bus.subscribe(topic)` when ANY loaded guest
  // (this one included) `bus.emit`s that topic. `payload-json` is the emitted payload. Notify-style
  // (return ignored) — the receiving half of the bus that closes gap-08 §5.3.
  bus-deliver:               func(topic: string, payload-json: string);
}

// ---------------------------------------------------------------------------
// guest -> host: registration imports (arch-08 §3.5).
// ---------------------------------------------------------------------------
interface registration {
  use types.{tool-descriptor};
  register-tool:             func(t: tool-descriptor);
  register-command:          func(name: string, desc-json: string);
  register-shortcut:         func(key: string, desc: string);
  register-flag:             func(name: string, spec-json: string);
  get-flag:                  func(name: string) -> option<string>;
  register-provider:         func(id: string, config-json: string);
  unregister-provider:       func(id: string);
  register-message-renderer: func(custom-type: string);
  // Pi `registerMarkdownTransformer(transformer)` (`extensions/types.ts:1292` @v0.84.1, impl
  // `loader.ts:309-312`). Argument-less because the transformer itself is a guest closure the host
  // reaches through the `transform-markdown` EXPORT — this import only declares that this guest HAS
  // one. Upstream stores it as `extension.markdownTransformer = transformer`, i.e. AT MOST ONE per
  // extension with the last registration winning; the host models that the same way (EXT-019).
  register-markdown-transformer: func();
  // Pi `registerEntryRenderer(customType, renderer)` (`extensions/types.ts:1279` @v0.83.0, the
  // ported baseline — `:1295` @v0.84.1 / `loader.ts:314-318`) — the
  // custom-ENTRY surface, a SEPARATE table from register-message-renderer above (upstream keeps
  // `messageRenderers` and `entryRenderers` as disjoint maps, `types.ts:1677-1678` @v0.83.0 /
  // `:1702` and `:1704` @v0.84.1).
  //
  // EXT-036, VERSION-LAG class: this comment carried the v0.84.1 numbers (`:1295`, `:1703-1704`)
  // with NO version tag, in a file whose stated baseline is v0.83.0. At v0.83.0 `:1295` is
  // `sendUserMessage` and `:1703` does not exist (the file is 1701 lines); at v0.84.1 `:1703` is
  // `markdownTransformer`, i.e. neither of the two maps the sentence is about. An unversioned
  // citation that resolves to a different symbol at the ported tag reads as a fabrication to the
  // next auditor and cost this pass a round-trip to disprove — cite the tag you opened. An entry is
  // TUI-only durable state appended by `append-entry`; a message participates in LLM context. They
  // differ in what a FAULTING renderer draws: a message falls through to the default box
  // (custom-message.ts:82-84), an entry draws `[type] renderer failed: …` (custom-entry.ts:47-52).
  //
  // There is deliberately NO `render-entry` export: an entry is rendered over `render-call` above,
  // keyed by its custom-type, and the two surfaces are told apart by the HOST's registry table.
  // A fourth export would invalidate every already-built guest component for no behavioural gain.
  register-entry-renderer:   func(custom-type: string);
  add-autocomplete:          func(command: string);
  // global autocomplete provider stacking (Pi addAutocompleteProvider, types.ts:218): records that
  // the guest contributes one more stacked provider; the host folds them via `autocomplete-suggest`.
  add-autocomplete-provider: func();
  // declares the subscription bitset: which §5 event kinds this guest handles.
  subscribe:                 func(event-kinds: list<u8>);
}

// ---------------------------------------------------------------------------
// guest -> host: capabilities (arch-08 §3.6, caps/*).
//
// TWO gates stand in front of every interface in this block, and both are HOST-side (EXT-054).
// (1) The load-time trust check `is_trusted = origin.is_pre_trust() || project_trusted`
//     (`loader.rs`) decides whether the extension loads at all and which `HostServices` backend it
//     is handed — an untrusted one gets `DenyServices`.
// (2) The extension's OWN `extension.json` grant, `capabilities.{fs,exec,net,ui}`
//     (`manifest.rs`), narrows what it may ask for even on a fully capable backend: `ui` gates
//     `interface ui`, `exec` gates `exec` AND `proc` (process execution by another name), `net`
//     gates `http-client`, and `fs` supplies the roots `ext-fs` resolves against — no grant, no
//     root, no access. Every bit defaults to the DENYING value, so an absent `capabilities` block
//     grants nothing. The grant crosses as data and the guest has no import that reads or changes
//     it (ADR-0002).
// ---------------------------------------------------------------------------
interface ui {
  // EXT-036 (the import-surface re-run, completed here): every `types.ts` citation in this
  // interface was re-derived line by line against `v0.83.0`. A cluster of them was stale by a
  // uniform ~7 lines — the same offset, and therefore the same cause, as the cluster the register
  // in `cyrup-ext-sdk/src/ctx.rs` fixed on the SDK side: taken against a pi revision this region is
  // seven lines shorter in, not invented. Corrected below, with the old value named so nobody
  // "restores" it: notify `:135`->`:142`, set-status `:141`->`:148`, the dialog-options
  // `AbortSignal` `:89-94`->`:95-101`, editor `:216`->`:222`, the chrome trio
  // `:130-150`->`:183`/`:190`/`:193`. Two MORE were found here that the SDK-side register did not
  // list, of the same class: `custom` `:175`->`:196` (`:175` is the closing paren of the
  // `setWidget` component-factory overload), and the editor-buffer trio's `:200-230` range, which
  // named a function pi does not have — see that comment.
  //
  // notification severity (Pi `notify(message, type?: "info" | "warning" | "error")`,
  // `types.ts:142` @v0.83.0); info is Pi's default when the argument is omitted.
  enum notify-kind { info, warning, error }
  notify:     func(message: string, kind: notify-kind);
  // Pi `setStatus(key, text: string | undefined)` (`types.ts:148` @v0.83.0) — "Set status text in
  // the footer/status bar. Pass undefined to clear." A none `text` clears that key.
  set-status: func(key: string, text: option<string>);
  // programmatically dismiss any dialog bound to `signal-id` (Pi `ExtensionUIDialogOptions.signal`
  // AbortSignal, `types.ts:95-101` @v0.83.0 — the whole `{signal?, timeout?}` block; `signal?` is
  // `:98`): a dialog subsequently opened carrying that signal id returns
  // cancelled (`confirm` -> false, `input`/`select` -> none).
  abort-signal: func(signal-id: string);
  // Pi `onTerminalInput(handler: TerminalInputHandler): () => void` (`extensions/types.ts:145`
  // @v0.83.0) — "Listen to raw terminal input (interactive mode only). Returns an unsubscribe
  // function." Argument-less for the same reason `register-markdown-transformer` is: the handler
  // is a guest closure the host reaches through the `on-terminal-input` EXPORT, so this import
  // only declares that this guest HAS one. The returned unsubscribe function is
  // `unsubscribe-terminal-input`, which is idempotent — upstream's is a `Set.delete`.
  //
  // EXT-021: this pair is what the crate-level CYRUP-DELTA register named as the ONE member of
  // `interface ui` that was an open GAP rather than a delta ("It is expressible … unported only
  // because an export addition forces a HOST_WORLD bump"). That bump is 0.6 -> 0.7.
  subscribe-terminal-input:   func();
  unsubscribe-terminal-input: func();
  // `opts-json` is pi's `ExtensionUIDialogOptions` bag (`extensions/types.ts:95-101` @v0.83.0):
  // `{signal, timeout}` — `timeout?: number`, "Timeout in milliseconds. Dialog auto-dismisses with
  // live countdown display" (:100), and/or a programmatic-dismiss signal id (none = `{}`).
  // EXT-048: the citation this comment used to carry (`types.ts:89`, key `timeoutMs`) was wrong on
  // both counts — `:89` is a blank line before the UI Context banner at v0.83.0 and upstream has no
  // `timeoutMs` anywhere. `timeout` is now the CANONICAL key; `timeoutMs` is still accepted as a
  // serde alias for back-compat with bags cyrup's own SDK already wrote.
  // EXT-036, SECOND CLUSTER: the three `rpc-types.ts` citations below were stale by a uniform +8 —
  // the same failure mode as the `types.ts` cluster above, in a file the SDK-side register never
  // opened. The file is `packages/coding-agent/src/modes/rpc/rpc-types.ts` @v0.83.0, and the wire
  // shapes live in the `RpcExtensionUIRequest` union at `:238-248`. `:232` (the old confirm cite)
  // is a BLANK line and `:233-240` (the old input cite) starts on a banner comment.
  //
  // Pi `confirm(title, message, opts)` (`rpc-types.ts:240`): `prompt` is the short `title`,
  // `message` is the (often large, formatted) body — both genuinely used, e.g. pi-mcp-adapter's
  // sampling handler passes a label as `title` and the full prompt/conversation text as `message`.
  confirm:    func(prompt: string, message: string, opts-json: string) -> bool;
  // Pi `input(title, placeholder, opts)` (`rpc-types.ts:241-248`): `placeholder` is optional
  // (`none` = Pi omits the wire field entirely) and forwarded live to the renderer.
  input:      func(prompt: string, placeholder: option<string>, opts-json: string) -> option<string>;
  // single-choice select over a json array of options; returns the chosen string (none = cancel).
  // Pi `select(title, options, opts?): Promise<string | undefined>` (`extensions/types.ts:133`
  // @v0.83.0; wire shape `rpc-types.ts:239`). EXT-036: the SDK-side register recorded `:127` as the
  // stale value for this one; the WIT carried no citation at all, which is how it survived.
  select:     func(prompt: string, options-json: string, opts-json: string) -> option<string>;
  // multiline editor seeded with `initial`, labeled `title` (Pi
  // `editor(title, prefill?): Promise<string | undefined>`, `types.ts:222` @v0.83.0 — `:216` is
  // `setEditorText`, EXT-036); returns the edited text (none = cancelled).
  editor:     func(title: string, initial: string) -> option<string>;
  // Pi `setWidget(key, content: string[] | undefined, options?: ExtensionWidgetOptions)`
  // (`extensions/types.ts:170-175` @v0.83.0, plus a component-factory overload at `:171-175`), with
  // `ExtensionWidgetOptions {placement?}` at `:107-110` and
  // `WidgetPlacement = "aboveEditor" | "belowEditor"` at `:104`.
  //
  // EXT-047: this was `set-widget: func(widget-json: string)` — ONE opaque payload where pi takes
  // three arguments. The `key` is what makes the surface a MAP: one widget per key, so two
  // extensions no longer clobber each other; `none` content REMOVES that key's widget (upstream's
  // `content: undefined`), which cyrup could not express at all — the shipped subagents extension
  // hand-rolled `{"key": …, "content": null}` to mean it and the slot stayed occupied; and
  // `placement` decides which chrome slot it lands in, which was unexpressible.
  //
  // `content-json` is pi's `string[]` (the widget LINES) as serde_json, `none` = remove.
  // `opts-json` is the `ExtensionWidgetOptions` bag; `{}` = pi's default `"aboveEditor"`.
  set-widget: func(key: string, content-json: option<string>, opts-json: string);

  // --- chrome (Pi `setHeader` `types.ts:190`, `setFooter` `:183`, `setTitle` `:193` @v0.83.0;
  //     EXT-036: the range `:130-150` this line used to cite is the dialog/notify block above) ---
  set-header: func(content: string);
  set-footer: func(content: string);
  set-title:  func(title: string);
  // custom overlay component; returns an optional serialized result (Pi
  // `custom<T>(factory, ...)`, `types.ts:196` @v0.83.0 — "Show a custom component with keyboard
  // focus". EXT-036: `:175` is the closing paren of the `setWidget` component-factory overload).
  custom:     func(spec-json: string) -> option<string>;
  // --- editor buffer access (Pi `pasteToEditor` `types.ts:213`, `setEditorText` `:216`,
  //     `getEditorText` `:219` @v0.83.0).
  //
  //     EXT-036, NAME correction: this line used to read "getEditorText/setEditorText/
  //     pasteEditorText, types.ts:200-230". There is no `pasteEditorText` upstream — the pi name is
  //     `pasteToEditor` — so the citation named a function that does not exist, which is exactly
  //     the fabrication class EXT-036 was filed for, and the `:200-230` range was wide enough to
  //     hide it. The WIT import stays spelled `paste-editor-text`: renaming it would RE-SIGN an
  //     import and force a HOST_WORLD bump for a comment fix. That spelling is therefore a
  //     [CYRUP-DELTA] against `types.ts:213` — cyrup's import name, pi's semantics. ---
  get-editor-text:   func() -> string;
  set-editor-text:   func(text: string);
  paste-editor-text: func(text: string);
  // --- theme read/list/switch ---
  // Pi's live theme is the readonly `theme: Theme` property (`extensions/types.ts:266` @v0.83.0);
  // `theme-get` returns its NAME, the only part that survives the serde seam.
  theme-get:  func() -> option<string>;
  // Pi `getAllThemes(): { name: string; path: string | undefined }[]`
  // (`extensions/types.ts:269` @v0.83.0). EXT-021: cyrup returned a bare json array of NAMES, so a
  // guest could not tell a built-in theme from a file-backed one or locate the file to read it.
  // Now a json array of `{name, path}` rows, `path` null for a built-in.
  theme-list: func() -> string;          // json array of {name, path}
  // Pi `getTheme(name): Theme | undefined` (`extensions/types.ts:272` @v0.83.0) — load a theme by
  // name WITHOUT switching to it. `none` = no such theme. The serialized theme crosses as json.
  theme-get-by-name: func(name: string) -> option<string>;
  // Pi `setTheme(theme): {success, error?}` (`extensions/types.ts:275`).
  theme-set:  func(name: string) -> result<_, string>;

  // --- working / streaming indicator (Pi `ExtensionUIContext`, extensions/types.ts:151-167) ---
  // Pi `setWorkingMessage(message?: string)` at `:151`, "Set the working/loading message shown
  // during streaming. Call with no argument to restore default" — `none` IS that no-argument call.
  set-working-message:   func(message: option<string>);
  // Pi `setWorkingVisible(visible: boolean)` at `:154`, "Show or hide the built-in interactive
  // working loader row during streaming" — visibility INDEPENDENT of the message, which is exactly
  // what cyrup's collapsed `working-start(label)`/`working-stop()` pair could not express.
  set-working-visible:   func(visible: bool);
  // Pi `setWorkingIndicator(options?: WorkingIndicatorOptions)` at `:164`; the bag is
  // `{frames?: string[], intervalMs?: number}` at `:116-121`, where `frames: []` hides the
  // indicator entirely and omitting the argument restores the default animated spinner — hence
  // `none` for "no argument" and a json `{}` for "explicitly empty options".
  set-working-indicator: func(opts-json: option<string>);
  // Pi `setHiddenThinkingLabel(label?: string)` at `:167`, "Set the label shown for hidden thinking
  // blocks. Call with no argument to restore default".
  set-hidden-thinking-label: func(label: option<string>);
  // CYRUP-DELTA: `working-start`/`working-stop` are cyrup-ORIGINAL. Upstream has no `startWorking`
  // or `stopWorking` at v0.83.0 (`git grep -n 'startWorking\|stopWorking' v0.83.0` is empty) and
  // the `types.ts:265-275` this pair used to cite is `getAllThemes`/`getTheme`/`setTheme`/
  // `getToolsExpanded` — a fabricated citation (EXT-021/EXT-036). They are kept because guests and
  // the bundled example already call them; they are now defined in terms of the pi imports above:
  // `working-start(label)` == `set-working-message(some(label))` + `set-working-visible(true)`,
  // `working-stop()` == `set-working-visible(false)`.
  working-start: func(label: string);
  working-stop:  func();
  // --- tools-expanded get/set (Pi getToolsExpanded/setToolsExpanded) ---
  get-tools-expanded: func() -> bool;
  set-tools-expanded: func(expanded: bool);
}

interface session {
  // read-only session view (arch-04) over the boundary.
  entries-json: func() -> string;
  branch-json:  func() -> string;
  tree-json:    func() -> string;
  // R-08-026 state persistence: append a non-LLM custom entry.
  append-entry: func(custom-type: string, data-json: string) -> result<string, string>;
  set-session-name: func(name: string);
  get-session-name: func() -> option<string>;
  // pi `setLabel(entryId: string, label: string | undefined): void` (extensions/types.ts:1314
  // @v0.83.0), documented "Set or clear a label on an entry. Labels are user-defined markers for
  // bookmarking/navigation." `none` CLEARS (EXT-046) — an empty string writes an empty label, which
  // is not the same thing and left the entry marked forever.
  set-label:        func(entry-id: string, label: option<string>);
}

interface models {
  list-models:        func() -> string;          // json array of model refs
  // pi `ctx.scopedModels: readonly ScopedModel[]` (extensions/types.ts:326 @v0.83.0) — on the BASE
  // `ExtensionContext`, so available to every handler: "Models scoped to this session (resolved
  // from `--models` / `enabledModels` settings against the available catalogue). Same set the
  // `/scoped-models` command shows. Empty when no scoping is configured." json array (EXT-045).
  scoped-models:      func() -> string;
  current:            func() -> option<string>;
  set-model:          func(model-json: string);  // COMMAND-only at the host
  context-usage:      func() -> string;
  thinking-level:     func() -> option<string>;
  // COMMAND-only at the host (deadlock rule): Pi allows setThinkingLevel from any handler
  // (runner.ts:330), but cyrup routes it through the command-tier `control` path, so an event-tier
  // call is REJECTED with an observable error (like every `control.*` op) — never a silent no-op.
  set-thinking-level: func(level: string) -> result<_, string>;
}

interface exec {
  use types.{exec-result};
  run: func(cmd: string, args: list<string>, opts-json: string) -> result<exec-result, string>;
}

// A long-lived, duplex-pipe child process — the L4 `proc` capability (pi-mcp-adapter-port.md §3.1,
// the locked drafted shape) backing MCP stdio transport (`StdioClientTransport`, the majority
// real-world MCP server shape). Distinct from `exec.run`'s bounded run-capture-return one-shot:
// `proc` stays open across many host calls, with a live stdin the guest can keep writing to and a
// live stdout/stderr the guest polls incrementally as the child produces output over time. Gated by
// the SAME load-time trust check `exec`/`ui`/`http-client` use (`is_trusted =
// origin.is_pre_trust() || project_trusted`, loader.rs:57-60); an untrusted extension gets
// `DenyServices` and this interface is unreachable, exactly like `exec`/`http-client`.
//
// The host owns actual process lifetime and byte-stream buffering (a real `tokio::process::Child` +
// buffered pipe-reader tasks keyed by an opaque `handle`, `cyrup-ext/src/caps/proc.rs`); the guest
// polls (the SAME request/poll bridge `http-client`'s stream registry uses, arch-08 §5.2) rather
// than holding a live process handle across the wasm boundary.
interface proc {
  // Spawn a long-lived child; returns a handle or an error. `capture-stderr` mirrors Pi's
  // debug-mode "inherit" vs "ignore" (server-manager.ts:111).
  spawn: func(cmd: string, args: list<string>, env-json: string, cwd: option<string>,
              capture-stderr: bool) -> result<u32, string>;   // u32 = proc-handle

  // Write to the child's stdin. Returns bytes written or an error (e.g. pipe closed).
  write-stdin: func(handle: u32, data: list<u8>) -> result<u32, string>;

  // Read the next chunk of stdout (non-blocking poll; empty list = no data yet, not EOF).
  // EOF is signalled by a subsequent `poll-exit` returning `some`.
  read-stdout: func(handle: u32, max-bytes: u32) -> result<list<u8>, string>;
  read-stderr: func(handle: u32, max-bytes: u32) -> result<list<u8>, string>;

  // Poll whether the child has exited; `some(code)` once terminated.
  poll-exit: func(handle: u32) -> option<s32>;

  // Terminate the child: close stdin (EOF), then SIGTERM, then SIGKILL, each escalation gated on
  // a grace period if the child is still alive (host-side policy; mirrors the real
  // StdioClientTransport.close()'s three-phase escalation).
  kill: func(handle: u32) -> result<_, string>;
}

// Outbound HTTP only (no raw TCP-connect; no ambient authority) — the L4 `http-client` capability
// (pi-mcp-adapter-port.md §3.2, the locked drafted shape). Gated by the SAME load-time trust check
// `exec`/`ui` use (`is_trusted = origin.is_pre_trust() || project_trusted`, loader.rs:57-60); an
// untrusted extension gets `DenyServices` and this interface is unreachable, exactly like `exec`.
// `request` is a bounded round trip. `request-stream`/`poll-stream-chunk`/`close-stream` back a
// long-lived streaming body (SSE / StreamableHTTP chunked responses): the HOST owns the live byte
// stream and the guest polls it (a guest cannot hold a live Rust stream across the wasm boundary —
// the request/poll bridge, arch-08 §5.2), keyed by an opaque `handle`.
interface http-client {
  record http-request {
    method: string,                       // "GET" | "POST" | ...
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
    timeout-ms: option<u32>,
  }
  record http-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }
  // The initiating response's metadata for a stream opened via `request-stream`, returned ALONGSIDE
  // the stream handle from the SAME round trip that opens the long-lived body (closes L4 §2.3: the
  // real consumer this capability backs — the MCP TS SDK's `StreamableHTTPClientTransport`/
  // `SSEClientTransport` — reads `response.status` (401 => re-auth) and `response.headers`
  // (`mcp-session-id`, `content-type`) off the SAME response whose body it then streams; there is no
  // second request to recover this metadata from, and a POST with side effects can't be re-issued to
  // do so). `body` is deliberately absent here — drain it via `poll-stream-chunk`.
  record http-stream-response {
    handle: u32,                          // stream-handle for poll-stream-chunk/close-stream
    status: u16,
    headers: list<tuple<string, string>>,
  }

  // A single request/response call. A non-2xx status is NOT itself a WIT error (fetch semantics) —
  // only a transport failure (DNS, connect refused, TLS, timeout) is; the guest inspects `status`.
  request: func(req: http-request) -> result<http-response, string>;

  // Streaming variant for SSE / StreamableHTTP's chunked responses. Returns the initiating response's
  // status+headers TOGETHER with a stream handle in one round trip; the guest polls for the next body
  // chunk via `poll-stream-chunk` (request/poll bridge, arch-08 §5.2) rather than the host blocking
  // the guest's Store on an unbounded-duration long poll.
  request-stream: func(req: http-request) -> result<http-stream-response, string>;
  poll-stream-chunk: func(handle: u32) -> result<option<list<u8>>, string>;  // none-of-none = EOF
  close-stream: func(handle: u32);
}

interface ext-fs {
  // capability-scoped; preopened dirs via WASI p2 (no ambient authority).
  read-file:  func(path: string) -> result<list<u8>, string>;
  write-file: func(path: string, data: list<u8>) -> result<_, string>;
}

interface bus {
  // inter-extension event bus (R-08-029; Pi `createEventBus()`, event-bus.ts:12-32). A guest
  // `emit`s a topic; the host fans it out to every guest that `subscribe`d that topic (its
  // `events.bus-deliver` export is invoked with the payload — the receive side that makes this a
  // real pub/sub, not an emit-into-a-void). `emit` enqueues; the host drains + delivers after the
  // emitting guest call unwinds (Pi's EventEmitter `emit` likewise returns without awaiting its
  // async listeners; wasm single-instance reentrancy forbids re-entering the emitter synchronously).
  emit:      func(topic: string, payload-json: string);
  // Declare that this guest listens on `topic` (Pi `pi.events.on(channel, handler)`, event-bus.ts:18).
  subscribe: func(topic: string);
  // Stop listening on `topic` (EXT-050). pi's `on()` returns an unsubscribe closure and, since
  // v0.84.1, the loader TRACKS it — `return runtime.trackEventBusSubscription(eventBus.on(channel,
  // handler));` (extensions/loader.ts:413-421) — so a listener wanted only while a mode is active
  // can be taken down. Without this a `subscribe` was permanent for the instance's life and the
  // guest had to filter by hand.
  unsubscribe: func(topic: string);
}

// streaming tool output: the `onUpdate` callback of Pi's ToolDefinition.execute (types.ts:484).
interface host-tool {
  emit-update: func(call-id: string, chunk-json: string);
  // the tool's AbortSignal (Pi `ToolDefinition.execute` `signal` param, types.ts:483): the guest
  // polls this during a long `execute` to cooperatively stop. True once the host cancels the call
  // (epoch/`CancelToken`) or a named signal for this `call-id` was aborted (`ui.abort-signal`).
  is-cancelled: func(call-id: string) -> bool;
}

// OAuth login callbacks (Pi `OAuthLoginCallbacks`, pi-ai oauth/types.ts): the host-side handlers a
// guest's `login(callbacks)` flow drives during `provider-login`. The host renders the auth URL /
// device code / prompts and returns the user's answers (the interactive half of `/login`).
interface oauth {
  on-auth:        func(url: string, instructions: option<string>);
  on-device-code: func(user-code: string, verification-uri: string, interval-seconds: option<u32>, expires-in-seconds: option<u32>);
  // prompt for a value (e.g. "Paste the callback URL"); err = cancelled.
  on-prompt:      func(message: string, placeholder: option<string>, allow-empty: bool) -> result<string, string>;
  on-progress:    func(message: string);
  // interactive selector over a json array of {id,label}; returns the chosen id (none = cancel).
  on-select:      func(message: string, options-json: string) -> option<string>;
}

// streamSimple output (Pi `createAssistantMessageEventStream`, types.ts:1373): the guest's custom
// stream pushes assistant-message stream events keyed by `stream-id`; the host forwards them to the
// provider pipeline (the streaming analog of `host-tool.emit-update`).
interface provider-stream {
  emit-event: func(stream-id: string, event-json: string);

  // EXT-052 — the `streamSimple` MUST-INVOKE contract, quoted verbatim from pi's
  // `ProviderConfig.streamSimple` doc (`extensions/types.ts:1452-1457` @v0.84.1):
  //
  //   "Implementations must invoke `options.onPayload` before sending the provider request and use
  //    any returned replacement payload. They must invoke `options.onResponse` after receiving the
  //    response and before consuming its body, matching built-in providers."
  //
  // These are how `before_provider_request` (extensions/types.ts:676-679) and
  // `after_provider_response` (:692-696) reach requests an EXTENSION-supplied provider issues. A
  // guest provider that skips them makes every one of its requests invisible to every other
  // extension — a redaction or audit extension silently stops working the moment the user switches
  // model. `on-payload` returns a REPLACEMENT payload (`none` = unchanged), which is the mutating
  // half; `on-response` is notify-only.
  on-payload:  func(stream-id: string, payload-json: string) -> option<string>;
  on-response: func(stream-id: string, status: u16, headers-json: string);
}

// Active-tool / command introspection (Pi getActiveTools/getAllTools/setActiveTools/getCommands,
// types.ts:1257-1266): the plan-mode active-tool restriction surface. `set-active-tools` is the only
// mutating one; the host enforces the merge (arch-08 §3.5).
interface ext-tools {
  get-active-tools: func() -> string;   // json array of active tool names
  get-all-tools:    func() -> string;   // json array of ToolInfo {name, source, parameters, …}
  set-active-tools: func(names-json: string);
  get-commands:     func() -> string;   // json array of SlashCommandInfo {name, description}
}

// Read-only ctx state (Pi `ExtensionContext`, extensions/types.ts:305-347). Pi puts `mode`, `hasUI`,
// `isIdle`, `hasPendingMessages`, `isProjectTrusted` and `getSystemPrompt` on the BASE context —
// available to EVERY handler, not just command handlers — so these are deliberately NOT tier-gated.
// The native built-in path reads the same six values off `HostCtx` / `HostCtx::rich()`.
interface ctx-state {
  use types.{ext-mode};

  // Pi `ctx.mode` (types.ts:311): the run mode — a guest guards terminal-only UI (custom
  // components) on `tui`. A FIELD in Pi; a getter here because WIT imports are functions.
  get-mode:             func() -> ext-mode;
  // Pi `ctx.hasUI` (types.ts:313): "Whether dialog-capable UI is available (true in TUI and RPC
  // modes)" — the guard a guest checks before `ui.confirm`/`input`/`select`.
  has-ui:               func() -> bool;
  // Pi `ctx.isIdle()` (types.ts:333): false while an agent run is in flight.
  is-idle:              func() -> bool;
  // Pi `ctx.hasPendingMessages()` (types.ts:341): queued user messages awaiting the next turn.
  has-pending-messages: func() -> bool;
  // Pi `ctx.isProjectTrusted()` (types.ts:335).
  is-project-trusted:   func() -> bool;
  // Pi `ctx.getSystemPrompt()` (types.ts:346); empty string when no session backend is attached.
  get-system-prompt:    func() -> string;
  // pi `ctx.cwd: string` (extensions/types.ts:315 @v0.83.0) — on the BASE `ExtensionContext`, in
  // the same block as `mode` (:311) and `hasUI` (:313), so it is available to every handler and
  // every tool `execute`, not just command handlers. Without it a guest can resolve no relative
  // path at all: it cannot tell which project it is in, scope a cache, interpret a path in a tool
  // argument, or compose one for its `ext-fs`/`exec` grant (EXT-044). cyrup's NATIVE tier already
  // exposed it (`HostCtx.cwd`), so this was a divergence between cyrup's own two tiers as well.
  get-cwd:              func() -> string;
  // The run-scoped analog of `host-tool.is-cancelled` (EXT-045). pi puts `signal: AbortSignal |
  // undefined` on the base `ExtensionContext` (extensions/types.ts:334 @v0.83.0, "The current abort
  // signal, or undefined when the agent is not streaming").
  //
  // CYRUP-DELTA: a live `AbortSignal` is an object with `addEventListener`, and a component-model
  // value cannot be a callback target — the guest cannot be WOKEN by an abort, only ask about it.
  // So the signal is ported as a poll, not as a subscription: a long-running non-tool handler
  // checks this between units of work. `true` also once the whole run is cancelled, which is when
  // upstream's `signal.aborted` flips.
  is-run-cancelled:     func() -> bool;
}

// COMMAND-ONLY (arch-08 §6.3, deadlock rule): session/runtime mutation. Calling any of
// these from an event handler returns a host-side deadlock error (surfaced, never a hang).
// EXCEPT `abort`/`shutdown` — see their comments: Pi puts both on the BASE `ExtensionContext`
// (types.ts:339-340,344), callable from any handler, so cyrup does NOT tier-gate them.
interface control {
  // opts-json carries the typed Pi option bags (newSession{parentSession,withSession},
  // fork{position,withSession}, switchSession{withSession}, navigateTree{summarize,…}, types.ts:346-368).
  new-session:   func(opts-json: string) -> result<_, string>;
  switch:        func(session-id: string, opts-json: string) -> result<_, string>;
  fork:          func(entry-id: string, opts-json: string) -> result<_, string>;
  navigate:      func(entry-id: string, opts-json: string) -> result<_, string>;
  reload:        func() -> result<_, string>;
  // compact (Pi `ctx.compact(options?)`, types.ts:344): opts-json carries `CompactOptions`
  // (types.ts:296-300) — `{customInstructions}`. Pi's `onComplete`/`onError` callbacks cannot cross
  // the component boundary as function values; a guest observes completion by subscribing to the
  // `session_compact` event (Pi's own `SessionCompactEvent` carries the produced entry).
  compact:       func(opts-json: string) -> result<_, string>;
  wait-idle:     func() -> result<_, string>;
  // send-message (types.ts:1223): opts-json carries {triggerTurn, deliverAs}.
  send-message:      func(message-json: string, opts-json: string) -> result<_, string>;
  send-user-message: func(content: string, opts-json: string) -> result<_, string>;

  // Pi `ctx.abort()` (extensions/types.ts:339, "Abort the current agent run. Available in all
  // contexts."): cancels the in-flight run. NOT tier-gated — an event handler (e.g. a
  // `tool_call` gate that decides the whole run must stop) is exactly Pi's use case, and abort
  // cannot deadlock the way a session REPLACEMENT op can.
  abort:    func() -> result<_, string>;
  // Pi `ctx.shutdown()` (extensions/types.ts:344, "Gracefully shutdown pi and exit. Available in
  // all contexts."). Sets the host's shutdown-requested flag; the host acts on it at the next
  // settle point (Pi rpc-mode.ts:355-358). Also NOT tier-gated.
  shutdown: func() -> result<_, string>;
}

world extension {
  import registration;
  import ui;
  import session;
  import models;
  import exec;
  import proc;
  import http-client;
  import ext-fs;
  import bus;
  import host-tool;
  import oauth;
  import provider-stream;
  import ext-tools;
  import control;
  import ctx-state;

  export events;
  // async init unit, awaited before the loader continues (R-08-001).
  export init: func() -> result<_, string>;
}
