// cyrup:ext@0.18.0 — the versioned WIT world (arch-08 §4.1).
//
// Single source of truth, shared verbatim by the host (`wasmtime::component::bindgen!`)
// and the guest (`wit-bindgen` in cyrup-ext-sdk). Open-shaped values (tool params, message
// lists, patches, custom payloads) cross as `string` carrying serde_json; fixed-shape control
// values (ids, enums, exec results) are real WIT records for type safety (arch-08 §4.1).
//
// The `events` interface exports 39 `on-*` hooks. THIRTY-THREE of them mirror pi's `pi.on(...)`
// catalog one-for-one (`extensions/types.ts:1190-1231` @v0.83.0 — 33 `on(event: "…")` overloads,
// hand re-derived; the range `:1198-1239` this header used to cite corresponds to NO upstream
// version and was fabricated, EXT-036). `before_provider_headers` (EXT-009, upstream `:1212`) and
// `session_info_changed` (EXT-011, upstream `:1193`) closed the last two gaps — EXT-073: the
// `:1203` this line and the event's own comment carried is `session_compact`'s overload, not this
// event's, and is one of the fabricated-band citations that item cleared. The 34th,
// `on-terminal-input`, is NOT an `on(event: …)` overload: it is the guest-side half of
// `ExtensionUIContext.onTerminalInput(handler)` (`extensions/types.ts:145` @v0.83.0), which
// upstream registers as a closure rather than a named event — a closure cannot cross a component
// boundary, so it lands here as an export paired with the `ui.subscribe-terminal-input` import
// (EXT-021). The 35th, `on-branch-change`, is the same shape for the same reason: it is
// `ReadonlyFooterDataProvider.onBranchChange(callback)` (`core/footer-data-provider.ts:139-143`
// @v0.87.1), a closure subscription upstream hands the `setFooter` factory, paired here with the
// `ui.subscribe-branch-change` import (EXT-064). Count the `on-*` lines, not the pi events: the two
// numbers are 35 and 33. Three more mirror events pi added AFTER that tag and cyrup ported in the
// 0.11 -> 0.12 batch below: `ui_prompt_start`/`ui_prompt_end` (v0.84.4) and `context_with_system`
// (v0.87.0). The 39th, `on-cache-warming-decision` (EXT-085), mirrors a pi event too, but the one
// pi declares OUTSIDE `extensions/types.ts`: `CacheWarmingDecisionEvent` lives in
// `core/cache-warmer.ts:112-115` @v1.0.4 and is pulled into the `ExtensionEvent` union in
// `core/extensions/types.ts` @v1.0.4, with its `on(event: …)` overload at `:1589-1591` — so it is
// absent from the overload band this header counts and has to be added by hand. That makes it
// 39 `on-*` exports against 37 pi events at v1.0.4.
// The host calls only the exports a guest subscribed to (the subscription gate, R-08-034).
//
// VERSIONING (EXT-028): this package version and `cyrup_ext::HOST_WORLD` move TOGETHER, and ANY
// change to an EXPORT — added, removed, or RE-SIGNED — bumps the MINOR. A guest built against an
// older MINOR either lacks the export or has it at the old signature, so it must be refused by
// `ExtensionManifest::check_world` before instantiation rather than trapping inside wasmtime.
// `crates/cyrup-ext/tests/wit_world_sync.rs` enforces that tie, in BOTH copies.
//
// A RE-SIGNED IMPORT bumps the MINOR for the same reason in the opposite direction: an old guest
// calls the import at the old signature and fails to LINK against the new host. 0.5 -> 0.6 is one
// such batch (ADR-0002's one-bump-per-pass rule): `ui.set-widget` gained pi's key/placement
// (EXT-047) and `ui.theme-list` widened to `{name, path}` rows (EXT-021). Purely ADDITIVE imports
// in the same batch (`ui.set-working-*`, `ui.set-hidden-thinking-label`, `ui.theme-get-by-name`)
// would not have needed a bump on their own. 0.6 -> 0.7 is another such batch, and this one hits
// BOTH directions: `types.tool-descriptor` gained `constrained-sampling`, which RE-SIGNS the
// `registration.register-tool` import (PROV-011 / EXT-024), and the `events.on-terminal-input`
// EXPORT was ADDED alongside the `ui.subscribe-terminal-input`/`ui.unsubscribe-terminal-input`
// imports (EXT-021). Either one alone forces the bump.
//
// 0.7 -> 0.8 is the ext-rpc surface-enumeration batch, and it hits both directions too. EXPORTS:
// `events.on-tool-exec-{start,update,end}` were RENAMED to `on-tool-execution-*` to match pi's event
// names mechanically (EXT-069), and `events.on-session-tree`'s parameter was renamed `tree-json` ->
// `event-json` because the payload is pi's four-field LEAF TRANSITION, not a tree dump (EXT-068).
// IMPORTS: `add-autocomplete-provider` MOVED from `interface registration` to `interface ui`, which
// is what puts it behind the manifest's `capabilities.ui` grant (EXT-065), and `ui.theme-get-json`
// was ADDED so a guest can read the colours of the theme that is actually active (EXT-066).
// THREE of those four force the bump on its own; `theme-get-json` does NOT, and this line used to
// say all four did. A purely ADDITIVE import cannot break an already-built guest — the host simply
// offers an import nothing calls — which is why `manifest.rs`'s history entry for this same batch
// records it as "would not have required a bump on its own". The two statements contradicted each
// other; `manifest.rs` is the correct one (EXT-061 re-derived it against `check_world`).
//
// 0.8 -> 0.9 is the renderer display-options batch, and it is an EXPORT re-signing:
// `events.render-call` and `events.render-result` each gained a third parameter, `opts-json`,
// carrying the `(options, theme)` half of every upstream renderer signature (EXT-006;
// `MessageRenderer` `extensions/types.ts:1213-1217` @v0.84.4, `EntryRenderer` `:1219-1223`,
// `ToolDefinition.renderCall`/`renderResult` `:491-498`). A 0.8 guest exports the two-parameter
// shape and would die inside wasmtime on the link; `check_world` turns that into a typed
// `ExtError::WorldVersion` instead. No import moved in this batch.
//
// ADDED WITHOUT A BUMP, same batch, same rule: `ctx-state.get-system-prompt-options` (EXT-061), the
// last unaccounted-for member of pi's extension API surface. Recorded here because "additive import,
// no bump" is the ONE case where the world file changes and the version does not, so a reader
// diffing the two will otherwise read it as the `f777e44` mistake.
//
// AND THE LIMIT OF THE GATE, which nothing else in the tree states: `check_world` accepts a guest
// whose minor is >= the host's (`manifest.rs`), so it defends exactly one direction — an OLD guest
// against a NEW host. A guest built against a NEWER world than the host it runs on is ACCEPTED and
// then dies in wasmtime on the missing import, and NO version bump can change that, because the
// bump moves the host's floor rather than its ceiling. Bumping for an additive import therefore buys
// nothing and costs every already-built guest at the old minor.
//
// 0.9 -> 0.10 is the guest-supplied BASH BACKEND batch, and it is again an EXPORT re-signing:
// `events.bash-operations-exec` is NEW, so a 0.9 guest exports nothing under that name and would
// die inside wasmtime on the link (`check_world` turns that into a typed `ExtError::WorldVersion`
// instead). It is the guest half of pi's `UserBashEventResult.operations`
// (`core/extensions/types.ts:1136-1142` @v0.84.4, the `BashOperations` interface at
// `core/tools/bash.ts:63-81`), which a WASM guest cannot RETURN because it is a callable
// (ADR-0002) — so the callable stays guest-side behind an export the host calls by `call-id`, and
// its two closure-shaped arguments (`onData`, `signal`) come back over the new `host-bash`
// interface. DRIFT-004. The `registration.register-bash-operations` and `host-bash.*` IMPORTS are
// additive and would not have forced a bump on their own (see the paragraph above).
//
// 0.10 -> 0.11 is the extension-CHROME batch (EXT-064), and it hits both directions of the gate:
// `ui.set-header` / `ui.set-footer` are RE-SIGNED to `option<string>` (so a guest can set an EMPTY
// custom footer without it meaning "restore the built-in"), and `events.on-branch-change` is a NEW
// export, arriving with the additive `ui.subscribe-branch-change` / `ui.unsubscribe-branch-change`
// imports. A 0.10 guest has the old setter signatures and no such export, so it takes the bump.
//
// 0.11 -> 0.12 is the post-baseline EVENT batch, an EXPORT addition: `events.on-ui-prompt-start`
// and `events.on-ui-prompt-end` (EXT-075; pi `UIPromptStartEvent`/`UIPromptEndEvent`,
// `core/extensions/types.ts:830-845` @v0.87.1) and `events.on-context-with-system` (EXT-079; pi
// `ContextWithSystemEvent`, `:708-711`) are NEW, so a 0.11 guest exports nothing under those names
// and `check_world` refuses it rather than letting it die in wasmtime. The same batch ADDS the
// `registration.unsubscribe` import (EXT-080; the remover pi's `on()` has returned since v0.86.0),
// which is additive and would not have forced a bump on its own.
//
// 0.12 -> 0.13 is the registration-REFUSAL batch, an IMPORT RE-SIGNING: `registration.register-tool`
// and `registration.register-flag` now return `result<_, string>` (EXT-082). pi's `registerTool`
// and `registerFlag` THROW on an invalid registration (`core/extensions/loader.ts:274-279` and
// `:312-316` @v0.87.1), which ends the rest of the calling handler body; the `err` arm is that
// throw as a value, so an SDK guest hands it to the author as a Rust `Result` to `?` out of the
// handler. They are the only two registration imports pi validates. A 0.12 guest calls both at
// the old `()`-returning signature and would fail to LINK against this host, so it takes the bump.
//
// 0.13 -> 0.14 is the tool-exposure batch, an IMPORT RE-SIGNING: `types.tool-descriptor` gained
// `exposure`, `namespace` and `default-active` (pi `ToolDefinition.exposure` / `namespace` /
// `defaultActive`, `extensions/types.ts:509`, `:527`, `:608` @v1.0.1), which re-signs
// `registration.register-tool`. A 0.13 guest calls it with the record without them and would fail
// to LINK against this host, so it takes the bump.
//
// 0.14 -> 0.15 is the nested-tool-call batch (pi `ExtensionToolContext.executeTool` / `.tools`,
// `extensions/types.ts:367-395`, and the `parentToolCallId` of `tool_call`, `tool_result` and
// `tool_execution_*`, `:1061-1083`, `:1155-1161`, `:1231` @v1.0.1), an EXPORT RE-SIGNING:
// `events.on-tool-call`, `on-tool-result` and `on-tool-execution-{start,update,end}` each gained a
// trailing `parent-tool-call-id: option<string>`. A 0.14 guest exports the shorter signatures and
// would fail to LINK against this host, so it takes the bump (the 0.8 -> 0.9 `render-call`
// precedent). The two `host-tool` imports that make a guest tool's `execute` able to call tools,
// `execute-tool` and `callable-tools`, are ADDITIVE and would not have required one on their own.
//
// 0.15 -> 0.16 is the structured-content batch (pi `ToolResultEventBase.structuredContent` and
// `ToolResultEventResult.structuredContent`, `extensions/types.ts:1238`, `:1445` @v1.0.1), an EXPORT
// RE-SIGNING: `events.on-tool-result` gained a trailing `structured-content-json: option<string>`,
// the tool's machine-readable result (`none` when it returned none). The patch direction needs no
// new field: it rides the `hook-outcome` mutate JSON, whose `structuredContent` key the host now
// reads. A 0.15 guest exports the shorter signature and would fail to LINK against this host, so it
// takes the bump (the 0.14 -> 0.15 and 0.2 -> 0.3 `on-tool-result` precedents).
//
// 0.16 -> 0.17 is the guest-tier VIRTUAL MODEL batch (pi `pi.registerVirtualModel` /
// `pi.unregisterVirtualModel`, `core/extensions/types.ts:1865-1876` @v1.0.4, the registered type
// `ExtensionVirtualModel<TState>` at `:1886-1889`), an EXPORT ADDITION: `events.route-model` is
// NEW, so a 0.16 guest exports nothing under that name and would die inside wasmtime on the link —
// `check_world` turns that into a typed `ExtError::WorldVersion` instead (the 0.9 -> 0.10
// `bash-operations-exec` and 0.10 -> 0.11 `on-branch-change` precedents). It is the guest half of
// pi's `route()` callback, which a WASM guest cannot pass as a VALUE (ADR-0002), so the callable
// stays guest-side behind an export the host calls once per provider request, keyed by
// `(provider, id)` because upstream lets one provider list several virtual models. The
// `registration.register-virtual-model` / `unregister-virtual-model` IMPORTS and the whole
// `host-router` interface (pi's `ModelRouteRequest.signal`, ported as a poll exactly as
// `host-bash.is-bash-cancelled` ports `BashOperations.exec`'s) arrive in the same batch and are
// ADDITIVE — neither would have forced a bump on its own (see the "ADDED WITHOUT A BUMP"
// paragraph above).
// 0.17 -> 0.18 is the `cache_warming_decision` hook (pi `CacheWarmingDecisionEvent` /
// `CacheWarmingDecisionEventResult`, `core/cache-warmer.ts:112-120` @v1.0.4, reduced by
// `emitCacheWarmingDecision`, `core/extensions/runner.ts:1121-1142`), an EXPORT ADDITION:
// `events.on-cache-warming-decision` is NEW, so a 0.17 guest exports nothing under that name and
// would die inside wasmtime on the link — `check_world` turns that into a typed
// `ExtError::WorldVersion` instead (the 0.16 -> 0.17 `route-model` and 0.9 -> 0.10
// `bash-operations-exec` precedents). It is an EVENT WITH A RESULT, so it rides the existing
// `hook-outcome` return rather than needing a new variant: `handled({"action": "warm" | "stop"})`
// overrides the host's own economics verdict, `noop` leaves it alone. Nothing else moves in this
// batch — no new import, no re-signed export.
//
// ADDED WITHOUT A BUMP, 0.18 (after the batch above): the model-CALL imports of `interface models` —
// `complete`, `%stream`, `stream-simple`, `poll-stream` and `close-stream` (EXT-086; pi
// `ctx.modelRegistry.complete()`, `stream()` and `streamSimple()`, `core/model-registry.ts`
// @v1.0.4). All five are new IMPORTS and no existing import or export changed shape, so a guest
// built against an earlier 0.18 still links: the host simply offers imports it does not call (the
// "ADDED WITHOUT A BUMP" rule above). The manifest grant that gates them, `capabilities.modelCalls`,
// is a new DEFAULTED field, so an older `extension.json` parses unchanged and gets the denying
// value. A guest built against THIS file and loaded on a host from before it is accepted by
// `check_world` and fails on the missing import — the documented limit of the gate, which no bump
// could change.
package cyrup:ext@0.18.0;

// ---------------------------------------------------------------------------
// Serializable mirrors of cyrup-core. JSON-as-string at the seam (arch-08 §4.1).
// ---------------------------------------------------------------------------
interface types {
  enum exec-mode { parallel, sequential }
  enum ext-mode  { tui, rpc, json, print }

  // A `[block]` outcome (EXT-049). `reason` is pi's `ToolCallEventResult.reason`; `terminate` is
  // pi's `ToolCallEventResult.terminate` (`extensions/types.ts:1072-1079` @v0.84.1 — ABSENT at the
  // ported v0.83.0 baseline): "Hint that the agent should stop after the current tool batch when
  // this call is blocked. Early termination only happens when every finalized tool result in the
  // batch sets this to true." Only `on-tool-call` reads it; every other seam ignores it, exactly as
  // upstream does (no other `*EventResult` declares the field).
  record block-result {
    reason: option<string>,
    terminate: bool,
  }

  // What a single event handler contributes to the block/mutate/notify reduction
  // (arch-08 §3.3). `mutate`/`handled` carry serde_json patch payloads as strings; the host
  // interprets the patch shape per the event kind (Pi extensions/runner.ts emit* reducers).
  variant hook-outcome {
    noop,
    block(block-result),
    mutate(string),
    handled(string),
  }

  // Guest -> host tool registration descriptor (arch-08 §3.5). `parameters-json` stays
  // JSON-Schema (Pi-interop, R-ARCH-EXT-008).
  record tool-descriptor {
    name: string,
    label: string,
    description: string,
    parameters-json: string,
    exec-mode: option<exec-mode>,
    prompt-snippet: option<string>,
    prompt-guidelines: list<string>,
    has-renderer: bool,
    // pi `ToolDefinition.prepareArguments?: (args: unknown) => Static<TParams>`
    // (extensions/types.ts:468 @v0.83.0), run before `validateToolArguments` in
    // `packages/agent/src/agent-loop.ts`. A function value cannot cross a component boundary, so
    // the descriptor carries a FLAG and the host calls the `prepare-arguments` export when it is
    // set (EXT-023). `false` = the identity default.
    prepare-arguments: bool,
    // pi `ToolDefinition.renderShell?: "default" | "self"` (extensions/types.ts:465 @v0.83.0):
    // "Controls whether ToolExecutionComponent renders the standard colored shell or the tool
    // renders its own framing." `none` = upstream's omitted field = "default" (EXT-024).
    render-shell: option<string>,
    // pi `ToolDefinition.constrainedSampling?: false | ConstrainedSamplingConfig`
    // (extensions/types.ts:463 @v0.83.0), copied verbatim onto the runtime tool by
    // `wrapToolDefinition` (core/tools/tool-definition-wrapper.ts:14) and resolved provider-side
    // by `packages/ai/src/api/constrained-sampling.ts`. Carried as the JSON of that union —
    // `false`, `{"type":"json_schema","strict":"prefer"|"require"}` or
    // `{"type":"grammar","variants":{"openai_lark"?,"openai_regex"?}}` — because it is an
    // open-shaped value per the header's rule. `none` = the omitted field, which upstream is
    // indistinguishable from `false` (PROV-011 / EXT-024).
    constrained-sampling: option<string>,
    // pi `ToolDefinition.exposure?: ToolExposure` (extensions/types.ts:509 @v1.0.1), carried as
    // pi's string literal: "direct" | "model-only" | "codemode" | "deferred" | "hidden". `none` =
    // the omitted field = "direct". Any other spelling is REFUSED by `register-tool` with an
    // `err` naming it, never coerced.
    exposure: option<string>,
    // pi `ToolDefinition.namespace?: ToolNamespace` (extensions/types.ts:527 @v1.0.1). `none` =
    // the tool belongs to no group.
    namespace: option<tool-namespace>,
    // pi `ToolDefinition.defaultActive?: boolean` (extensions/types.ts:608 @v1.0.1): `false`
    // keeps a direct / model-only tool registered but inactive until something names it. `none`
    // = the omitted field = `true`.
    default-active: option<bool>,
  }

  // pi `ToolNamespace` (extensions/types.ts:527 @v1.0.1): a group of related tools, such as the
  // tools of one MCP server. `name` is for example `mcp__docs`; `description` is the short summary
  // shown once with the group in model-facing listings; `instructions` is the longer usage
  // guidance that is not part of the listing.
  record tool-namespace {
    name: string,
    description: option<string>,
    instructions: option<string>,
  }

  // Pi `TerminalInputHandler`'s return, `extensions/types.ts:113` @v0.83.0:
  // `{ consume?: boolean; data?: string } | undefined`. Both members stay OPTIONAL because
  // upstream distinguishes "absent" from "false"/"empty" in neither direction by accident: the
  // fold tests `result?.consume` (truthy) and `result?.data !== undefined`, so a handler returning
  // `{data: ""}` REWRITES the buffer to empty (and the keystroke is then dropped by the
  // end-of-fold length check), while one returning `{}` leaves it alone.
  record terminal-input-result {
    consume: option<bool>,
    data: option<string>,
  }

  // Result of a capability-scoped exec (arch-08 caps/exec.rs). 1:1 with Pi's `ExecResult`
  // (exec.ts:23-28): `killed` is true when the host SIGTERMed, then (after a 5s grace period if
  // still alive) SIGKILLed, the process on a timeout/abort — Pi's exact `killProcess` escalation
  // (exec.ts:52-63) — false for a natural exit or an external signal.
  record exec-result {
    code: s32,
    stdout: string,
    stderr: string,
    killed: bool,
  }

  // Result of executing a guest-registered tool (R-08-015, Pi `AgentToolResult`,
  // `packages/agent/src/types.ts:355-369` @v0.83.0 — a DIFFERENT package from
  // `coding-agent/.../extensions/types.ts`, which only RE-EXPORTS the type at `:87`).
  //
  // EXT-036: this cited `extensions/types.ts:1043`, which is `| AgentStartEvent`, a member of the
  // `ExtensionEvent` union. Three unrelated types in this tree were all cited to that one line
  // (`AgentToolResult`, `UserBashEventResult`, `ToolResultEventResult`) — a catch-all, which is a
  // fabrication tell distinct from the uniform-offset one: staleness moves every citation by the
  // same delta, invention converges them on one plausible-looking number.
  // `content-json` is a serde_json array of (text|image) content blocks; `terminate` ends the
  // agent loop after this result.
  record tool-output {
    content-json: string,
    details-json: option<string>,
    is-error: bool,
    terminate: bool,
  }

  // A single autocomplete suggestion (Pi `AutocompleteItem`, tui/autocomplete.ts:219).
  record autocomplete-item {
    value: string,
    label: string,
    description: option<string>,
  }

  // The suggestions a provider returns (Pi `AutocompleteSuggestions`, tui/autocomplete.ts:236):
  // the matched items + the prefix they match against.
  record autocomplete-suggestions {
    items: list<autocomplete-item>,
    prefix: string,
  }
}

// ---------------------------------------------------------------------------
// host -> guest: the §5 event catalog (exports the guest may implement).
// The host only calls events the guest subscribed to (subscription gate, R-08-034).
// All 33 pi events (the `on(event: "…")` overload block, extensions/types.ts:1190-1231 @v0.83.0)
// are represented here, plus TWO closure subscriptions that have no `on(event: …)` name upstream:
// `on-terminal-input` — the `ExtensionUIContext.onTerminalInput` closure
// (`extensions/types.ts:145`) — and `on-branch-change` — the `ReadonlyFooterDataProvider`'s
// `onBranchChange(callback)` (`core/footer-data-provider.ts:139-143` @v0.87.1), EXT-064. That is
// 35 `on-*` exports against 33 pi events; the three post-baseline events (header, 0.11 -> 0.12)
// make it 38 against 36. EXT-036: this line used to claim "All 30" against a range that
// matches no upstream version, contradicting the file's own header 81 lines above — and the count
// test only ties the header's number, so the disagreement passed straight through an audit that
// quoted it.
// ---------------------------------------------------------------------------
interface events {
  use types.{hook-outcome, tool-output, terminal-input-result};

  // --- provider OAuth + custom streaming (pi `ProviderConfig`, `extensions/types.ts:1427-1464`
  // @v0.83.0; `streamSimple` `:1437`, `oauth` `:1450-1463`) ---
  // EXT-072: the `:1373-1392` this used to cite is inside `registerProvider`'s `@example` JSDoc.
  // The host invokes these on a guest that registered a provider carrying OAuth/`streamSimple`
  // callbacks. Credentials/models/model/context/options cross as serde_json strings (open-shaped,
  // arch-08 §4.1). `provider-login` runs the guest's `login(callbacks)` flow — during it the guest
  // calls the `oauth` host imports (onAuth/onPrompt/onSelect/…) — and returns the credentials to
  // persist. `provider-stream-simple` runs the guest's custom stream: it pushes assistant-message
  // stream events back via the `provider-stream` host import, then returns when the stream ends.
  provider-login:         func(id: string) -> result<string, string>;
  provider-refresh-token: func(id: string, credentials-json: string) -> result<string, string>;
  provider-get-api-key:   func(id: string, credentials-json: string) -> result<string, string>;
  provider-modify-models: func(id: string, models-json: string, credentials-json: string) -> result<string, string>;
  provider-stream-simple: func(id: string, stream-id: string, model-json: string, context-json: string, options-json: string) -> result<_, string>;

  // --- global autocomplete provider stacking (pi `addAutocompleteProvider`,
  // `extensions/types.ts:225` @v0.83.0; EXT-072: `:218` is `getEditorText`'s doc line) ---
  // The host folds the guest's stacked `AutocompleteProviderFactory` chain over its own built-in
  // suggestions: `base-json` is the built-in `autocomplete-suggestions` (the wrapped "current"),
  // `query-json` carries `{lines, cursorLine, cursorCol, force}`. The guest returns the final
  // suggestions after applying every stacked provider in registration order.
  autocomplete-suggest:   func(base-json: string, query-json: string) -> string;

  // --- withSession re-binding callback (pi `ReplacedSessionContext`, `extensions/types.ts:394-404`
  // @v0.83.0; EXT-072: the `:346-390` this cited starts on `getSystemPrompt`) ---
  // After a command-tier `control.new-session`/`switch`/`fork` carrying a `withSessionCallbackId`,
  // the host re-binds the replacement session then invokes THIS export with that id — a fresh
  // top-level call, because wasm single-instance reentrancy forbids calling it synchronously inside
  // the `control.*` import (Pi `finishSessionReplacement`, agent-session-runtime.ts:184-189). The
  // guest looks up the stored `withSession(ctx)` closure and runs it against a freshly-bound
  // command-tier `ReplacedSessionContext`.
  with-session: func(callback-id: string) -> result<_, string>;

  // --- guest tool execution (R-08-015) ---
  // The host invokes a guest-registered tool. Mirrors Pi's ToolDefinition.execute
  // (types.ts:480): `call-id` = toolCallId, `params-json` = arguments; cancellation (signal)
  // is delivered by the host epoch/cancel; streaming updates go back via host-tool.emit-update;
  // `ctx` is reconstructed guest-side from the capability imports.
  execute-tool: func(name: string, call-id: string, params-json: string) -> result<tool-output, string>;

  // --- guest tool argument preparation (EXT-023; pi `ToolDefinition.prepareArguments`,
  // extensions/types.ts:468 @v0.83.0) ---
  // Called ONLY for a tool whose descriptor sets `prepare-arguments`, and only BEFORE schema
  // validation — pi runs `prepareArguments` ahead of `validateToolArguments` in
  // `packages/agent/src/agent-loop.ts`, so the coerced value is what gets validated. `none` (or a
  // guest fault) leaves the arguments untouched, which is upstream's identity default.
  prepare-arguments: func(name: string, args-json: string) -> option<string>;

  // --- guest slash-command execution (R-08-016) ---
  // The host invokes a guest-registered command at COMMAND tier (session ops legal). `args` is the
  // raw argument string (pi `RegisteredCommand.handler(args, ctx)`, `extensions/types.ts:1167`
  // @v0.83.0; EXT-072: `:1109` is `skipConversationRestore`); the optional text
  // result is surfaced to the user. `get-argument-completions` is Pi's dynamic getArgumentCompletions
  // (`extensions/types.ts:1166` @v0.83.0; EXT-072: `:1108` is `cancel?: boolean`): given a prefix,
  // the guest returns the completion items (replacing static lists).
  execute-command:          func(name: string, args: string) -> result<option<string>, string>;
  get-argument-completions: func(name: string, prefix: string) -> list<string>;

  // --- guest keyboard-shortcut execution (R-08-017; pi `registerShortcut` handler,
  // `extensions/types.ts:1250-1256` @v0.83.0; EXT-072: the `:1199-1205` this cited is inside the
  // `on(event: …)` overload block) ---
  // The host invokes the guest's stored shortcut handler (`options.handler(ctx)`) when the registered
  // `KeyId` fires. Runs at COMMAND tier (Pi hands the shortcut handler the full `ExtensionContext`).
  execute-shortcut:         func(key: string) -> result<_, string>;

  // --- message renderer dispatch (R-08-020; Pi renderCall/renderResult, types.ts:489-497) ---
  // A guest that registered a renderer for `custom-type` renders a tool call / result into a
  // serialized widget tree (none = fall back to the runtime's default renderer).
  //
  // `custom-type` is the CUSTOM MESSAGE TYPE for a renderer registered via
  // `registration.register-message-renderer`, or the TOOL NAME for a tool whose descriptor declares
  // `has-renderer` — the host routes by that key alone (EXT-006).
  //
  // THE WIDGET VOCABULARY. Pi returns a live `pi-tui` `Component` the interactive mode adds as a
  // child (`components/custom-message.ts:66-81`, `components/tool-execution.ts:81-112`); a WASM
  // guest cannot hand back an object, so cyrup's wire analog is that component tree SERIALIZED, and
  // the host flattens it to display rows (`cyrup-tui` `rendered_text`). The tags mirror the
  // `pi-tui` components a renderer actually returns (`packages/tui/src/index.ts:13-32`):
  //
  //   "…"                                        a bare string — the degenerate `Text`
  //   {"widget":"text","text":"…"}               `Text`   — the dominant shape
  //   {"widget":"markdown","text":"…"}           `Markdown`
  //   {"widget":"truncated-text","text":"…"}     `TruncatedText`
  //   {"widget":"spacer","lines":n}              `Spacer` (n defaults to 1, clamped to 64)
  //   {"widget":"box"|"container","children":[]} `Box` / `Container` — children stacked
  //   {"widget":"hstack","children":[…]}         `HStack`  — children joined on one row
  //   […]                                        shorthand for a stack
  //
  // `cyrup_ext_sdk::widget` constructs exactly these. Anything else — an unknown tag, a missing
  // tag, a tree nested deeper than 16 — is drawn as pretty-printed JSON rather than dropped, so a
  // mistyped node is visible instead of blank.
  //
  // `opts-json` is the `(options, theme)` half of upstream's renderer signature (EXT-006). Every
  // pi renderer takes it and pi re-invokes the renderer from the DRAW path, so both halves are
  // LIVE inputs rather than ingest-time constants; cyrup's host re-invokes this export whenever
  // they move (`cyrup_tui::App::refresh_extension_renders`). The bag is the UNION of pi's three,
  // because cyrup routes all three surfaces through this one export pair:
  //
  //   {"expanded": bool,        // all three: `MessageRenderOptions.expanded` (`types.ts:1196`
  //                             // @v0.84.4), `EntryRenderOptions.expanded` (`:1210`),
  //                             // `ToolRenderResultOptions.expanded` (`:415`)
  //    "outputPad": number,     // `MessageRenderOptions.outputPad` (`:1198`) — the horizontal
  //                             // padding the outputPad setting configures
  //    "isPartial": bool,       // `ToolRenderResultOptions.isPartial` (`:417`)
  //    "theme": string|null}    // see below
  //
  // TAG-TO-TAG: at the ported baseline v0.83.0 the MESSAGE surface took `EntryRenderOptions`
  // too — `MessageRenderOptions` and its `outputPad` are a post-baseline addition, carried here
  // because ADR-0006 makes the LATEST tag the parity target.
  //
  // [CYRUP-DELTA] `theme` is the theme's NAME, not the `Theme` object pi passes: an object cannot
  // cross the component boundary. A guest that needs the PALETTE reads it with the
  // `ui.theme-get-json` import, which was added for exactly this and returns the ACTIVE theme
  // (EXT-066). The name is what changes when the user switches themes, so it is the value a
  // renderer's staleness is decided by. `null` = the caller has no display (an RPC host, a test).
  // A NATIVE renderer is under no such constraint and gets the real thing
  // (`cyrup_ext::RenderCtx.theme`, a `&dyn RenderTheme`).
  render-call:   func(custom-type: string, call-json: string, opts-json: string) -> option<string>;
  render-result: func(custom-type: string, result-json: string, opts-json: string) -> option<string>;

  // --- markdown transformation (EXT-019; pi `MarkdownTransformer`,
  // `extensions/types.ts:1147-1153` @v0.84.1 — a POST-BASELINE addition, absent at v0.83.0) ---
  // Upstream: `type MarkdownTransformer = (markdown: string, context: MarkdownTransformContext) =>
  // string` (`:1153`), registered by `registerMarkdownTransformer` (`:1292`, impl
  // `loader.ts:309-312`), stored as the AT-MOST-ONE `markdownTransformer?` per extension
  // (`:1703`), and collected in extension LOAD ORDER by
  // `ExtensionRunner.getMarkdownTransformers()` (`runner.ts:589-591`). The host folds them: each
  // transformer's output is the next one's input.
  //
  // `ctx-json` is `MarkdownTransformContext` (`:1147-1151`):
  //   {"messageType": "user"|"assistant"|"assistant-thinking", "isStreaming": bool,
  //    "availableWidth": number}
  //
  // Called only on a guest that declared `registration.register-markdown-transformer`. A guest
  // fault leaves the markdown untouched (the identity default), never dropping the transcript text.
  transform-markdown: func(markdown: string, ctx-json: string) -> string;

  // --- guest-supplied bash backend (DRIFT-004; pi `BashOperations.exec`,
  // `core/tools/bash.ts:71-80` @v0.84.4:
  //   `exec: (command, cwd, {onData, signal, timeout, env}) => Promise<{exitCode: number|null}>`)
  //
  // Called only on a guest that declared `registration.register-bash-operations`, and only for the
  // ONE `user_bash` command whose handler won the reduction without supplying a `result`
  // (`modes/rpc/rpc-mode.ts:581` `operations: eventResult?.operations`;
  // `modes/interactive/interactive-mode.ts:6524`). Keyed by `call-id` exactly like `execute-tool`,
  // because upstream's two closure-shaped options are per-CALL and cyrup cannot pass a closure:
  //   * `onData(data: Buffer)`  -> the `host-bash.emit-bash-output(call-id, chunk)` import;
  //   * `signal: AbortSignal`   -> the `host-bash.is-bash-cancelled(call-id)` poll.
  // `opts-json` carries the two VALUE options plus cyrup's `env-remove` split:
  //   {"timeoutMs": number|null, "env": {k: v}, "envRemove": [k]}
  // — `env` is ADDITIVE over the inherited shell environment and `envRemove` names keys to unset,
  // the same shape `cyrup_tools::ops::BashExecOptions` documents (pi materializes the whole
  // environment and expresses a deletion by omission; cyrup inherits and must therefore name it).
  //
  // The return is pi's `{exitCode: number | null}`: `ok(some(code))` is an exit code, `ok(none)` is
  // pi's `null` ("killed" — the host decides whether that was its own cancel, its own timeout, or
  // an external signal, exactly as `executeBashWithOperations` re-derives it from its own state),
  // and `err(msg)` is pi's `throw`, which upstream re-raises past the abort check
  // (`bash-executor.ts:154`) rather than reporting as a successful command.
  bash-operations-exec: func(call-id: string, command: string, cwd: string, opts-json: string) -> result<option<s32>, string>;

  // The guest half of pi's `VirtualModelDefinition.route(request)` /
  // `ExtensionVirtualModel.route(request, ctx)` (`core/virtual-models.ts:101`,
  // `core/extensions/types.ts:1888` @v1.0.4), reached because this guest declared
  // `registration.register-virtual-model` for `(provider, id)`. Called ONCE PER PROVIDER REQUEST
  // whose selected model is that virtual one — pi creates the ctx per request for exactly this
  // reason (`core/extensions/loader.ts:500-513`).
  //
  // `request-json` is pi's `ModelRouteRequest` in camelCase (`core/virtual-models.ts:52-70`):
  // `{model, thinkingLevel, reason, previous?, failed?, state?, messages}`, where `model` is the
  // full VIRTUAL model, `reason` is one of `user`/`continuation`/`retry`/`direct`, and `messages`
  // is the whole conversation for this request INCLUDING system messages. `ok` is pi's `ModelRoute`
  // (`:72-82`): `{model, thinkingLevel, state?}`, whose `model` names the PHYSICAL model to use —
  // the host re-resolves `provider`/`id` against the catalog, so the guest's object is an ADDRESS
  // rather than a definition. `err` is pi's `route()` THROWING, and upstream's contract for it is
  // one sentence: "If `route()` throws, or returns a virtual model or a model without credentials,
  // the request ends with an error response" (`docs/virtual-models.md`).
  //
  // Deliberately NOT named `on-*`: this is a keyed CALL like `bash-operations-exec`, not a §5 event
  // hook, and the header's `on-*` count above is tested against the declarations in this block.
  //
  // pi's `ModelRouteRequest.signal?: AbortSignal` is NOT in the JSON — it is the
  // `host-router.is-route-cancelled(route-id)` poll, keyed by the `route-id` the host passes here,
  // exactly as `host-bash.is-bash-cancelled` ports `BashOperations.exec`'s `signal`.
  route-model: func(provider: string, id: string, route-id: string, request-json: string) -> result<string, string>;

  // --- raw terminal input (EXT-021's residual; pi `ExtensionUIContext.onTerminalInput(handler)`,
  // `extensions/types.ts:145` @v0.83.0, handler type `TerminalInputHandler` at `:113`:
  // `(data: string) => { consume?: boolean; data?: string } | undefined`) ---
  //
  // Called only on a guest that declared `ui.subscribe-terminal-input`, in LOAD order — pi keeps
  // its listeners in an insertion-ordered `Set` and folds them in `TUI.handleInput`
  // (`packages/tui/src/tui.ts:773-788`): each listener sees the CURRENT (possibly already
  // rewritten) data, a `consume: true` stops the fold and drops the keystroke, and a returned
  // `data` replaces the buffer for the listeners after it. A fold that ends with an EMPTY string
  // also drops the keystroke (`:784-786`).
  //
  // `none` is upstream's `undefined` return — "I looked at it and did nothing" — and is what a
  // faulting or panicking guest is treated as, so a broken extension can never swallow the user's
  // keyboard.
  on-terminal-input: func(data: string) -> option<terminal-input-result>;

  // EXT-064 — pi `ReadonlyFooterDataProvider.onBranchChange(callback: () => void): () => void`
  // ("Subscribe to git branch changes. Returns unsubscribe function.",
  // `core/footer-data-provider.ts:139-143` @v0.87.1). This is the FOURTH member of the provider
  // upstream hands the `setFooter` factory, and the one the `ui.footer-data` import cannot carry,
  // because it is a PUSH rather than a read: upstream's custom footer COMPONENT is re-rendered by
  // the draw path and re-reads `getGitBranch()` every frame, so a branch change repaints it with
  // no extension code involved (`interactive-mode.ts:1046` re-requests the render). A cyrup guest
  // hands over rendered text once, so without a push its footer would freeze at whatever branch
  // was current when it called `set-footer` — a behavioural difference, not a mechanism one.
  //
  // Called only on a guest that declared `ui.subscribe-branch-change`, and — like upstream's
  // `notifyBranchChange` (`:197-199`) — ONLY when the branch actually changed, never on an
  // unchanged poll. `branch` is upstream's `getGitBranch()` tri-state verbatim: a branch name, the
  // literal `"detached"`, or `none` outside a repo (`:126-132`).
  on-branch-change: func(branch: option<string>);

  // --- 5.4 tools — the mutating seams ---
  // tool_call [block/mutate] (subscribed at types.ts:1228 @v0.83.0), tool_result [mutate] (:1229).
  // EXT-073: the `:1145`/`:1146` these carried lie outside the overload block at every version.
  // tool_result carries the FULL pi `ToolResultEventBase` shape (types.ts:914-922 @v0.83.0; EXT-072:
  // `:883-929` spans the whole per-tool result-event family): the executed
  // tool `input` (the arguments), the per-tool `details` blob (`BashToolDetails | …`) AND the
  // optional `usage` the tool execution itself reported (types.ts:920-921 @v0.83.0, upstream
  // `2fd38684`; EXT-072: `:919` is the sibling `isError`) —
  // not just content+isError. A `tool_result` handler inspects and patches all of them; the patch
  // direction rides the `hook-outcome` mutate JSON, whose `usage` key is read back host-side.
  //
  // `structured-content-json` (pi `ToolResultEventBase.structuredContent?: JsonValue`,
  // `extensions/types.ts:1238` @v1.0.1) is the tool's machine-readable result, `none` when it
  // returned none. The mutate JSON's `structuredContent` key replaces it
  // (`ToolResultEventResult.structuredContent`, `:1445`), and a patch that replaces `content`
  // WITHOUT one drops it, "because it may no longer match" (`:1436-1441`; `runner.ts:1194-1198`).
  //
  // `parent-tool-call-id` (pi `parentToolCallId?: string`, `extensions/types.ts:1061-1083` @v1.0.1,
  // on `tool_call`, `tool_result` and the three `tool_execution_*` events below): the id of the
  // tool call that made THIS call, when a tool is calling a tool (`ctx.executeTool`) — itself
  // `<id>/<n>` when that tool was a nested call. `none` for every call the model issued, so a
  // handler that must tell the two apart reads this and one that gates on `tool_call` needs no
  // change to cover nested calls.
  //
  // [CYRUP-DELTA] The ONE instance that does not receive the events of a nested call is the one
  // whose own tool is making it. pi runs every subscribed handler, that extension's included,
  // because it is one JS process; here the calling tool is suspended inside `host-tool.execute-tool`
  // in its own single-instance `Store`, and the lock that would deliver the event is the one it
  // holds. Every other extension receives them, with `parent-tool-call-id` set.
  on-tool-call:    func(call-id: string, name: string, input-json: string, parent-tool-call-id: option<string>) -> hook-outcome;
  on-tool-result:  func(call-id: string, name: string, input-json: string, content-json: string, is-error: bool, details-json: option<string>, usage-json: option<string>, parent-tool-call-id: option<string>, structured-content-json: option<string>) -> hook-outcome;

  // --- 5.3 agent & turn ---
  // context [mutate] (subscribed at types.ts:1207 @v0.83.0), message_end [mutate] (:1222),
  // before_agent_start [mutate] (:1214). EXT-073: `:1143`/`:1144`/`:1135` were the fabricated band.
  on-context:            func(messages-json: string) -> hook-outcome;
  // context_with_system [mutate] (pi `ContextWithSystemEvent`, `core/extensions/types.ts:708-711`
  // @v0.87.1, `on(event: "context_with_system")` at `:1382`; EXT-079): runs after EVERY `context`
  // handler, on the transcript as the `context` chain left it, and its result is sent as returned.
  // Upstream that transcript carries the system messages (the prompt and the tool declarations) and
  // the handler owns them; cyrup's transcript has no system messages yet (AGENT-039), so today the
  // payload is the same message list a `context` handler sees.
  on-context-with-system: func(messages-json: string) -> hook-outcome;
  on-message-end:        func(message-json: string) -> hook-outcome;
  on-before-agent-start: func(prompt: string, images-json: string, system-prompt: string, options-json: string) -> hook-outcome;

  // input [block/mutate/handled] (subscribed at types.ts:1231 @v0.83.0), user_bash
  // [block/mutate/handled] (:1230). EXT-073: `:1158`/`:1159` land on the Command Registration banner.
  // `input` carries the full pi `InputEvent` (types.ts:831-841 @v0.83.0): the submission `text`, the attached
  // `images`, the `source` ("interactive"|"rpc"|"extension"), and the in-flight `streaming-behavior`
  // ("steer"|"followUp"; none when the agent is idle).
  // `user_bash` carries the pi `UserBashEvent` (types.ts:813-821 @v0.83.0): the `command`, the
  // `exclude-from-context` flag (true for the `!!` prefix), and the `cwd`. The `operations`/`result`
  // override is returned via the `handled` outcome (Pi `UserBashEventResult`, `extensions/types.ts:1078-1083` @v0.83.0; EXT-036 corrected `:1043-1048`),
  // NOT passed in.
  on-input:        func(text: string, images-json: string, source: string, streaming-behavior: option<string>) -> hook-outcome;
  on-user-bash:    func(command: string, exclude-from-context: bool, cwd: string) -> hook-outcome;

  // --- 5.6 provider ---
  // before_provider_request [mutate] (subscribed at types.ts:1209 @v0.83.0),
  // after_provider_response [notify] (:1213). EXT-073: `:1160`/`:1161` were the fabricated band.
  on-before-provider-request: func(payload-json: string) -> hook-outcome;
  // before_provider_headers [mutate] (pi `BeforeProviderHeadersEvent`, extensions/types.ts:686-689
  // @v0.83.0, subscribed at :1212, reduced by `emitBeforeProviderHeaders` at runner.ts:1045).
  // `headers-json` is the assembled `ProviderHeaders` bag. The doc at types.ts:681-685 is exact:
  // "Handlers mutate `headers` in place (e.g. to inject tracing/session headers); the return value
  // is ignored. A `null` value deletes that header." So the mutate payload is an OBJECT whose
  // values are `string | null`, and a `null` DELETES that header rather than setting it empty
  // (EXT-009).
  on-before-provider-headers: func(headers-json: string) -> hook-outcome;
  on-after-provider-response: func(status: u32, headers-json: string);

  // model_select [notify] (types.ts:1226), thinking_level_select [notify] (types.ts:1227).
  // pi `ModelSelectEvent {type, model, previousModel, source}` (extensions/types.ts:794-799
  // @v0.83.0) and `ThinkingLevelSelectEvent {type, level, previousLevel}` (:802-806) — three and
  // three SIBLING fields. cyrup used to nest `previousModel`/`source` INSIDE `model` (so `model`
  // was not a `Model` shape either) and drop `previousLevel` outright (EXT-042).
  on-model-select:          func(model-json: string, previous-model-json: option<string>, source: string);
  on-thinking-level-select: func(level: string, previous-level: option<string>);

  // --- notify-only (return ignored); high-frequency ones are subscription-gated ---
  on-agent-start:           func();
  on-agent-end:             func(messages-json: string);
  // agent_settled (pi `AgentSettledEvent`, extensions/types.ts:721-725 @v0.83.0, subscribed at
  // `:1217`; EXT-073: the `:1225` this carried is `tool_execution_end`'s overload — the same
  // wrong-surface value EXT-036 fixed in `host/services.rs` and left standing here):
  // the run has FULLY settled — no automatic retry, post-run compaction or queued continuation will
  // follow. Distinct from on-agent-end, which fires once per agent.prompt/agent.continue: a run that
  // auto-retries delivers TWO on-agent-end calls and exactly ONE on-agent-settled. Pi emits it from
  // the `finally` of _runAgentPrompt (agent-session.ts:1063-1072), to the extension runner FIRST and
  // the session subscribers second.
  on-agent-settled:         func();
  on-turn-start:            func(turn-index: u32, timestamp: u64);
  // turn_end (pi `TurnEndEvent`, types.ts:735-740 @v0.83.0): the turn index, the finalized assistant `message`,
  // AND the `tool-results` produced this turn (`ToolResultMessage[]`).
  on-turn-end:              func(turn-index: u32, message-json: string, tool-results-json: string);
  // message_start (pi `MessageStartEvent`, types.ts:743-746 @v0.83.0): the full `message` (user|assistant|
  // toolResult), not just its role.
  on-message-start:         func(message-json: string);
  // message_update (pi `MessageUpdateEvent`, types.ts:749-753 @v0.83.0): the full in-flight `message` AND the
  // `assistant-message-event` delta (carried here as `delta-json`). HIGH-FREQ, gated.
  on-message-update:        func(message-json: string, delta-json: string);   // HIGH-FREQ, gated
  // EXT-069: these three used to be spelled `on-tool-exec-{start,update,end}` — the ONLY three
  // exports in the 33-event mapping whose name was not a mechanical kebab-case of pi's event name
  // (`tool_execution_start` / `_update` / `_end`, `extensions/types.ts:1223`, `:1224`, `:1225`
  // @v0.83.0), so a name-based cross-check of the catalog reported three false gaps and needed a
  // three-entry exception list. Do not re-abbreviate them: every such exception is a place a real
  // gap can hide. The rename re-signed the world (0.7 -> 0.8).
  on-tool-execution-start:  func(call-id: string, name: string, args-json: string, parent-tool-call-id: option<string>);
  // tool_execution_update (pi `ToolExecutionUpdateEvent`, extensions/types.ts:770-776 @v0.83.0):
  // `{type, toolCallId, toolName, args, partialResult}` — FIVE fields; cyrup used to drop `toolName`
  // AND `args`, forcing every observer to keep its own callId->name map (EXT-014).
  on-tool-execution-update: func(call-id: string, name: string, args-json: string, chunk-json: string, parent-tool-call-id: option<string>); // HIGH-FREQ, gated
  // tool_execution_end (pi `ToolExecutionEndEvent`, extensions/types.ts:779-785 @v0.83.0):
  // `{type, toolCallId, toolName, result, isError}`.
  on-tool-execution-end:    func(call-id: string, name: string, result-json: string, is-error: bool, parent-tool-call-id: option<string>);

  // --- 5.1/5.2 startup & session lifecycle ---
  // session_start (pi `SessionStartEvent`, extensions/types.ts:562-569 @v0.83.0): the `reason`
  // ("startup"|"reload"|"new"|"resume"|"fork") AND `previousSessionFile?`, documented "Present for
  // \"new\", \"resume\", and \"fork\"" — the field that tells a fresh session from a resume
  // (EXT-015).
  on-session-start:         func(reason: string, previous-session-file: option<string>);
  // session_shutdown (pi `SessionShutdownEvent`, extensions/types.ts:616-621 @v0.83.0): `reason`
  // plus `targetSessionFile?`, "Destination session file when shutting down due to session
  // replacement" (EXT-015).
  on-session-shutdown:      func(reason: string, target-session-file: option<string>);
  // session_info_changed (pi `SessionInfoChangedEvent`, extensions/types.ts:571-575 @v0.83.0,
  // subscribed at `:1193`; EXT-073: `:1203` is `session_compact`): "Current normalized session
  // name. Undefined when the name is cleared" —
  // hence `option<string>`, where `none` is upstream's `undefined` (EXT-011).
  on-session-info-changed:  func(name: option<string>);
  // ui_prompt_start / ui_prompt_end (pi `UIPromptStartEvent` / `UIPromptEndEvent`,
  // `core/extensions/types.ts:830-845` @v0.87.1, `on(event: "ui_prompt_start")` / `"ui_prompt_end"`
  // at `:1404-1405`; EXT-075): an extension's blocking UI prompt opened / closed. `kind` is pi's
  // `UIPromptKind` ("select"|"confirm"|"input"|"editor"|"custom"); `title` is absent for `custom`
  // and for an empty title, as upstream's `...(title ? { title } : {})`. pi's constant
  // `reason: "ui_prompt"` does not cross.
  on-ui-prompt-start:       func(kind: string, title: option<string>);
  on-ui-prompt-end:         func(kind: string, title: option<string>);
  // resources_discover (pi `ResourcesDiscoverEvent`, extensions/types.ts:544-548 @v0.83.0):
  // `{type, cwd, reason: "startup" | "reload"}` (EXT-016).
  on-resources-discover:    func(cwd: string, reason: string) -> hook-outcome;   // provide skill/prompt/theme paths
  // project_trust (pi `ProjectTrustEvent`, extensions/types.ts:519-522 @v0.83.0): `{type, cwd}`.
  // The whole decision is per-DIRECTORY upstream — the store is keyed by it
  // (`options.trustStore.set(options.cwd, trusted)`, core/project-trust.ts:63-65) — so a handler
  // that cannot see the cwd cannot key an allowlist or honour `remember` (EXT-043).
  on-project-trust:         func(cwd: string) -> hook-outcome;    // decide {trusted, remember}
  // cache_warming_decision (pi `CacheWarmingDecisionEvent`, `core/cache-warmer.ts:112-115`
  // @v1.0.4): fired before each prompt-cache refresh with the host's own warm-or-stop verdict
  // filled in. `decision-json` is upstream's `Pick` of EXACTLY four fields —
  // `{warmCost, missCost, continuationProbability, action}`, camelCase. `phase`,
  // `expectedSavings` and `economicsAvailable` are withheld on purpose: upstream's comment is
  // "Everything else an extension might want (model, idle state, context size) is on the
  // context." The answer is `hook-outcome::handled({"action": "warm" | "stop"})` (pi
  // `CacheWarmingDecisionEventResult`, `:117-120`); `noop` means no opinion. Across extensions
  // the LAST readable action wins, which is NOT `on-project-trust`'s first-decides rule —
  // `emitCacheWarmingDecision` assigns inside its loop and never returns early
  // (`runner.ts:1131`). A handler that faults, traps or overruns the invocation budget is skipped
  // and the host's own action stands (pi's `emitError`-and-continue, `:1134-1141`); the budget is
  // what stops a hanging handler from sitting on a refresh that has a deadline. EXT-085.
  on-cache-warming-decision: func(decision-json: string) -> hook-outcome;  // override {action}

  // session control hooks (pi's overload block, extensions/types.ts:1190-1231 @v0.83.0):
  // before_* are block/mutate, the rest notify.
  // session_before_switch (pi `SessionBeforeSwitchEvent`, extensions/types.ts:578-582 @v0.83.0):
  // `reason: "new" | "resume"` AND `targetSessionFile?`. `reason` is the field that distinguishes
  // the two cases a handler most needs to tell apart, and cyrup dropped it entirely (EXT-015).
  on-session-before-switch:  func(reason: string, target-session-file: option<string>) -> hook-outcome;
  // session_before_fork (pi `SessionBeforeForkEvent`, extensions/types.ts:585-589 @v0.83.0):
  // `entryId` AND `position: "before" | "at"` — a fork BEFORE an entry and a fork AT it are
  // different operations (EXT-015).
  on-session-before-fork:    func(entry-id: string, position: string) -> hook-outcome;
  // session_before_compact (pi `SessionBeforeCompactEvent`, extensions/types.ts:592-602 @v0.83.0 —
  // the value the CYRUP-DELTA below already cites; EXT-072: `:577-587` is `SessionBeforeSwitchEvent`):
  // the computed
  // `preparation` (`CompactionPreparation`, `core/compaction/compaction.ts:692` @v0.83.0; EXT-072:
  // `:634` was both the wrong line and an unqualified path) + the `branch-entries` in scope + optional
  // `custom-instructions` + the trigger `reason` ("manual"|"threshold"|"overflow") + `will-retry`. A
  // handler may VETO via `block` or return a compaction override via `mutate` (Pi
  // SessionBeforeCompactResult.compaction = a CompactionResult) — the override's summary/details land
  // in the appended compaction entry (fromExtension). All payloads cross as serde_json strings.
  //
  // [CYRUP-DELTA] EXT-067: pi's `SessionBeforeCompactEvent` (`extensions/types.ts:592-602` @v0.83.0)
  // carries a SIXTH member this signature has no parameter for — `signal: AbortSignal;` at `:601`.
  // It is NOT dropped: it is the same `AbortSignal`-as-a-poll port already written up at
  // `ctx-state.is-run-cancelled` below, and a handler doing real work here (summarizing, calling a
  // model) is expected to poll that between units of work. Stated here because both this comment and
  // `on-session-before-tree`'s enumerate the OTHER payload fields exhaustively, which made the
  // absence read as an oversight rather than the decision it is.
  on-session-before-compact: func(preparation-json: string, branch-entries-json: string, custom-instructions: option<string>, reason: string, will-retry: bool) -> hook-outcome;
  // session_compact (pi `SessionCompactEvent`, extensions/types.ts:605-613 @v0.83.0): the produced
  // `compaction-entry` (its
  // `summary` field carries the summary text), whether an extension drove it (`from-extension`), the
  // trigger `reason`, and `will-retry`.
  on-session-compact:        func(compaction-entry-json: string, from-extension: bool, reason: string, will-retry: bool);
  // session_before_tree (pi `SessionBeforeTreeEvent`, extensions/types.ts:639-643 @v0.83.0 — the
  // value the CYRUP-DELTA below already cites; EXT-072: `:623-628` lands on `TreePreparation`, a
  // different type): the computed `preparation`
  // (`TreePreparation`, `extensions/types.ts:624-636` @v0.83.0 — NOT `compaction.ts`, which is
  // where its compaction-side sibling lives) — targetId/oldLeafId/commonAncestorId/entriesToSummarize/
  // userWantsSummary/customInstructions?/label?. A handler may VETO via `block` or return a
  // summary/customInstructions/label override via `mutate` (Pi SessionBeforeTreeResult).
  //
  // [CYRUP-DELTA] EXT-067: pi's `SessionBeforeTreeEvent` (`extensions/types.ts:639-643` @v0.83.0)
  // also carries `signal: AbortSignal;` at `:642`, ported as the `ctx-state.is-run-cancelled` poll —
  // see the identical note on `on-session-before-compact` above.
  on-session-before-tree:    func(preparation-json: string) -> hook-outcome;
  // session_tree (pi `SessionTreeEvent`, `extensions/types.ts:646-652` @v0.83.0). EXT-068: this was
  // the ONE event export with no comment and no citation, and its parameter name said `tree-json`,
  // which reads as a tree DUMP. It is not — upstream's event is a LEAF TRANSITION with four fields,
  // and all four ride inside this blob: `newLeafId: string | null`, `oldLeafId: string | null`,
  // `summaryEntry?: BranchSummaryEntry`, `fromExtension?: boolean`, serialized by
  // `cyrup-session-svc/src/session.rs` at the `agent-session.ts:2877` notify site with exactly those
  // camelCase keys. `fromExtension` is the re-entrancy guard: without it a tree-watching guest cannot
  // tell a navigation it caused from one the user made. The parameter was renamed `tree-json` ->
  // `event-json` to stop the blob being read as a dump; that re-signed the world (0.7 -> 0.8).
  on-session-tree:           func(event-json: string);

  // --- inter-extension event bus delivery (Pi `pi.events.on` listener, event-bus.ts:18-27) ---
  // The host invokes this on a guest that declared a `bus.subscribe(topic)` when ANY loaded guest
  // (this one included) `bus.emit`s that topic. `payload-json` is the emitted payload. Notify-style
  // (return ignored) — the receiving half of the bus that closes gap-08 §5.3.
  bus-deliver:               func(topic: string, payload-json: string);
}

// ---------------------------------------------------------------------------
// guest -> host: registration imports (arch-08 §3.5).
// ---------------------------------------------------------------------------
interface registration {
  use types.{tool-descriptor};
  // EXT-082 — pi's `registerTool` / `registerFlag` throw on an invalid registration
  // (`core/extensions/loader.ts:274-279`, `:312-316` @v0.87.1): a non-object `parameters`, or a
  // flag `default` whose `typeof` is not its `type`. The `err` arm carries pi's message verbatim;
  // nothing is registered, and that is the whole effect: a guest that propagates it fails its own
  // call (an `init` returning it fails the load), and one that handles it carries on, as a pi
  // `try`/`catch` around the throw does.
  register-tool:             func(t: tool-descriptor) -> result<_, string>;
  register-command:          func(name: string, desc-json: string);
  register-shortcut:         func(key: string, desc: string);
  register-flag:             func(name: string, spec-json: string) -> result<_, string>;
  get-flag:                  func(name: string) -> option<string>;
  register-provider:         func(id: string, config-json: string);
  unregister-provider:       func(id: string);
  register-message-renderer: func(custom-type: string);
  // Pi `registerMarkdownTransformer(transformer)` (`extensions/types.ts:1292` @v0.84.1, impl
  // `loader.ts:309-312`). Argument-less because the transformer itself is a guest closure the host
  // reaches through the `transform-markdown` EXPORT — this import only declares that this guest HAS
  // one. Upstream stores it as `extension.markdownTransformer = transformer`, i.e. AT MOST ONE per
  // extension with the last registration winning; the host models that the same way (EXT-019).
  register-markdown-transformer: func();
  // DRIFT-004 — pi `UserBashEventResult.operations` (`core/extensions/types.ts:1136-1142`
  // @v0.84.4; the `BashOperations` interface at `core/tools/bash.ts:63-81`: *"Pluggable operations
  // for the bash tool. Override these to delegate command execution to remote systems (for example
  // SSH)"*). Argument-less for exactly the reason `register-markdown-transformer` above is: the
  // backend itself is a guest closure the host reaches through the `bash-operations-exec` EXPORT,
  // and upstream reads at most ONE per extension — the `operations` of the single
  // `UserBashEventResult` whose handler won the reduction (`extensions/runner.ts:1005-1032`
  // returns the FIRST truthy handler's whole result and stops). This import only declares that
  // this guest HAS one; the last registration wins, as an assignment does upstream.
  register-bash-operations: func();
  // pi `pi.registerVirtualModel(model)` / `pi.unregisterVirtualModel(provider, id)`
  // (`core/extensions/types.ts:1865-1876` @v1.0.4). The registered type is
  // `ExtensionVirtualModel<TState> = Omit<VirtualModelDefinition, "route"> & { route(request, ctx) }`
  // (`:1886-1889`), over the base definition at `core/virtual-models.ts:84-102`.
  //
  // `spec-json` is that `Omit<…, "route">` half in camelCase — `{provider, id, name,
  // thinkingLevels?, contextWindow?, maxTokens?, input?}`. The `route` CALLBACK is not in it and
  // cannot be: ADR-0002 forbids a guest handing a callable across the boundary, so this import
  // declares the SPEC only and the router stays guest-side behind the `events.route-model` export
  // the host calls once per provider request — the same inversion `register-bash-operations` +
  // `bash-operations-exec` and `register-markdown-transformer` + `transform-markdown` already make.
  // Keyed by `(provider, id)` rather than one-per-extension, because upstream lets one provider
  // list several virtual models beside its physical ones.
  //
  // `result<_, string>` follows EXT-082's precedent on `register-tool`/`register-flag` above: pi's
  // `registerVirtualModel` THROWS for an empty provider or id and for an id that already names a
  // PHYSICAL model of that provider (`core/model-runtime.ts:955-961` @v1.0.4), so an SDK guest
  // hands that to the author as a Rust `Result` to `?` out of `init`.
  //
  // `unregister-virtual-model` returns nothing, matching the void `unregisterVirtualModel` and the
  // `unregister-provider` beside it. It removes ONLY that pair, and `unregister-provider` does NOT
  // imply it — `docs/virtual-models.md` is explicit: "`pi.unregisterVirtualModel(provider, id)`
  // removes it; `pi.unregisterProvider()` does not."
  register-virtual-model:   func(spec-json: string) -> result<_, string>;
  unregister-virtual-model: func(provider: string, id: string);
  // Pi `registerEntryRenderer(customType, renderer)` (`extensions/types.ts:1279` @v0.83.0, the
  // ported baseline — `:1295` @v0.84.1 / `loader.ts:314-318`) — the
  // custom-ENTRY surface, a SEPARATE table from register-message-renderer above (upstream keeps
  // `messageRenderers` and `entryRenderers` as disjoint maps, `types.ts:1677-1678` @v0.83.0 /
  // `:1702` and `:1704` @v0.84.1).
  //
  // EXT-036, VERSION-LAG class: this comment carried the v0.84.1 numbers (`:1295`, `:1703-1704`)
  // with NO version tag, in a file whose stated baseline is v0.83.0. At v0.83.0 `:1295` is
  // `sendUserMessage` and `:1703` does not exist (the file is 1701 lines); at v0.84.1 `:1703` is
  // `markdownTransformer`, i.e. neither of the two maps the sentence is about. An unversioned
  // citation that resolves to a different symbol at the ported tag reads as a fabrication to the
  // next auditor and cost this pass a round-trip to disprove — cite the tag you opened. An entry is
  // TUI-only durable state appended by `append-entry`; a message participates in LLM context. They
  // differ in what a FAULTING renderer draws: a message falls through to the default box
  // (custom-message.ts:82-84), an entry draws `[type] renderer failed: …` (custom-entry.ts:47-52).
  //
  // There is deliberately NO `render-entry` export: an entry is rendered over `render-call` above,
  // keyed by its custom-type, and the two surfaces are told apart by the HOST's registry table.
  // A fourth export would invalidate every already-built guest component for no behavioural gain.
  register-entry-renderer:   func(custom-type: string);
  // [CYRUP-DELTA] EXT-062: pi has no `addAutocomplete` CALL. The upstream thing this declares is a
  // FIELD on the command's own options bag — `getArgumentCompletions?: (argumentPrefix: string) =>
  // AutocompleteItem[] | null | Promise<…>` on `RegisteredCommand`
  // (`extensions/types.ts:1166` @v0.83.0) — which a guest passes inline to `registerCommand`. A WIT
  // record cannot carry a closure, so the closure inverts into (a) this flag, declaring that the
  // named command HAS argument completions, and (b) the `argument-completions` export the host calls
  // to obtain them. Same inversion, same reason, as `tool-descriptor.prepare-arguments` and
  // `.has-renderer` above (R-08-021 / EXT-035 is the internal id, not a pi citation).
  add-autocomplete:          func(command: string);
  // declares the subscription bitset: which §5 event kinds this guest handles.
  subscribe:                 func(event-kinds: list<u8>);
  // EXT-080 — the remover pi's `on(event, handler)` has returned since v0.86.0
  // (`core/extensions/loader.ts:256-271` @v0.87.1): clears these kinds from this guest's bitset.
  // Like upstream, a removal made DURING a dispatch applies to later dispatches — the dispatcher
  // snapshots its subscribers before calling any of them. Idempotent.
  unsubscribe:               func(event-kinds: list<u8>);
}

// ---------------------------------------------------------------------------
// guest -> host: capabilities (arch-08 §3.6, caps/*).
//
// TWO gates stand in front of every interface in this block, and both are HOST-side (EXT-054).
// (1) The load-time trust check `is_trusted = origin.is_pre_trust() || project_trusted`
//     (`loader.rs`) decides whether the extension loads at all and which `HostServices` backend it
//     is handed — an untrusted one gets `DenyServices`.
// (2) The extension's OWN `extension.json` grant, `capabilities.{fs,exec,net,ui}`
//     (`manifest.rs`), narrows what it may ask for even on a fully capable backend: `ui` gates
//     `interface ui`, `exec` gates `exec` AND `proc` (process execution by another name), `net`
//     gates `http-client`, and `fs` supplies the roots `ext-fs` resolves against — no grant, no
//     root, no access. Every bit defaults to the DENYING value, so an absent `capabilities` block
//     grants nothing. The grant crosses as data and the guest has no import that reads or changes
//     it (ADR-0002).
// ---------------------------------------------------------------------------
interface ui {
  // EXT-036 (the import-surface re-run, completed here): every `types.ts` citation in this
  // interface was re-derived line by line against `v0.83.0`. A cluster of them was stale by a
  // uniform ~7 lines — the same offset, and therefore the same cause, as the cluster the register
  // in `cyrup-ext-sdk/src/ctx.rs` fixed on the SDK side: taken against a pi revision this region is
  // seven lines shorter in, not invented. Corrected below, with the old value named so nobody
  // "restores" it: notify `:135`->`:142`, set-status `:141`->`:148`, the dialog-options
  // `AbortSignal` `:89-94`->`:95-101`, editor `:216`->`:222`, the chrome trio
  // `:130-150`->`:183`/`:190`/`:193`. Two MORE were found here that the SDK-side register did not
  // list, of the same class: `custom` `:175`->`:196` (`:175` is the closing paren of the
  // `setWidget` component-factory overload), and the editor-buffer trio's `:200-230` range, which
  // named a function pi does not have — see that comment.
  //
  // notification severity (Pi `notify(message, type?: "info" | "warning" | "error")`,
  // `types.ts:142` @v0.83.0); info is Pi's default when the argument is omitted.
  enum notify-kind { info, warning, error }
  notify:     func(message: string, kind: notify-kind);
  // Pi `setStatus(key, text: string | undefined)` (`types.ts:148` @v0.83.0) — "Set status text in
  // the footer/status bar. Pass undefined to clear." A none `text` clears that key.
  set-status: func(key: string, text: option<string>);
  // programmatically dismiss any dialog bound to `signal-id` (Pi `ExtensionUIDialogOptions.signal`
  // AbortSignal, `types.ts:95-101` @v0.83.0 — the whole `{signal?, timeout?}` block; `signal?` is
  // `:98`): a dialog subsequently opened carrying that signal id returns
  // cancelled (`confirm` -> false, `input`/`select` -> none).
  abort-signal: func(signal-id: string);
  // Pi `onTerminalInput(handler: TerminalInputHandler): () => void` (`extensions/types.ts:145`
  // @v0.83.0) — "Listen to raw terminal input (interactive mode only). Returns an unsubscribe
  // function." Argument-less for the same reason `register-markdown-transformer` is: the handler
  // is a guest closure the host reaches through the `on-terminal-input` EXPORT, so this import
  // only declares that this guest HAS one. The returned unsubscribe function is
  // `unsubscribe-terminal-input`, which is idempotent — upstream's is a `Set.delete`.
  //
  // EXT-021: this pair is what the crate-level CYRUP-DELTA register named as the ONE member of
  // `interface ui` that was an open GAP rather than a delta ("It is expressible … unported only
  // because an export addition forces a HOST_WORLD bump"). That bump is 0.6 -> 0.7.
  subscribe-terminal-input:   func();
  unsubscribe-terminal-input: func();
  // EXT-064 — the subscription half of `ReadonlyFooterDataProvider.onBranchChange(callback)`
  // (`core/footer-data-provider.ts:139-143` @v0.87.1). Argument-less for the same reason the
  // terminal-input pair above is: the callback is a guest closure the host reaches through the
  // `on-branch-change` EXPORT, so this import only declares that this guest HAS one. Upstream's
  // `onBranchChange` RETURNS the unsubscribe function (`() => this.branchChangeCallbacks.delete(cb)`,
  // `:141-142`); that return value is `unsubscribe-branch-change`, idempotent because upstream's
  // is a `Set.delete`.
  subscribe-branch-change:    func();
  unsubscribe-branch-change:  func();
  // `opts-json` is pi's `ExtensionUIDialogOptions` bag (`extensions/types.ts:95-101` @v0.83.0):
  // `{signal, timeout}` — `timeout?: number`, "Timeout in milliseconds. Dialog auto-dismisses with
  // live countdown display" (:100), and/or a programmatic-dismiss signal id (none = `{}`).
  // EXT-048: the citation this comment used to carry (`types.ts:89`, key `timeoutMs`) was wrong on
  // both counts — `:89` is the `AppKeybinding`/`KeybindingsManager` re-export at v0.83.0 (EXT-072
  // corrected this note's own claim that it was "a blank line before the UI Context banner"; the
  // blank is `:90` and the banner `:91-93`) and upstream has no
  // `timeoutMs` anywhere. `timeout` is now the CANONICAL key; `timeoutMs` is still accepted as a
  // serde alias for back-compat with bags cyrup's own SDK already wrote.
  // EXT-036, SECOND CLUSTER: the three `rpc-types.ts` citations below were stale by a uniform +8 —
  // the same failure mode as the `types.ts` cluster above, in a file the SDK-side register never
  // opened. The file is `packages/coding-agent/src/modes/rpc/rpc-types.ts` @v0.83.0, and the wire
  // shapes live in the `RpcExtensionUIRequest` union at `:238-248`. `:232` (the old confirm cite)
  // is a BLANK line and `:233-240` (the old input cite) starts on a banner comment.
  //
  // Pi `confirm(title, message, opts)` (`rpc-types.ts:240`): `prompt` is the short `title`,
  // `message` is the (often large, formatted) body — both genuinely used, e.g. pi-mcp-adapter's
  // sampling handler passes a label as `title` and the full prompt/conversation text as `message`.
  confirm:    func(prompt: string, message: string, opts-json: string) -> bool;
  // Pi `input(title, placeholder, opts)` (`rpc-types.ts:241-248`): `placeholder` is optional
  // (`none` = Pi omits the wire field entirely) and forwarded live to the renderer.
  input:      func(prompt: string, placeholder: option<string>, opts-json: string) -> option<string>;
  // single-choice select over a json array of options; returns the chosen string (none = cancel).
  // Pi `select(title, options, opts?): Promise<string | undefined>` (`extensions/types.ts:133`
  // @v0.83.0; wire shape `rpc-types.ts:239`). EXT-036: the SDK-side register recorded `:127` as the
  // stale value for this one; the WIT carried no citation at all, which is how it survived.
  select:     func(prompt: string, options-json: string, opts-json: string) -> option<string>;
  // multiline editor seeded with `initial`, labeled `title` (Pi
  // `editor(title, prefill?): Promise<string | undefined>`, `types.ts:222` @v0.83.0 — `:216` is
  // `setEditorText`, EXT-036); returns the edited text (none = cancelled).
  editor:     func(title: string, initial: string) -> option<string>;
  // Pi `setWidget(key, content: string[] | undefined, options?: ExtensionWidgetOptions)`
  // (`extensions/types.ts:170-175` @v0.83.0, plus a component-factory overload at `:171-175`), with
  // `ExtensionWidgetOptions {placement?}` at `:107-110` and
  // `WidgetPlacement = "aboveEditor" | "belowEditor"` at `:104`.
  //
  // EXT-047: this was `set-widget: func(widget-json: string)` — ONE opaque payload where pi takes
  // three arguments. The `key` is what makes the surface a MAP: one widget per key, so two
  // extensions no longer clobber each other; `none` content REMOVES that key's widget (upstream's
  // `content: undefined`), which cyrup could not express at all — the shipped subagents extension
  // hand-rolled `{"key": …, "content": null}` to mean it and the slot stayed occupied; and
  // `placement` decides which chrome slot it lands in, which was unexpressible.
  //
  // `content-json` is pi's `string[]` (the widget LINES) as serde_json, `none` = remove.
  // `opts-json` is the `ExtensionWidgetOptions` bag; `{}` = pi's default `"aboveEditor"`.
  set-widget: func(key: string, content-json: option<string>, opts-json: string);

  // --- chrome (Pi `setHeader` `types.ts:190`, `setFooter` `:183-187`, `setTitle` `:193` @v0.83.0;
  //     EXT-036: the range `:130-150` this line used to cite is the dialog/notify block above) ---
  //
  // [CYRUP-DELTA] EXT-064 / TUI-033 — ONE collapse lives in these two signatures, and it is a
  // MECHANISM difference at full feature parity. Upstream both take a component FACTORY
  // (`setFooter(factory: ((tui, theme, footerData) => Component) | undefined)` at `:183-187`,
  // `setHeader(factory: ((tui, theme) => Component) | undefined)` at `:190`), invoked ONCE per
  // `setFooter`/`setHeader` call (`interactive-mode.ts:2440` and `:2471` @v0.87.1 — the factory is
  // NOT re-invoked by the draw path; the COMPONENT it returns is what the draw path re-renders).
  // A closure cannot cross a component boundary, so cyrup takes the rendered text instead, and the
  // two halves of what upstream's component gets for free are restored explicitly:
  //   * the DATA the factory's third argument carries — a `ReadonlyFooterDataProvider` (`:179-181`)
  //     — is PULLED through the `footer-data` import below;
  //   * the RE-RENDER a data change would have caused is PUSHED through the `on-branch-change`
  //     export (`events`), so a guest's footer tracks the branch instead of freezing at whatever
  //     was current when it called `set-footer`.
  // All four members of `ReadonlyFooterDataProvider` are therefore covered: `getGitBranch`,
  // `getExtensionStatuses` and `getAvailableProviderCount` by `footer-data`, and `onBranchChange`
  // by the `ui.subscribe-branch-change` / `events.on-branch-change` pair.
  //
  // `option<string>` is upstream's `Component | undefined` argument, NOT a collapse: `none` is
  // upstream's `undefined` — "restore the built-in chrome" (`interactive-mode.ts:2442-2446`,
  // `:2481-2490`) — and `some(s)` is a custom one carrying `s`. `some("")` is therefore an EMPTY
  // CUSTOM footer, which is a state upstream has (a factory returning a component that renders
  // nothing) and which is distinct from restoring the built-in. EXT-064: this WAS the second
  // collapse — `set-footer(content: string)` with the EMPTY STRING overloaded to mean "restore the
  // built-in" — and it cost a guest that state outright, so it was a behavioural difference
  // wearing a delta's clothes rather than a mechanism note. Fixed by the signature, not documented.
  set-header: func(content: option<string>);
  set-footer: func(content: option<string>);
  // EXT-064 — the read half of pi's `ReadonlyFooterDataProvider`
  // (`core/footer-data-provider.ts:385-388` @v0.87.1; the file is under `core/`, NOT
  // `modes/interactive/`). A json object under pi's own field names:
  //   {"gitBranch": string|null, "extensionStatuses": {key: text}, "availableProviderCount": number}
  // `gitBranch` keeps upstream's TRI-STATE verbatim — a branch name, the literal `"detached"`, or
  // `null` outside a repo (`:126-132`). The outer `none` is "no footer data provider attached",
  // which is upstream's own answer everywhere but the interactive TUI: pi constructs its one
  // `FooterDataProvider` at `interactive-mode.ts:611` and nowhere else.
  footer-data: func() -> option<string>;
  set-title:  func(title: string);
  // custom overlay component; returns an optional serialized result (Pi
  // `custom<T>(factory, ...)`, `types.ts:196` @v0.83.0 — "Show a custom component with keyboard
  // focus". EXT-036: `:175` is the closing paren of the `setWidget` component-factory overload).
  custom:     func(spec-json: string) -> option<string>;
  // --- editor buffer access (Pi `pasteToEditor` `types.ts:213`, `setEditorText` `:216`,
  // `getEditorText` `:219` @v0.83.0).
  //
  // EXT-036, NAME correction: this line used to read "getEditorText/setEditorText/
  // pasteEditorText, types.ts:200-230". There is no `pasteEditorText` upstream — the pi name is
  // `pasteToEditor` — so the citation named a function that does not exist, which is exactly
  // the fabrication class EXT-036 was filed for, and the `:200-230` range was wide enough to
  // hide it. The WIT import stays spelled `paste-editor-text`: renaming it would RE-SIGN an
  // import and force a HOST_WORLD bump for a comment fix. That spelling is therefore a
  // [CYRUP-DELTA] against `types.ts:213` — cyrup's import name, pi's semantics. ---
  get-editor-text:   func() -> string;
  set-editor-text:   func(text: string);
  paste-editor-text: func(text: string);
  // Pi `addAutocompleteProvider(factory: AutocompleteProviderFactory)` (`extensions/types.ts:225`
  // @v0.83.0, documented at `:224` "Stack additional autocomplete behavior on top of the built-in
  // provider"). Argument-less for the same closure-cannot-cross-a-component-boundary reason as
  // `registration.add-autocomplete` — this records that the guest contributes one more stacked
  // provider, and the host folds them in through the `autocomplete-suggest` export.
  //
  // EXT-065: this used to live on `interface registration`, which is NOT gated by the manifest's
  // `capabilities.ui` grant — so an extension declaring no UI grant could still stack a provider
  // onto the core input editor. Upstream declares it INSIDE `ExtensionUIContext` (`:131-282`), i.e.
  // `ctx.ui.addAutocompleteProvider(...)`, so moving it here restores both pi's placement and the
  // grant, with no new enforcement code: every `ui.*` import goes through `ui_guest_of`. Moving an
  // import between interfaces re-signs the world (0.7 -> 0.8). Do not move it back.
  add-autocomplete-provider: func();
  // --- theme read/list/switch ---
  // Pi's live theme is the readonly `theme: Theme` property (`extensions/types.ts:266` @v0.83.0);
  // `theme-get` returns its NAME.
  theme-get:  func() -> option<string>;
  // EXT-066: the live theme used to be the ONE theme a guest could not read the colours of — this
  // line claimed the name was "the only part that survives the serde seam" while the sibling
  // `theme-get-by-name` below serialized a whole `Theme` in the same direction, so the two lines
  // contradicted each other and a renderer wanting the host's palette had to make two round trips
  // (racy if the theme changes between them) or hard-code one. `theme-get-json` returns the ACTIVE
  // theme in exactly the shape `theme-get-by-name` produces; `none` when no backend supplies one.
  // Upstream needs no such call because `theme` is a plain property (`extensions/types.ts:266`
  // @v0.83.0, "Get the current theme for styling"). New export ⇒ the 0.7 -> 0.8 bump.
  theme-get-json: func() -> option<string>;
  // Pi `getAllThemes(): { name: string; path: string | undefined }[]`
  // (`extensions/types.ts:269` @v0.83.0). EXT-021: cyrup returned a bare json array of NAMES, so a
  // guest could not tell a built-in theme from a file-backed one or locate the file to read it.
  // Now a json array of `{name, path}` rows, `path` null for a built-in.
  theme-list: func() -> string;          // json array of {name, path}
  // Pi `getTheme(name): Theme | undefined` (`extensions/types.ts:272` @v0.83.0) — load a theme by
  // name WITHOUT switching to it. `none` = no such theme. The serialized theme crosses as json.
  theme-get-by-name: func(name: string) -> option<string>;
  // Pi `setTheme(theme): {success, error?}` (`extensions/types.ts:275`).
  theme-set:  func(name: string) -> result<_, string>;

  // --- working / streaming indicator (Pi `ExtensionUIContext`, extensions/types.ts:151-167) ---
  // Pi `setWorkingMessage(message?: string)` at `:151`, "Set the working/loading message shown
  // during streaming. Call with no argument to restore default" — `none` IS that no-argument call.
  set-working-message:   func(message: option<string>);
  // Pi `setWorkingVisible(visible: boolean)` at `:154`, "Show or hide the built-in interactive
  // working loader row during streaming" — visibility INDEPENDENT of the message, which is exactly
  // what cyrup's collapsed `working-start(label)`/`working-stop()` pair could not express.
  set-working-visible:   func(visible: bool);
  // Pi `setWorkingIndicator(options?: WorkingIndicatorOptions)` at `:164`; the bag is
  // `{frames?: string[], intervalMs?: number}` at `:116-121`, where `frames: []` hides the
  // indicator entirely and omitting the argument restores the default animated spinner — hence
  // `none` for "no argument" and a json `{}` for "explicitly empty options".
  set-working-indicator: func(opts-json: option<string>);
  // Pi `setHiddenThinkingLabel(label?: string)` at `:167`, "Set the label shown for hidden thinking
  // blocks. Call with no argument to restore default".
  set-hidden-thinking-label: func(label: option<string>);
  // CYRUP-DELTA: `working-start`/`working-stop` are cyrup-ORIGINAL. Upstream has no `startWorking`
  // or `stopWorking` at v0.83.0 (`git grep -n 'startWorking\|stopWorking' v0.83.0` is empty) and
  // the `types.ts:265-275` this pair used to cite is the theme block — `theme`/`getAllThemes`/
  // `getTheme`/`setTheme` (EXT-072 corrected this note too: `getToolsExpanded` is `:278`, OUTSIDE
  // the range it named) — a fabricated citation (EXT-021/EXT-036). They are kept because guests and
  // the bundled example already call them; they are now defined in terms of the pi imports above:
  // `working-start(label)` == `set-working-message(some(label))` + `set-working-visible(true)`,
  // `working-stop()` == `set-working-visible(false)`.
  working-start: func(label: string);
  working-stop:  func();
  // --- tools-expanded get/set (Pi getToolsExpanded/setToolsExpanded) ---
  get-tools-expanded: func() -> bool;
  set-tools-expanded: func(expanded: bool);
}

interface session {
  // read-only session view (arch-04) over the boundary.
  entries-json: func() -> string;
  branch-json:  func() -> string;
  tree-json:    func() -> string;
  // R-08-026 state persistence: append a non-LLM custom entry.
  append-entry: func(custom-type: string, data-json: string) -> result<string, string>;
  set-session-name: func(name: string);
  get-session-name: func() -> option<string>;
  // pi `setLabel(entryId: string, label: string | undefined): void` (extensions/types.ts:1314
  // @v0.83.0), documented "Set or clear a label on an entry. Labels are user-defined markers for
  // bookmarking/navigation." `none` CLEARS (EXT-046) — an empty string writes an empty label, which
  // is not the same thing and left the entry marked forever.
  set-label:        func(entry-id: string, label: option<string>);
}

interface models {
  list-models:        func() -> string;          // json array of model refs
  // pi `ctx.scopedModels: readonly ScopedModel[]` (extensions/types.ts:326 @v0.83.0) — on the BASE
  // `ExtensionContext`, so available to every handler: "Models scoped to this session (resolved
  // from `--models` / `enabledModels` settings against the available catalogue). Same set the
  // `/scoped-models` command shows. Empty when no scoping is configured." json array (EXT-045).
  scoped-models:      func() -> string;
  current:            func() -> option<string>;
  // Callable from ANY tier, matching pi: `setModel` is bound with only `assertActive`
  // (`core/extensions/loader.ts:359-362` @v0.83.0) and takes effect
  // (`core/agent-session.ts:1476-1490`). EXT-074: this line read "COMMAND-only at the host" and its
  // sibling below said an event-tier call is "REJECTED" — both were STALE. GAP-11 dropped the tier
  // gate in `host/live.rs` (`set_model` `:561-562`, `set_thinking_level` `:580-581` both take the
  // ungated `guest_of`) and neither comment moved, so the WIT advertised a restriction the host does
  // not enforce — the mirror image of EXT-066's capability-with-a-dead-backend, and just as
  // misleading to a guest author, who is reading the only contract they have.
  set-model:          func(model-json: string);
  context-usage:      func() -> string;
  thinking-level:     func() -> option<string>;
  // Callable from ANY tier too (EXT-074, see `set-model` above): pi binds `setThinkingLevel` with
  // only `assertActive` (`core/extensions/loader.ts:369-372` @v0.83.0, wired at
  // `core/extensions/runner.ts:336`; EXT-072: `:330` is the `getAllTools` wiring). cyrup QUEUES the
  // op through the `control` mpsc — a synchronous push touching no wasm store — and applies it at
  // the store-free turn-boundary drain, which is what dissolves the R-08-008 deadlock the old
  // command-tier gate existed to prevent. The `result` stays: it carries a real backend failure
  // (no session attached), not a tier refusal.
  set-thinking-level: func(level: string) -> result<_, string>;

  // --- Model CALLS (EXT-086) ---------------------------------------------------------------------
  // pi `ctx.modelRegistry.complete(model, context, options)`, `stream(…)` and `streamSimple(…)`
  // (`core/model-registry.ts` @v1.0.4, delegating to `ModelRuntime`, `core/model-runtime.ts:691-741`):
  // one model call through the session's configured providers, with the provider's request auth
  // resolved per call. Gated by the manifest's `capabilities.modelCalls` (cyrup-original — pi has no
  // capability model); the read-only verbs above stay ungated.
  //
  // `model-json` is an ADDRESS: any object with string `provider` and `id` keys (a `list-models` row
  // qualifies). The host re-resolves it against the session's catalog and ignores the rest, so a
  // guest cannot point the user's credential at an endpoint of its own. `context-json` is pi's
  // `Context` (`{systemPrompt?, messages, tools?}`); `opts-json` is pi's options bag minus what cannot
  // or must not cross (`apiKey`/`env`, `signal`, the callbacks) — "" or "null" for none.
  //
  // As upstream, a request-time failure is NOT an `err`: an unknown model, a provider without
  // credentials, a routing failure or a transport failure SETTLES — `complete` answers `ok` with an
  // `AssistantMessage` whose `stopReason` is `error`, a stream ends with one `error` terminal. `err`
  // means the call could not be made: no capability, a malformed argument, too many open streams, or
  // `stream-simple` on a virtual model whose router is this same extension (its instance is
  // suspended in this call and cannot route; refused rather than deadlocked).
  //
  // Only `stream-simple` routes a virtual model (reason `direct`), as only pi's `streamSimple` does;
  // `complete` and `stream` on one settle as pi's "must be routed before streaming" error. No
  // `before_provider_request` hook runs for these calls and their usage is not added to the
  // session's: pi wires both into the AGENT, not into `ModelRuntime`.
  //
  // `complete` holds this extension's instance for the length of the call (bounded by the host);
  // `ok` is the settled `AssistantMessage` JSON.
  complete:      func(model-json: string, context-json: string, opts-json: string) -> result<string, string>;
  // The streaming verbs return a handle into this extension's own stream table; the HOST owns the
  // provider stream and drains it in the background — the request/poll bridge of
  // `http-client.request-stream` (a guest cannot hold a live host stream, and the host cannot push
  // into a guest suspended in a call). `stream` is escaped because it is a WIT keyword; the binding
  // name is `stream`.
  %stream:       func(model-json: string, context-json: string, opts-json: string) -> result<u32, string>;
  stream-simple: func(model-json: string, context-json: string, opts-json: string) -> result<u32, string>;
  // Every event that arrived since the last poll, each pi's `AssistantMessageEvent` JSON, in order.
  // UNLIKE `http-client.poll-stream-chunk` it never parks the guest on an open-ended wait: it waits
  // at most ~1s for the first event, so `some([])` means "nothing yet, still live" — NOT the end.
  // `none` is the end: the batch carrying the one terminal (`done` / `error`) was returned already.
  // `err`: an unknown or closed handle, or a stream the host closed because it went unpolled.
  poll-stream:   func(handle: u32) -> result<option<list<string>>, string>;
  // Close a stream, cancelling its provider request if it is still running. An unknown handle is a
  // no-op. Every stream still open is closed when the extension is unloaded or traps.
  close-stream:  func(handle: u32);
}

interface exec {
  use types.{exec-result};
  run: func(cmd: string, args: list<string>, opts-json: string) -> result<exec-result, string>;
}

// A long-lived, duplex-pipe child process — the L4 `proc` capability (pi-mcp-adapter-port.md §3.1,
// the locked drafted shape) backing MCP stdio transport (`StdioClientTransport`, the majority
// real-world MCP server shape). Distinct from `exec.run`'s bounded run-capture-return one-shot:
// `proc` stays open across many host calls, with a live stdin the guest can keep writing to and a
// live stdout/stderr the guest polls incrementally as the child produces output over time. Gated by
// the SAME load-time trust check `exec`/`ui`/`http-client` use (`is_trusted =
// origin.is_pre_trust() || project_trusted`, loader.rs:57-60); an untrusted extension gets
// `DenyServices` and this interface is unreachable, exactly like `exec`/`http-client`.
//
// The host owns actual process lifetime and byte-stream buffering (a real `tokio::process::Child` +
// buffered pipe-reader tasks keyed by an opaque `handle`, `cyrup-ext/src/caps/proc.rs`); the guest
// polls (the SAME request/poll bridge `http-client`'s stream registry uses, arch-08 §5.2) rather
// than holding a live process handle across the wasm boundary.
interface proc {
  // Spawn a long-lived child; returns a handle or an error. `capture-stderr` mirrors Pi's
  // debug-mode "inherit" vs "ignore" (server-manager.ts:111).
  spawn: func(cmd: string, args: list<string>, env-json: string, cwd: option<string>,
              capture-stderr: bool) -> result<u32, string>;   // u32 = proc-handle

  // Write to the child's stdin. Returns bytes written or an error (e.g. pipe closed).
  write-stdin: func(handle: u32, data: list<u8>) -> result<u32, string>;

  // Read the next chunk of stdout (non-blocking poll; empty list = no data yet, not EOF).
  // EOF is signalled by a subsequent `poll-exit` returning `some`.
  read-stdout: func(handle: u32, max-bytes: u32) -> result<list<u8>, string>;
  read-stderr: func(handle: u32, max-bytes: u32) -> result<list<u8>, string>;

  // Poll whether the child has exited; `some(code)` once terminated.
  poll-exit: func(handle: u32) -> option<s32>;

  // Terminate the child: close stdin (EOF), then SIGTERM, then SIGKILL, each escalation gated on
  // a grace period if the child is still alive (host-side policy; mirrors the real
  // StdioClientTransport.close()'s three-phase escalation).
  kill: func(handle: u32) -> result<_, string>;
}

// Outbound HTTP only (no raw TCP-connect; no ambient authority) — the L4 `http-client` capability
// (pi-mcp-adapter-port.md §3.2, the locked drafted shape). Gated by the SAME load-time trust check
// `exec`/`ui` use (`is_trusted = origin.is_pre_trust() || project_trusted`, loader.rs:57-60); an
// untrusted extension gets `DenyServices` and this interface is unreachable, exactly like `exec`.
// `request` is a bounded round trip. `request-stream`/`poll-stream-chunk`/`close-stream` back a
// long-lived streaming body (SSE / StreamableHTTP chunked responses): the HOST owns the live byte
// stream and the guest polls it (a guest cannot hold a live Rust stream across the wasm boundary —
// the request/poll bridge, arch-08 §5.2), keyed by an opaque `handle`.
interface http-client {
  record http-request {
    method: string,                       // "GET" | "POST" | ...
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
    timeout-ms: option<u32>,
  }
  record http-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }
  // The initiating response's metadata for a stream opened via `request-stream`, returned ALONGSIDE
  // the stream handle from the SAME round trip that opens the long-lived body (closes L4 §2.3: the
  // real consumer this capability backs — the MCP TS SDK's `StreamableHTTPClientTransport`/
  // `SSEClientTransport` — reads `response.status` (401 => re-auth) and `response.headers`
  // (`mcp-session-id`, `content-type`) off the SAME response whose body it then streams; there is no
  // second request to recover this metadata from, and a POST with side effects can't be re-issued to
  // do so). `body` is deliberately absent here — drain it via `poll-stream-chunk`.
  record http-stream-response {
    handle: u32,                          // stream-handle for poll-stream-chunk/close-stream
    status: u16,
    headers: list<tuple<string, string>>,
  }

  // A single request/response call. A non-2xx status is NOT itself a WIT error (fetch semantics) —
  // only a transport failure (DNS, connect refused, TLS, timeout) is; the guest inspects `status`.
  request: func(req: http-request) -> result<http-response, string>;

  // Streaming variant for SSE / StreamableHTTP's chunked responses. Returns the initiating response's
  // status+headers TOGETHER with a stream handle in one round trip; the guest polls for the next body
  // chunk via `poll-stream-chunk` (request/poll bridge, arch-08 §5.2) rather than the host blocking
  // the guest's Store on an unbounded-duration long poll.
  request-stream: func(req: http-request) -> result<http-stream-response, string>;
  poll-stream-chunk: func(handle: u32) -> result<option<list<u8>>, string>;  // none-of-none = EOF
  close-stream: func(handle: u32);
}

interface ext-fs {
  // capability-scoped; preopened dirs via WASI p2 (no ambient authority).
  read-file:  func(path: string) -> result<list<u8>, string>;
  write-file: func(path: string, data: list<u8>) -> result<_, string>;
}

interface bus {
  // inter-extension event bus (R-08-029; Pi `createEventBus()`, event-bus.ts:12-32). A guest
  // `emit`s a topic; the host fans it out to every guest that `subscribe`d that topic (its
  // `events.bus-deliver` export is invoked with the payload — the receive side that makes this a
  // real pub/sub, not an emit-into-a-void). `emit` enqueues; the host drains + delivers after the
  // emitting guest call unwinds (Pi's EventEmitter `emit` likewise returns without awaiting its
  // async listeners; wasm single-instance reentrancy forbids re-entering the emitter synchronously).
  emit:      func(topic: string, payload-json: string);
  // Declare that this guest listens on `topic` (Pi `pi.events.on(channel, handler)`, event-bus.ts:18).
  subscribe: func(topic: string);
  // Stop listening on `topic` (EXT-050). pi's `on()` returns an unsubscribe closure and, since
  // v0.84.1, the loader TRACKS it — `return runtime.trackEventBusSubscription(eventBus.on(channel,
  // handler));` (extensions/loader.ts:413-421) — so a listener wanted only while a mode is active
  // can be taken down. Without this a `subscribe` was permanent for the instance's life and the
  // guest had to filter by hand.
  unsubscribe: func(topic: string);
}

// streaming tool output: the `onUpdate` callback of Pi's ToolDefinition.execute (types.ts:484).
interface host-tool {
  emit-update: func(call-id: string, chunk-json: string);
  // the tool's AbortSignal (Pi `ToolDefinition.execute` `signal` param, types.ts:483): the guest
  // polls this during a long `execute` to cooperatively stop. True once the host cancels the call
  // (epoch/`CancelToken`) or a named signal for this `call-id` was aborted (`ui.abort-signal`).
  is-cancelled: func(call-id: string) -> bool;

  // pi `ExtensionToolContext.executeTool(name, args, options?)` (`extensions/types.ts:394`
  // @v1.0.1): run another tool from inside this tool's `execute`, through the same validation,
  // hooks and permission checks as a model-issued call. `call-id` is the id the host passed to
  // `execute-tool`: the call gets the id `<call-id>/<n>`, its events carry `call-id` as
  // `parent-tool-call-id`, it never enters the transcript, and a bounded record of it lands as
  // `nestedCalls` on this call's result message. Cancellation is the calling tool's own
  // (`signal`'s default; see `is-cancelled`).
  //
  // The `ok` value is `(outcome-json, partial-results-json)`: `outcome-json` is pi's
  // `AgentToolCallOutcome` — `{toolCall, result: {content, details?, usage?, structuredContent?,
  // isError?, terminate?, addedToolNames?}, isError}` — and `isError` is the normalised verdict.
  // It NEVER reports a tool failure as `err`: an unknown tool, a tool that is not callable, a
  // validation error, a blocked call and a failing tool all come back as `ok` with `isError` set.
  // `err` means the call itself could not be made: `call-id` is not the call in flight on this
  // instance, no session is attached, the nested call re-enters this same instance, or
  // `args-json` is not JSON.
  //
  // Two of pi's options do not cross as pi has them, and this import does not pretend otherwise.
  // `options.onUpdate` is a closure and the guest is suspended inside this call, so it inverts
  // the way `emit-update` does: when `collect-updates` is true the partial results the nested tool
  // streamed come back, in order, as `partial-results-json` (one `AgentToolResult` JSON each) when
  // the call settles — BATCHED, not live; the same results ARE delivered live as
  // `tool_execution_update` events, as in pi. `options.signal` is NOT carried: the nested call's
  // cancellation is always the calling tool's, because a suspended guest has no abort handle it
  // could fire on a signal of its own.
  execute-tool: func(call-id: string, name: string, args-json: string, collect-updates: bool) -> result<tuple<string, list<string>>, string>;

  // pi `ExtensionToolContext.tools` (`extensions/types.ts:385`): what `execute-tool` can call, as a
  // JSON array of `{name, label?, description, parameters, outputSchema?, exposure, namespace?}`.
  // `err` when `call-id` is not the call in flight or no session is attached.
  callable-tools: func(call-id: string) -> result<string, string>;
}

// The two closure-shaped options of pi's `BashOperations.exec` (`core/tools/bash.ts:71-80`
// @v0.84.4), which cannot cross a component boundary as closures (ADR-0002) — the same
// substitution `host-tool` above already makes for `ToolDefinition.execute`'s `onUpdate`/`signal`.
// Both are keyed by the `call-id` the host passed to `bash-operations-exec`, so a chunk or a poll
// can never be attributed to another command (EXT-M06). DRIFT-004.
interface host-bash {
  // pi `onData: (data: Buffer) => void` — RAW bytes, combined stdout+stderr, sanitized by the
  // CALLER (`bash-executor.ts:78-105` strips ANSI and normalizes CR inside its own wrapper), never
  // by the backend. A chunk whose `call-id` is not the live one is DROPPED.
  emit-bash-output: func(call-id: string, chunk: list<u8>);
  // pi `signal?: AbortSignal` — the guest polls this while the command runs and stops
  // cooperatively. True once the host's `CancelToken` for this command fired.
  is-bash-cancelled: func(call-id: string) -> bool;
}

// The closure-shaped member of pi's `ModelRouteRequest` (`core/virtual-models.ts:69` @v1.0.4,
// `signal?: AbortSignal`), which cannot cross a component boundary (ADR-0002) — the same
// substitution `host-bash` above makes for `BashOperations.exec`'s `signal` and `host-tool` for
// `ToolDefinition.execute`'s. Keyed by the `route-id` the host passed to `events.route-model`, so a
// stale poll from a later handler can never read a dead route's state (EXT-M06).
//
// Deliberately NOT `host-tool.is-cancelled`: that poll reads the `tool_cancel` slot, which
// `ToolCallBinding`'s `Drop` clears, so a route sharing it would be torn down by an unrelated tool
// call's unwind.
interface host-router {
  is-route-cancelled: func(route-id: string) -> bool;
}

// OAuth login callbacks (Pi `OAuthLoginCallbacks`, pi-ai oauth/types.ts): the host-side handlers a
// guest's `login(callbacks)` flow drives during `provider-login`. The host renders the auth URL /
// device code / prompts and returns the user's answers (the interactive half of `/login`).
interface oauth {
  on-auth:        func(url: string, instructions: option<string>);
  on-device-code: func(user-code: string, verification-uri: string, interval-seconds: option<u32>, expires-in-seconds: option<u32>);
  // prompt for a value (e.g. "Paste the callback URL"); err = cancelled.
  on-prompt:      func(message: string, placeholder: option<string>, allow-empty: bool) -> result<string, string>;
  on-progress:    func(message: string);
  // interactive selector over a json array of {id,label}; returns the chosen id (none = cancel).
  on-select:      func(message: string, options-json: string) -> option<string>;
}

// streamSimple output (pi `createAssistantMessageEventStream`,
// `packages/ai/src/utils/event-stream.ts:86` @v0.83.0 — EXT-072: the `types.ts:1373` this cited is a
// JSDoc line and the symbol is in a different package): the guest's custom
// stream pushes assistant-message stream events keyed by `stream-id`; the host forwards them to the
// provider pipeline (the streaming analog of `host-tool.emit-update`).
interface provider-stream {
  emit-event: func(stream-id: string, event-json: string);

  // EXT-052 — the `streamSimple` MUST-INVOKE contract, quoted verbatim from pi's
  // `ProviderConfig.streamSimple` doc (`extensions/types.ts:1452-1457` @v0.84.1):
  //
  //   "Implementations must invoke `options.onPayload` before sending the provider request and use
  //    any returned replacement payload. They must invoke `options.onResponse` after receiving the
  //    response and before consuming its body, matching built-in providers."
  //
  // These are how `before_provider_request` (extensions/types.ts:676-679) and
  // `after_provider_response` (:692-696) reach requests an EXTENSION-supplied provider issues. A
  // guest provider that skips them makes every one of its requests invisible to every other
  // extension — a redaction or audit extension silently stops working the moment the user switches
  // model. `on-payload` returns a REPLACEMENT payload (`none` = unchanged), which is the mutating
  // half; `on-response` is notify-only.
  on-payload:  func(stream-id: string, payload-json: string) -> option<string>;
  on-response: func(stream-id: string, status: u16, headers-json: string);
}

// Active-tool / command introspection (Pi getActiveTools `types.ts:1320`, getAllTools `:1323`,
// setActiveTools `:1326`, getCommands `:1329`, all @v0.83.0): the plan-mode active-tool restriction
// surface. `set-active-tools` is the only mutating one; the host enforces the merge (arch-08 §3.5).
// EXT-073: the range `:1257-1266` these four used to cite is the one EXT-036 already named as
// wrong-surface and fixed in `host/services.rs`; it survived here. Do not restore it.
interface ext-tools {
  get-active-tools: func() -> string;   // json array of active tool names
  // EXT-071: `ToolInfo` is pi's FIVE keys — `{name, description, parameters, promptGuidelines,
  // sourceInfo}` (`types.ts:1552-1554` @v0.83.0). This comment used to advertise a `source` key;
  // that was cyrup-invented and EXT-060 REMOVED it from the emitted object (`registry.rs`, pinned by
  // `tests/aggregation.rs`). Do not restore it.
  get-all-tools:    func() -> string;   // json array of ToolInfo {name, description, parameters, promptGuidelines, sourceInfo}
  set-active-tools: func(names-json: string);
  // EXT-071: `SlashCommandInfo` is `{name, description?, source, sourceInfo}`
  // (`core/slash-commands.ts:6-11` @v0.83.0) and EXT-037's implementation emits all four; this
  // comment under-documented it as two keys.
  get-commands:     func() -> string;   // json array of SlashCommandInfo {name, description?, source, sourceInfo}
}

// Read-only ctx state (pi `ExtensionContext`, extensions/types.ts:307-347 @v0.83.0 — EXT-072:
// `:305` is `ExtensionMode`). Pi puts `mode`, `hasUI`,
// `isIdle`, `hasPendingMessages`, `isProjectTrusted` and `getSystemPrompt` on the BASE context —
// available to EVERY handler, not just command handlers — so these are deliberately NOT tier-gated.
// The native built-in path reads the same six values off `HostCtx` / `HostCtx::rich()`.
//
// `get-system-prompt-options` (EXT-061) is the ONE exception and it is upstream's, not cyrup's: it
// is the only member here pi declares on `ExtensionCommandContext` instead. See its comment.
interface ctx-state {
  use types.{ext-mode};

  // Pi `ctx.mode` (types.ts:311): the run mode — a guest guards terminal-only UI (custom
  // components) on `tui`. A FIELD in Pi; a getter here because WIT imports are functions.
  get-mode:             func() -> ext-mode;
  // Pi `ctx.hasUI` (types.ts:313): "Whether dialog-capable UI is available (true in TUI and RPC
  // modes)" — the guard a guest checks before `ui.confirm`/`input`/`select`.
  has-ui:               func() -> bool;
  // pi `ctx.isIdle()` (types.ts:330 @v0.83.0; EXT-072: `:333` is `signal`'s doc line): false while
  // an agent run is in flight.
  is-idle:              func() -> bool;
  // pi `ctx.hasPendingMessages()` (types.ts:338 @v0.83.0; EXT-072: `:341` is `getContextUsage`'s
  // doc line): queued user messages awaiting the next turn.
  has-pending-messages: func() -> bool;
  // pi `ctx.isProjectTrusted()` (types.ts:332 @v0.83.0; EXT-072: `:335` is `abort`'s doc line).
  is-project-trusted:   func() -> bool;
  // Pi `ctx.getSystemPrompt()` (types.ts:346); empty string when no session backend is attached.
  get-system-prompt:    func() -> string;
  // pi `ctx.getSystemPromptOptions()` (`extensions/types.ts:355` @v0.83.0, documented at `:354`
  // "Get the current base system-prompt construction options") — the serialized
  // `BuildSystemPromptOptions` BAG that produced the string `get-system-prompt` returns, so a
  // command can rebuild the prompt with ONE option changed instead of reconstructing the bag by
  // guesswork from the resolved text (EXT-061). The bag is `core/system-prompt.ts:8-25` @v0.83.0:
  // `{customPrompt?, selectedTools?, toolSnippets?, promptGuidelines?, appendSystemPrompt?, cwd,
  // contextFiles?, skills?}`; upstream fills it once per build as `_baseSystemPromptOptions`
  // (`core/agent-session.ts:1044-1053`) and hands it back verbatim at `:2436`.
  //
  // THE ONE TIER-GATED MEMBER OF THIS INTERFACE, and the exception is upstream's own: pi declares
  // `getSystemPrompt()` on the BASE `ExtensionContext` (`:346`) but `getSystemPromptOptions()` on
  // `ExtensionCommandContext` (`:353-387`), so an event-tier call is REJECTED here with the same
  // observable error every `control.*` op gives — never a silent empty bag. That is also why this
  // returns a `result` where its six siblings return plain values.
  //
  // With no session backend the host answers pi's OWN no-backend default rather than an error or an
  // empty object: `() => ({ cwd: this.cwd })` (`core/extensions/runner.ts:287`, re-bound at `:350`
  // @v0.83.0). A bag carrying only `cwd` is therefore a valid answer, not a broken one.
  get-system-prompt-options: func() -> result<string, string>;
  // pi `ctx.cwd: string` (extensions/types.ts:315 @v0.83.0) — on the BASE `ExtensionContext`, in
  // the same block as `mode` (:311) and `hasUI` (:313), so it is available to every handler and
  // every tool `execute`, not just command handlers. Without it a guest can resolve no relative
  // path at all: it cannot tell which project it is in, scope a cache, interpret a path in a tool
  // argument, or compose one for its `ext-fs`/`exec` grant (EXT-044). cyrup's NATIVE tier already
  // exposed it (`HostCtx.cwd`), so this was a divergence between cyrup's own two tiers as well.
  get-cwd:              func() -> string;
  // The run-scoped analog of `host-tool.is-cancelled` (EXT-045). pi puts `signal: AbortSignal |
  // undefined` on the base `ExtensionContext` (extensions/types.ts:334 @v0.83.0, "The current abort
  // signal, or undefined when the agent is not streaming").
  //
  // CYRUP-DELTA: a live `AbortSignal` is an object with `addEventListener`, and a component-model
  // value cannot be a callback target — the guest cannot be WOKEN by an abort, only ask about it.
  // So the signal is ported as a poll, not as a subscription: a long-running non-tool handler
  // checks this between units of work. `true` also once the whole run is cancelled, which is when
  // upstream's `signal.aborted` flips.
  is-run-cancelled:     func() -> bool;
}

// COMMAND-ONLY (arch-08 §6.3, deadlock rule): session/runtime mutation. Calling any of
// these from an event handler returns a host-side deadlock error (surfaced, never a hang).
// EXCEPT `abort`/`shutdown` — see their comments: pi puts both on the BASE `ExtensionContext`
// (`abort` `:336`, `shutdown` `:340`, alongside `compact` `:344`, @v0.83.0; EXT-072: the
// `:339-340,344` this cited put `abort` on `shutdown`'s doc line), callable from any handler, so
// cyrup does NOT tier-gate them.
interface control {
  // opts-json carries the typed Pi option bags (newSession{parentSession,withSession},
  // fork{position,withSession}, switchSession{withSession}, navigateTree{summarize,…},
  // `extensions/types.ts:361-383` @v0.83.0 — EXT-072: `:346-368` starts on `getSystemPrompt` and
  // ends on `fork(`).
  new-session:   func(opts-json: string) -> result<_, string>;
  switch:        func(session-id: string, opts-json: string) -> result<_, string>;
  fork:          func(entry-id: string, opts-json: string) -> result<_, string>;
  navigate:      func(entry-id: string, opts-json: string) -> result<_, string>;
  reload:        func() -> result<_, string>;
  // compact (Pi `ctx.compact(options?)`, types.ts:344): opts-json carries `CompactOptions`
  // (types.ts:296-300) — `{customInstructions}`. Pi's `onComplete`/`onError` callbacks cannot cross
  // the component boundary as function values; a guest observes completion by subscribing to the
  // `session_compact` event (Pi's own `SessionCompactEvent` carries the produced entry).
  compact:       func(opts-json: string) -> result<_, string>;
  wait-idle:     func() -> result<_, string>;
  // send-message (pi `sendMessage`, `extensions/types.ts:1286` @v0.83.0; EXT-072: `:1223` is the
  // `tool_execution_start` overload): opts-json carries {triggerTurn, deliverAs}.
  send-message:      func(message-json: string, opts-json: string) -> result<_, string>;
  send-user-message: func(content: string, opts-json: string) -> result<_, string>;

  // Pi `ctx.abort()` (extensions/types.ts:336 @v0.83.0, doc "Abort the current agent operation"
  // at `:335`): cancels the in-flight run. NOT tier-gated — an event handler (e.g. a
  // `tool_call` gate that decides the whole run must stop) is exactly Pi's use case, and abort
  // cannot deadlock the way a session REPLACEMENT op can.
  abort:    func() -> result<_, string>;
  // EXT-073: this comment used to read `types.ts:339, "Abort the current agent run. Available in
  // all contexts."` — a FABRICATED quote, spliced from two different members. `:339` is
  // `shutdown`'s doc line, "Available in all contexts." is `shutdown`'s sentence, and upstream
  // never writes "agent run" here. Do not restore it.
  //
  // Pi `ctx.shutdown()` (extensions/types.ts:340 @v0.83.0, doc "Gracefully shutdown pi and exit.
  // Available in all contexts." at `:339`). Sets the host's shutdown-requested flag; the host acts at the next
  // settle point (Pi rpc-mode.ts:355-358). Also NOT tier-gated.
  shutdown: func() -> result<_, string>;
}

world extension {
  import registration;
  import ui;
  import session;
  import models;
  import exec;
  import proc;
  import http-client;
  import ext-fs;
  import bus;
  import host-tool;
  import host-bash;
  import host-router;
  import oauth;
  import provider-stream;
  import ext-tools;
  import control;
  import ctx-state;

  export events;
  // async init unit, awaited before the loader continues (R-08-001).
  export init: func() -> result<_, string>;
}
