// cyrup:ext@0.3.0 — the versioned WIT world (arch-08 §4.1).
//
// Single source of truth, shared verbatim by the host (`wasmtime::component::bindgen!`)
// and the guest (`wit-bindgen` in cyrup-ext-sdk). Open-shaped values (tool params, message
// lists, patches, custom payloads) cross as `string` carrying serde_json; fixed-shape control
// values (ids, enums, exec results) are real WIT records for type safety (arch-08 §4.1).
//
// The `events` interface exports 31 `on-*` event hooks, mirroring Pi's `pi.on(...)` catalog
// (extensions/types.ts:1198-1239, 33 overloads — `session_info_changed` and
// `before_provider_headers` have no export here). The host calls only the exports a guest
// subscribed to (the subscription gate, R-08-034).
//
// VERSIONING (EXT-028): this package version and `cyrup_ext::HOST_WORLD` move TOGETHER, and ANY
// change to an EXPORT — added, removed, or RE-SIGNED — bumps the MINOR. A guest built against an
// older MINOR either lacks the export or has it at the old signature, so it must be refused by
// `ExtensionManifest::check_world` before instantiation rather than trapping inside wasmtime.
// `crates/cyrup-ext/tests/wit_world_sync.rs` enforces that tie, in BOTH copies.
package cyrup:ext@0.4.0;

// ---------------------------------------------------------------------------
// Serializable mirrors of cyrup-core. JSON-as-string at the seam (arch-08 §4.1).
// ---------------------------------------------------------------------------
interface types {
  enum exec-mode { parallel, sequential }
  enum ext-mode  { tui, rpc, json, print }

  // What a single event handler contributes to the block/mutate/notify reduction
  // (arch-08 §3.3). `mutate`/`handled` carry serde_json patch payloads as strings; the host
  // interprets the patch shape per the event kind (Pi extensions/runner.ts emit* reducers).
  variant hook-outcome {
    noop,
    block(option<string>),
    mutate(string),
    handled(string),
  }

  // Guest -> host tool registration descriptor (arch-08 §3.5). `parameters-json` stays
  // JSON-Schema (Pi-interop, R-ARCH-EXT-008).
  record tool-descriptor {
    name: string,
    label: string,
    description: string,
    parameters-json: string,
    exec-mode: option<exec-mode>,
    prompt-snippet: option<string>,
    prompt-guidelines: list<string>,
    has-renderer: bool,
  }

  // Result of a capability-scoped exec (arch-08 caps/exec.rs). 1:1 with Pi's `ExecResult`
  // (exec.ts:23-28): `killed` is true when the host SIGTERMed, then (after a 5s grace period if
  // still alive) SIGKILLed, the process on a timeout/abort — Pi's exact `killProcess` escalation
  // (exec.ts:52-63) — false for a natural exit or an external signal.
  record exec-result {
    code: s32,
    stdout: string,
    stderr: string,
    killed: bool,
  }

  // Result of executing a guest-registered tool (R-08-015, Pi types.ts:1043 AgentToolResult).
  // `content-json` is a serde_json array of (text|image) content blocks; `terminate` ends the
  // agent loop after this result.
  record tool-output {
    content-json: string,
    details-json: option<string>,
    is-error: bool,
    terminate: bool,
  }

  // A single autocomplete suggestion (Pi `AutocompleteItem`, tui/autocomplete.ts:219).
  record autocomplete-item {
    value: string,
    label: string,
    description: option<string>,
  }

  // The suggestions a provider returns (Pi `AutocompleteSuggestions`, tui/autocomplete.ts:236):
  // the matched items + the prefix they match against.
  record autocomplete-suggestions {
    items: list<autocomplete-item>,
    prefix: string,
  }
}

// ---------------------------------------------------------------------------
// host -> guest: the §5 event catalog (exports the guest may implement).
// The host only calls events the guest subscribed to (subscription gate, R-08-034).
// All 30 Pi events (extensions/types.ts:1133-1171) are represented here.
// ---------------------------------------------------------------------------
interface events {
  use types.{hook-outcome, tool-output};

  // --- provider OAuth + custom streaming (Pi ProviderConfig.oauth/streamSimple, types.ts:1373-1392) ---
  // The host invokes these on a guest that registered a provider carrying OAuth/`streamSimple`
  // callbacks. Credentials/models/model/context/options cross as serde_json strings (open-shaped,
  // arch-08 §4.1). `provider-login` runs the guest's `login(callbacks)` flow — during it the guest
  // calls the `oauth` host imports (onAuth/onPrompt/onSelect/…) — and returns the credentials to
  // persist. `provider-stream-simple` runs the guest's custom stream: it pushes assistant-message
  // stream events back via the `provider-stream` host import, then returns when the stream ends.
  provider-login:         func(id: string) -> result<string, string>;
  provider-refresh-token: func(id: string, credentials-json: string) -> result<string, string>;
  provider-get-api-key:   func(id: string, credentials-json: string) -> result<string, string>;
  provider-modify-models: func(id: string, models-json: string, credentials-json: string) -> result<string, string>;
  provider-stream-simple: func(id: string, stream-id: string, model-json: string, context-json: string, options-json: string) -> result<_, string>;

  // --- global autocomplete provider stacking (Pi addAutocompleteProvider, types.ts:218) ---
  // The host folds the guest's stacked `AutocompleteProviderFactory` chain over its own built-in
  // suggestions: `base-json` is the built-in `autocomplete-suggestions` (the wrapped "current"),
  // `query-json` carries `{lines, cursorLine, cursorCol, force}`. The guest returns the final
  // suggestions after applying every stacked provider in registration order.
  autocomplete-suggest:   func(base-json: string, query-json: string) -> string;

  // --- withSession re-binding callback (Pi ReplacedSessionContext, types.ts:346-390) ---
  // After a command-tier `control.new-session`/`switch`/`fork` carrying a `withSessionCallbackId`,
  // the host re-binds the replacement session then invokes THIS export with that id — a fresh
  // top-level call, because wasm single-instance reentrancy forbids calling it synchronously inside
  // the `control.*` import (Pi `finishSessionReplacement`, agent-session-runtime.ts:184-189). The
  // guest looks up the stored `withSession(ctx)` closure and runs it against a freshly-bound
  // command-tier `ReplacedSessionContext`.
  with-session: func(callback-id: string) -> result<_, string>;

  // --- guest tool execution (R-08-015) ---
  // The host invokes a guest-registered tool. Mirrors Pi's ToolDefinition.execute
  // (types.ts:464): `call-id` = toolCallId, `params-json` = arguments; cancellation (signal)
  // is delivered by the host epoch/cancel; streaming updates go back via host-tool.emit-update;
  // `ctx` is reconstructed guest-side from the capability imports.
  execute-tool: func(name: string, call-id: string, params-json: string) -> result<tool-output, string>;

  // --- guest slash-command execution (R-08-016) ---
  // The host invokes a guest-registered command at COMMAND tier (session ops legal). `args` is the
  // raw argument string (Pi RegisteredCommand.handler(args, ctx), types.ts:1109); the optional text
  // result is surfaced to the user. `get-argument-completions` is Pi's dynamic getArgumentCompletions
  // (types.ts:1108): given a prefix, the guest returns the completion items (replacing static lists).
  execute-command:          func(name: string, args: string) -> result<option<string>, string>;
  get-argument-completions: func(name: string, prefix: string) -> list<string>;

  // --- guest keyboard-shortcut execution (R-08-017; Pi registerShortcut handler, types.ts:1199-1205) ---
  // The host invokes the guest's stored shortcut handler (`options.handler(ctx)`) when the registered
  // `KeyId` fires. Runs at COMMAND tier (Pi hands the shortcut handler the full `ExtensionContext`).
  execute-shortcut:         func(key: string) -> result<_, string>;

  // --- message renderer dispatch (R-08-020; Pi renderCall/renderResult, types.ts:472-481) ---
  // A guest that registered a renderer for `custom-type` renders a tool call / result into a
  // serialized widget tree (none = fall back to the runtime's default renderer).
  //
  // `custom-type` is the CUSTOM MESSAGE TYPE for a renderer registered via
  // `registration.register-message-renderer`, or the TOOL NAME for a tool whose descriptor declares
  // `has-renderer` — the host routes by that key alone (EXT-006).
  //
  // THE WIDGET VOCABULARY. Pi returns a live `pi-tui` `Component` the interactive mode adds as a
  // child (`components/custom-message.ts:66-81`, `components/tool-execution.ts:81-112`); a WASM
  // guest cannot hand back an object, so cyrup's wire analog is that component tree SERIALIZED, and
  // the host flattens it to display rows (`cyrup-tui` `rendered_text`). The tags mirror the
  // `pi-tui` components a renderer actually returns (`packages/tui/src/index.ts:13-32`):
  //
  //   "…"                                        a bare string — the degenerate `Text`
  //   {"widget":"text","text":"…"}               `Text`   — the dominant shape
  //   {"widget":"markdown","text":"…"}           `Markdown`
  //   {"widget":"truncated-text","text":"…"}     `TruncatedText`
  //   {"widget":"spacer","lines":n}              `Spacer` (n defaults to 1, clamped to 64)
  //   {"widget":"box"|"container","children":[]} `Box` / `Container` — children stacked
  //   {"widget":"hstack","children":[…]}         `HStack`  — children joined on one row
  //   […]                                        shorthand for a stack
  //
  // `cyrup_ext_sdk::widget` constructs exactly these. Anything else — an unknown tag, a missing
  // tag, a tree nested deeper than 16 — is drawn as pretty-printed JSON rather than dropped, so a
  // mistyped node is visible instead of blank.
  render-call:   func(custom-type: string, call-json: string) -> option<string>;
  render-result: func(custom-type: string, result-json: string) -> option<string>;

  // --- 5.4 tools — the mutating seams ---
  // tool_call [block/mutate] (types.ts:1145), tool_result [mutate] (types.ts:1146).
  // tool_result carries the FULL Pi `ToolResultEventBase` shape (types.ts:883-929): the executed
  // tool `input` (the arguments), the per-tool `details` blob (`BashToolDetails | …`) AND the
  // optional `usage` the tool execution itself reported (types.ts:919-921, upstream `2fd38684`) —
  // not just content+isError. A `tool_result` handler inspects and patches all of them; the patch
  // direction rides the `hook-outcome` mutate JSON, whose `usage` key is read back host-side.
  on-tool-call:    func(call-id: string, name: string, input-json: string) -> hook-outcome;
  on-tool-result:  func(call-id: string, name: string, input-json: string, content-json: string, is-error: bool, details-json: option<string>, usage-json: option<string>) -> hook-outcome;

  // --- 5.3 agent & turn ---
  // context [mutate] (types.ts:1144), message_end [mutate] (types.ts:1143),
  // before_agent_start [mutate] (types.ts:1135).
  on-context:            func(messages-json: string) -> hook-outcome;
  on-message-end:        func(message-json: string) -> hook-outcome;
  on-before-agent-start: func(prompt: string, images-json: string, system-prompt: string, options-json: string) -> hook-outcome;

  // input [block/mutate/handled] (types.ts:1158), user_bash [block/mutate/handled] (types.ts:1159).
  // `input` carries the full Pi `InputEvent` (types.ts:800-810): the submission `text`, the attached
  // `images`, the `source` ("interactive"|"rpc"|"extension"), and the in-flight `streaming-behavior`
  // ("steer"|"followUp"; none when the agent is idle).
  // `user_bash` carries the Pi `UserBashEvent` (types.ts:782-790): the `command`, the
  // `exclude-from-context` flag (true for the `!!` prefix), and the `cwd`. The `operations`/`result`
  // override is returned via the `handled` outcome (Pi `UserBashEventResult`, types.ts:1043-1048),
  // NOT passed in.
  on-input:        func(text: string, images-json: string, source: string, streaming-behavior: option<string>) -> hook-outcome;
  on-user-bash:    func(command: string, exclude-from-context: bool, cwd: string) -> hook-outcome;

  // --- 5.6 provider ---
  // before_provider_request [mutate] (types.ts:1160), after_provider_response [notify] (types.ts:1161).
  on-before-provider-request: func(payload-json: string) -> hook-outcome;
  on-after-provider-response: func(status: u32, headers-json: string);

  // model_select [notify] (types.ts:1162), thinking_level_select [notify] (types.ts:1163).
  on-model-select:          func(model-json: string);
  on-thinking-level-select: func(level: string);

  // --- notify-only (return ignored); high-frequency ones are subscription-gated ---
  on-agent-start:           func();
  on-agent-end:             func(messages-json: string);
  // agent_settled (Pi AgentSettledEvent, extensions/types.ts:721-725, subscribed at types.ts:1225):
  // the run has FULLY settled — no automatic retry, post-run compaction or queued continuation will
  // follow. Distinct from on-agent-end, which fires once per agent.prompt/agent.continue: a run that
  // auto-retries delivers TWO on-agent-end calls and exactly ONE on-agent-settled. Pi emits it from
  // the `finally` of _runAgentPrompt (agent-session.ts:1063-1072), to the extension runner FIRST and
  // the session subscribers second.
  on-agent-settled:         func();
  on-turn-start:            func(turn-index: u32, timestamp: u64);
  // turn_end (Pi TurnEndEvent, types.ts:703-709): the turn index, the finalized assistant `message`,
  // AND the `tool-results` produced this turn (`ToolResultMessage[]`).
  on-turn-end:              func(turn-index: u32, message-json: string, tool-results-json: string);
  // message_start (Pi MessageStartEvent, types.ts:711-715): the full `message` (user|assistant|
  // toolResult), not just its role.
  on-message-start:         func(message-json: string);
  // message_update (Pi MessageUpdateEvent, types.ts:717-722): the full in-flight `message` AND the
  // `assistant-message-event` delta (carried here as `delta-json`). HIGH-FREQ, gated.
  on-message-update:        func(message-json: string, delta-json: string);   // HIGH-FREQ, gated
  on-tool-exec-start:       func(call-id: string, name: string, args-json: string);
  on-tool-exec-update:      func(call-id: string, chunk-json: string); // HIGH-FREQ, gated
  on-tool-exec-end:         func(call-id: string, result-json: string, is-error: bool);

  // --- 5.1/5.2 startup & session lifecycle ---
  on-session-start:         func(reason: string);
  on-session-shutdown:      func(reason: string);
  on-resources-discover:    func() -> hook-outcome;   // provide skill/prompt/theme paths
  on-project-trust:         func() -> hook-outcome;    // decide {trusted, remember}

  // session control hooks (types.ts:1148-1156): before_* are block/mutate, the rest notify.
  on-session-before-switch:  func(target-id: string) -> hook-outcome;
  on-session-before-fork:    func(entry-id: string) -> hook-outcome;
  // session_before_compact (Pi SessionBeforeCompactEvent, types.ts:577-587): the computed
  // `preparation` (CompactionPreparation, compaction.ts:634) + the `branch-entries` in scope + optional
  // `custom-instructions` + the trigger `reason` ("manual"|"threshold"|"overflow") + `will-retry`. A
  // handler may VETO via `block` or return a compaction override via `mutate` (Pi
  // SessionBeforeCompactResult.compaction = a CompactionResult) — the override's summary/details land
  // in the appended compaction entry (fromExtension). All payloads cross as serde_json strings.
  on-session-before-compact: func(preparation-json: string, branch-entries-json: string, custom-instructions: option<string>, reason: string, will-retry: bool) -> hook-outcome;
  // session_compact (Pi SessionCompactEvent, types.ts:589-598): the produced `compaction-entry` (its
  // `summary` field carries the summary text), whether an extension drove it (`from-extension`), the
  // trigger `reason`, and `will-retry`.
  on-session-compact:        func(compaction-entry-json: string, from-extension: bool, reason: string, will-retry: bool);
  // session_before_tree (Pi SessionBeforeTreeEvent, types.ts:623-628): the computed `preparation`
  // (TreePreparation, compaction.ts) — targetId/oldLeafId/commonAncestorId/entriesToSummarize/
  // userWantsSummary/customInstructions?/label?. A handler may VETO via `block` or return a
  // summary/customInstructions/label override via `mutate` (Pi SessionBeforeTreeResult).
  on-session-before-tree:    func(preparation-json: string) -> hook-outcome;
  on-session-tree:           func(tree-json: string);

  // --- inter-extension event bus delivery (Pi `pi.events.on` listener, event-bus.ts:18-27) ---
  // The host invokes this on a guest that declared a `bus.subscribe(topic)` when ANY loaded guest
  // (this one included) `bus.emit`s that topic. `payload-json` is the emitted payload. Notify-style
  // (return ignored) — the receiving half of the bus that closes gap-08 §5.3.
  bus-deliver:               func(topic: string, payload-json: string);
}

// ---------------------------------------------------------------------------
// guest -> host: registration imports (arch-08 §3.5).
// ---------------------------------------------------------------------------
interface registration {
  use types.{tool-descriptor};
  register-tool:             func(t: tool-descriptor);
  register-command:          func(name: string, desc-json: string);
  register-shortcut:         func(key: string, desc: string);
  register-flag:             func(name: string, spec-json: string);
  get-flag:                  func(name: string) -> option<string>;
  register-provider:         func(id: string, config-json: string);
  unregister-provider:       func(id: string);
  register-message-renderer: func(custom-type: string);
  add-autocomplete:          func(command: string);
  // global autocomplete provider stacking (Pi addAutocompleteProvider, types.ts:218): records that
  // the guest contributes one more stacked provider; the host folds them via `autocomplete-suggest`.
  add-autocomplete-provider: func();
  // declares the subscription bitset: which §5 event kinds this guest handles.
  subscribe:                 func(event-kinds: list<u8>);
}

// ---------------------------------------------------------------------------
// guest -> host: capabilities (arch-08 §3.6, caps/*).
// ---------------------------------------------------------------------------
interface ui {
  // notification severity (Pi notify `type`: "info" | "warning" | "error", types.ts:135); info is the default.
  enum notify-kind { info, warning, error }
  notify:     func(message: string, kind: notify-kind);
  // Pi setStatus(key, text?: string), types.ts:141: a keyed status segment; a none `text` clears that key.
  set-status: func(key: string, text: option<string>);
  // programmatically dismiss any dialog bound to `signal-id` (Pi `ExtensionUIDialogOptions.signal`
  // AbortSignal, types.ts:89-94): a dialog subsequently opened carrying that signal id returns
  // cancelled (`confirm` -> false, `input`/`select` -> none).
  abort-signal: func(signal-id: string);
  // `opts-json` is the Pi `ExtensionUIDialogOptions` bag (types.ts:89): `{timeoutMs, signal}` —
  // a live-countdown timeout and/or a programmatic-dismiss signal id (none = `{}`).
  // Pi `confirm(title, message, opts)` (rpc-types.ts:232): `prompt` is the short `title`, `message`
  // is the (often large, formatted) body — both genuinely used, e.g. pi-mcp-adapter's sampling
  // handler passes a label as `title` and the full prompt/conversation text as `message`.
  confirm:    func(prompt: string, message: string, opts-json: string) -> bool;
  // Pi `input(title, placeholder, opts)` (rpc-types.ts:233-240): `placeholder` is optional
  // (`none` = Pi omits the wire field entirely) and forwarded live to the renderer.
  input:      func(prompt: string, placeholder: option<string>, opts-json: string) -> option<string>;
  // single-choice select over a json array of options; returns the chosen string (none = cancel).
  select:     func(prompt: string, options-json: string, opts-json: string) -> option<string>;
  // multiline editor seeded with `initial`, labeled `title` (Pi `editor(title, prefill)`,
  // types.ts:216); returns the edited text (none = cancelled).
  editor:     func(title: string, initial: string) -> option<string>;
  set-widget: func(widget-json: string);

  // --- chrome (Pi setHeader/setFooter/setTitle, types.ts:130-150) ---
  set-header: func(content: string);
  set-footer: func(content: string);
  set-title:  func(title: string);
  // custom overlay component; returns an optional serialized result (Pi custom(), types.ts:175).
  custom:     func(spec-json: string) -> option<string>;
  // --- editor buffer access (Pi getEditorText/setEditorText/pasteEditorText, types.ts:200-230) ---
  get-editor-text:   func() -> string;
  set-editor-text:   func(text: string);
  paste-editor-text: func(text: string);
  // --- theme get/list/set (Pi getTheme/listThemes/setTheme, types.ts:240-260) ---
  theme-get:  func() -> option<string>;
  theme-list: func() -> string;          // json array of theme names
  theme-set:  func(name: string) -> result<_, string>;
  // --- working-indicator controls (Pi startWorking/stopWorking, types.ts:265-275) ---
  working-start: func(label: string);
  working-stop:  func();
  // --- tools-expanded get/set (Pi getToolsExpanded/setToolsExpanded) ---
  get-tools-expanded: func() -> bool;
  set-tools-expanded: func(expanded: bool);
}

interface session {
  // read-only session view (arch-04) over the boundary.
  entries-json: func() -> string;
  branch-json:  func() -> string;
  tree-json:    func() -> string;
  // R-08-026 state persistence: append a non-LLM custom entry.
  append-entry: func(custom-type: string, data-json: string) -> result<string, string>;
  set-session-name: func(name: string);
  get-session-name: func() -> option<string>;
  set-label:        func(entry-id: string, label: string);
}

interface models {
  list-models:        func() -> string;          // json array of model refs
  current:            func() -> option<string>;
  set-model:          func(model-json: string);  // COMMAND-only at the host
  context-usage:      func() -> string;
  thinking-level:     func() -> option<string>;
  // COMMAND-only at the host (deadlock rule): Pi allows setThinkingLevel from any handler
  // (runner.ts:330), but cyrup routes it through the command-tier `control` path, so an event-tier
  // call is REJECTED with an observable error (like every `control.*` op) — never a silent no-op.
  set-thinking-level: func(level: string) -> result<_, string>;
}

interface exec {
  use types.{exec-result};
  run: func(cmd: string, args: list<string>, opts-json: string) -> result<exec-result, string>;
}

// A long-lived, duplex-pipe child process — the L4 `proc` capability (pi-mcp-adapter-port.md §3.1,
// the locked drafted shape) backing MCP stdio transport (`StdioClientTransport`, the majority
// real-world MCP server shape). Distinct from `exec.run`'s bounded run-capture-return one-shot:
// `proc` stays open across many host calls, with a live stdin the guest can keep writing to and a
// live stdout/stderr the guest polls incrementally as the child produces output over time. Gated by
// the SAME load-time trust check `exec`/`ui`/`http-client` use (`is_trusted =
// origin.is_pre_trust() || project_trusted`, loader.rs:57-60); an untrusted extension gets
// `DenyServices` and this interface is unreachable, exactly like `exec`/`http-client`.
//
// The host owns actual process lifetime and byte-stream buffering (a real `tokio::process::Child` +
// buffered pipe-reader tasks keyed by an opaque `handle`, `cyrup-ext/src/caps/proc.rs`); the guest
// polls (the SAME request/poll bridge `http-client`'s stream registry uses, arch-08 §5.2) rather
// than holding a live process handle across the wasm boundary.
interface proc {
  // Spawn a long-lived child; returns a handle or an error. `capture-stderr` mirrors Pi's
  // debug-mode "inherit" vs "ignore" (server-manager.ts:111).
  spawn: func(cmd: string, args: list<string>, env-json: string, cwd: option<string>,
              capture-stderr: bool) -> result<u32, string>;   // u32 = proc-handle

  // Write to the child's stdin. Returns bytes written or an error (e.g. pipe closed).
  write-stdin: func(handle: u32, data: list<u8>) -> result<u32, string>;

  // Read the next chunk of stdout (non-blocking poll; empty list = no data yet, not EOF).
  // EOF is signalled by a subsequent `poll-exit` returning `some`.
  read-stdout: func(handle: u32, max-bytes: u32) -> result<list<u8>, string>;
  read-stderr: func(handle: u32, max-bytes: u32) -> result<list<u8>, string>;

  // Poll whether the child has exited; `some(code)` once terminated.
  poll-exit: func(handle: u32) -> option<s32>;

  // Terminate the child: close stdin (EOF), then SIGTERM, then SIGKILL, each escalation gated on
  // a grace period if the child is still alive (host-side policy; mirrors the real
  // StdioClientTransport.close()'s three-phase escalation).
  kill: func(handle: u32) -> result<_, string>;
}

// Outbound HTTP only (no raw TCP-connect; no ambient authority) — the L4 `http-client` capability
// (pi-mcp-adapter-port.md §3.2, the locked drafted shape). Gated by the SAME load-time trust check
// `exec`/`ui` use (`is_trusted = origin.is_pre_trust() || project_trusted`, loader.rs:57-60); an
// untrusted extension gets `DenyServices` and this interface is unreachable, exactly like `exec`.
// `request` is a bounded round trip. `request-stream`/`poll-stream-chunk`/`close-stream` back a
// long-lived streaming body (SSE / StreamableHTTP chunked responses): the HOST owns the live byte
// stream and the guest polls it (a guest cannot hold a live Rust stream across the wasm boundary —
// the request/poll bridge, arch-08 §5.2), keyed by an opaque `handle`.
interface http-client {
  record http-request {
    method: string,                       // "GET" | "POST" | ...
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
    timeout-ms: option<u32>,
  }
  record http-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }
  // The initiating response's metadata for a stream opened via `request-stream`, returned ALONGSIDE
  // the stream handle from the SAME round trip that opens the long-lived body (closes L4 §2.3: the
  // real consumer this capability backs — the MCP TS SDK's `StreamableHTTPClientTransport`/
  // `SSEClientTransport` — reads `response.status` (401 => re-auth) and `response.headers`
  // (`mcp-session-id`, `content-type`) off the SAME response whose body it then streams; there is no
  // second request to recover this metadata from, and a POST with side effects can't be re-issued to
  // do so). `body` is deliberately absent here — drain it via `poll-stream-chunk`.
  record http-stream-response {
    handle: u32,                          // stream-handle for poll-stream-chunk/close-stream
    status: u16,
    headers: list<tuple<string, string>>,
  }

  // A single request/response call. A non-2xx status is NOT itself a WIT error (fetch semantics) —
  // only a transport failure (DNS, connect refused, TLS, timeout) is; the guest inspects `status`.
  request: func(req: http-request) -> result<http-response, string>;

  // Streaming variant for SSE / StreamableHTTP's chunked responses. Returns the initiating response's
  // status+headers TOGETHER with a stream handle in one round trip; the guest polls for the next body
  // chunk via `poll-stream-chunk` (request/poll bridge, arch-08 §5.2) rather than the host blocking
  // the guest's Store on an unbounded-duration long poll.
  request-stream: func(req: http-request) -> result<http-stream-response, string>;
  poll-stream-chunk: func(handle: u32) -> result<option<list<u8>>, string>;  // none-of-none = EOF
  close-stream: func(handle: u32);
}

interface ext-fs {
  // capability-scoped; preopened dirs via WASI p2 (no ambient authority).
  read-file:  func(path: string) -> result<list<u8>, string>;
  write-file: func(path: string, data: list<u8>) -> result<_, string>;
}

interface bus {
  // inter-extension event bus (R-08-029; Pi `createEventBus()`, event-bus.ts:12-32). A guest
  // `emit`s a topic; the host fans it out to every guest that `subscribe`d that topic (its
  // `events.bus-deliver` export is invoked with the payload — the receive side that makes this a
  // real pub/sub, not an emit-into-a-void). `emit` enqueues; the host drains + delivers after the
  // emitting guest call unwinds (Pi's EventEmitter `emit` likewise returns without awaiting its
  // async listeners; wasm single-instance reentrancy forbids re-entering the emitter synchronously).
  emit:      func(topic: string, payload-json: string);
  // Declare that this guest listens on `topic` (Pi `pi.events.on(channel, handler)`, event-bus.ts:18).
  subscribe: func(topic: string);
}

// streaming tool output: the `onUpdate` callback of Pi's ToolDefinition.execute (types.ts:467).
interface host-tool {
  emit-update: func(call-id: string, chunk-json: string);
  // the tool's AbortSignal (Pi `ToolDefinition.execute` `signal` param, types.ts:466): the guest
  // polls this during a long `execute` to cooperatively stop. True once the host cancels the call
  // (epoch/`CancelToken`) or a named signal for this `call-id` was aborted (`ui.abort-signal`).
  is-cancelled: func(call-id: string) -> bool;
}

// OAuth login callbacks (Pi `OAuthLoginCallbacks`, pi-ai oauth/types.ts): the host-side handlers a
// guest's `login(callbacks)` flow drives during `provider-login`. The host renders the auth URL /
// device code / prompts and returns the user's answers (the interactive half of `/login`).
interface oauth {
  on-auth:        func(url: string, instructions: option<string>);
  on-device-code: func(user-code: string, verification-uri: string, interval-seconds: option<u32>, expires-in-seconds: option<u32>);
  // prompt for a value (e.g. "Paste the callback URL"); err = cancelled.
  on-prompt:      func(message: string, placeholder: option<string>, allow-empty: bool) -> result<string, string>;
  on-progress:    func(message: string);
  // interactive selector over a json array of {id,label}; returns the chosen id (none = cancel).
  on-select:      func(message: string, options-json: string) -> option<string>;
}

// streamSimple output (Pi `createAssistantMessageEventStream`, types.ts:1373): the guest's custom
// stream pushes assistant-message stream events keyed by `stream-id`; the host forwards them to the
// provider pipeline (the streaming analog of `host-tool.emit-update`).
interface provider-stream {
  emit-event: func(stream-id: string, event-json: string);
}

// Active-tool / command introspection (Pi getActiveTools/getAllTools/setActiveTools/getCommands,
// types.ts:1257-1266): the plan-mode active-tool restriction surface. `set-active-tools` is the only
// mutating one; the host enforces the merge (arch-08 §3.5).
interface ext-tools {
  get-active-tools: func() -> string;   // json array of active tool names
  get-all-tools:    func() -> string;   // json array of ToolInfo {name, source, parameters, …}
  set-active-tools: func(names-json: string);
  get-commands:     func() -> string;   // json array of SlashCommandInfo {name, description}
}

// Read-only ctx state (Pi `ExtensionContext`, extensions/types.ts:305-347). Pi puts `mode`, `hasUI`,
// `isIdle`, `hasPendingMessages`, `isProjectTrusted` and `getSystemPrompt` on the BASE context —
// available to EVERY handler, not just command handlers — so these are deliberately NOT tier-gated.
// The native built-in path reads the same six values off `HostCtx` / `HostCtx::rich()`.
interface ctx-state {
  use types.{ext-mode};

  // Pi `ctx.mode` (types.ts:311): the run mode — a guest guards terminal-only UI (custom
  // components) on `tui`. A FIELD in Pi; a getter here because WIT imports are functions.
  get-mode:             func() -> ext-mode;
  // Pi `ctx.hasUI` (types.ts:313): "Whether dialog-capable UI is available (true in TUI and RPC
  // modes)" — the guard a guest checks before `ui.confirm`/`input`/`select`.
  has-ui:               func() -> bool;
  // Pi `ctx.isIdle()` (types.ts:333): false while an agent run is in flight.
  is-idle:              func() -> bool;
  // Pi `ctx.hasPendingMessages()` (types.ts:341): queued user messages awaiting the next turn.
  has-pending-messages: func() -> bool;
  // Pi `ctx.isProjectTrusted()` (types.ts:335).
  is-project-trusted:   func() -> bool;
  // Pi `ctx.getSystemPrompt()` (types.ts:346); empty string when no session backend is attached.
  get-system-prompt:    func() -> string;
}

// COMMAND-ONLY (arch-08 §6.3, deadlock rule): session/runtime mutation. Calling any of
// these from an event handler returns a host-side deadlock error (surfaced, never a hang).
// EXCEPT `abort`/`shutdown` — see their comments: Pi puts both on the BASE `ExtensionContext`
// (types.ts:339-340,344), callable from any handler, so cyrup does NOT tier-gate them.
interface control {
  // opts-json carries the typed Pi option bags (newSession{parentSession,withSession},
  // fork{position,withSession}, switchSession{withSession}, navigateTree{summarize,…}, types.ts:346-368).
  new-session:   func(opts-json: string) -> result<_, string>;
  switch:        func(session-id: string, opts-json: string) -> result<_, string>;
  fork:          func(entry-id: string, opts-json: string) -> result<_, string>;
  navigate:      func(entry-id: string, opts-json: string) -> result<_, string>;
  reload:        func() -> result<_, string>;
  // compact (Pi `ctx.compact(options?)`, types.ts:344): opts-json carries `CompactOptions`
  // (types.ts:296-300) — `{customInstructions}`. Pi's `onComplete`/`onError` callbacks cannot cross
  // the component boundary as function values; a guest observes completion by subscribing to the
  // `session_compact` event (Pi's own `SessionCompactEvent` carries the produced entry).
  compact:       func(opts-json: string) -> result<_, string>;
  wait-idle:     func() -> result<_, string>;
  // send-message (types.ts:1223): opts-json carries {triggerTurn, deliverAs}.
  send-message:      func(message-json: string, opts-json: string) -> result<_, string>;
  send-user-message: func(content: string, opts-json: string) -> result<_, string>;

  // Pi `ctx.abort()` (extensions/types.ts:339, "Abort the current agent run. Available in all
  // contexts."): cancels the in-flight run. NOT tier-gated — an event handler (e.g. a
  // `tool_call` gate that decides the whole run must stop) is exactly Pi's use case, and abort
  // cannot deadlock the way a session REPLACEMENT op can.
  abort:    func() -> result<_, string>;
  // Pi `ctx.shutdown()` (extensions/types.ts:344, "Gracefully shutdown pi and exit. Available in
  // all contexts."). Sets the host's shutdown-requested flag; the host acts on it at the next
  // settle point (Pi rpc-mode.ts:355-358). Also NOT tier-gated.
  shutdown: func() -> result<_, string>;
}

world extension {
  import registration;
  import ui;
  import session;
  import models;
  import exec;
  import proc;
  import http-client;
  import ext-fs;
  import bus;
  import host-tool;
  import oauth;
  import provider-stream;
  import ext-tools;
  import control;
  import ctx-state;

  export events;
  // async init unit, awaited before the loader continues (R-08-001).
  export init: func() -> result<_, string>;
}
